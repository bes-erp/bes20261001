<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Form_TabWork" width="1080" height="670" titletext="업무 화면 컨테이너" cssclass="besTabWorkForm" scrollbartype="none" onload="Form_TabWork_onload">
    <Layouts>
      <Layout width="1080" height="670" screenid="Desktop_screen">
        <Div id="div_home" taborder="0" left="0" top="0" right="0" bottom="0" url="besframebase::Form_Work.xfdl" scrollbartype="none"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[/***************************************************************************************
 * 프로젝트        : Built1 Enterprise System 구축 프로젝트
 * 업무구분        : 공통 프레임
 * 파일명          : Form_TabWork.xfdl
 * 작성자          : Built1
 * 작성일          : 2026-11-05
 *
 * 화면            : 업무 화면 컨테이너
 * 설명            : 업무 화면별 Div 생성 및 탭 전환 시 화면 상태 유지
 *---------------------------------------------------------------------------------------
 * 변경일            변경자            변경내역
 *---------------------------------------------------------------------------------------
 * 2026-11-05        Built1            최초작성
 * 2026-11-05        Built1            홈 화면 표시 및 업무 탭 연동
 ***************************************************************************************/


/***************************************************************************************
 * 1. FORM 변수 선언
 ***************************************************************************************/

// 현재 활성화된 업무 메뉴 코드
this.fv_activeMenuCd = "";

// 열려 있는 업무 화면의 메뉴 코드, 메뉴명, URL 및 Div ID 관리
this.fv_openPages = {};


/***************************************************************************************
 * 2. FORM LOAD
 ***************************************************************************************/

/*
 * 기능 : 업무 화면 컨테이너 초기화
 */
this.fn_init = function(obj, e)
{
    // 활성 메뉴 및 열린 업무 화면 정보 초기화
    this.fv_activeMenuCd = "";
    this.fv_openPages    = {};
};


/***************************************************************************************
 * 3. 공통 버튼
 ***************************************************************************************/


/***************************************************************************************
 * 4. TRANSACTION, CALLBACK
 ***************************************************************************************/


/***************************************************************************************
 * 5. 팝업 호출 및 콜백
 ***************************************************************************************/


/***************************************************************************************
 * 6. 기타 함수
 ***************************************************************************************/

/*
 * 기능 : 업무 화면 생성 및 활성화
 */
this.fn_openPage = function(sMenuCd, sMenuNm, sFormUrl)
{
    // 메뉴 코드 또는 화면 URL이 없으면 종료
    if (!sMenuCd || !sFormUrl) return;

    // 이미 생성된 업무 화면이면 새로 만들지 않고 기존 화면 활성화
    if (this.fv_openPages[sMenuCd])
    {
        this.fn_selectPage(sMenuCd);
        return;
    }

    // 메뉴 코드의 특수문자를 치환하여 Div ID 생성
    var sDivId = "div_page_" + sMenuCd.replace(/[^a-zA-Z0-9_]/g, "_");

    // 업무 화면을 표시할 Div 동적 생성
    // left, top은 0으로 설정하고 right, bottom은 0으로 설정하여 부모 크기에 맞춤
    var objDiv = new nexacro.Div(sDivId, 0, 0, null, null, 0, 0, null, null, null, null, this);

    // 생성한 Div를 현재 Form의 자식 컴포넌트로 등록
    this.addChild(sDivId, objDiv);

    // 최초 생성 시 화면을 숨기고 업무 화면 URL 설정
    objDiv.set_visible(false);
    objDiv.set_url(sFormUrl);
    objDiv.show();

    // 메뉴 코드를 기준으로 생성한 업무 화면 정보 저장
    this.fv_openPages[sMenuCd] = { divId: sDivId, menuNm: sMenuNm, formUrl: sFormUrl };

    // 신규 생성한 업무 화면 활성화
    this.fn_selectPage(sMenuCd);
};


/*
 * 기능 : 선택한 업무 화면 표시
 */
this.fn_selectPage = function(sMenuCd)
{
    var objPage;

    // 기존에 열려 있는 모든 업무 화면을 숨김
    // Div를 삭제하지 않으므로 화면 데이터와 입력 상태는 유지
    for (var sCd in this.fv_openPages)
    {
        if (!this.fv_openPages.hasOwnProperty(sCd)) continue;

        objPage = this.components[this.fv_openPages[sCd].divId];

        if (objPage)
        {
            objPage.set_visible(false);
        }
    }

    // 메뉴 코드가 없으면 홈 화면 선택
    if (!sMenuCd)
    {
        // Form_Work.xfdl이 연결된 홈 Div 표시
        this.div_home.set_visible(true);

        // 현재 활성화된 업무 메뉴 코드 초기화
        this.fv_activeMenuCd = "";
        return;
    }

    // 생성되지 않은 업무 화면이면 종료
    if (!this.fv_openPages[sMenuCd]) return;

    // 업무 화면 선택 시 홈 화면 숨김
    this.div_home.set_visible(false);

    // 선택한 메뉴 코드에 해당하는 업무 화면 Div 조회
    objPage = this.components[this.fv_openPages[sMenuCd].divId];

    if (objPage)
    {
        // 선택한 업무 화면 표시 및 활성 메뉴 코드 저장
        objPage.set_visible(true);
        this.fv_activeMenuCd = sMenuCd;
    }
};


/*
 * 기능 : 업무 화면 닫기
 */
this.fn_closePage = function(sMenuCd)
{
    // 닫을 업무 화면 정보 조회
    var objPageInfo = this.fv_openPages[sMenuCd];

    if (!objPageInfo) return;

    // 메뉴 코드에 해당하는 업무 화면 Div 조회
    var objDiv = this.components[objPageInfo.divId];

    if (objDiv)
    {
        // 현재 Form에서 Div 제거 후 객체 삭제
        this.removeChild(objPageInfo.divId);
        objDiv.destroy();
    }

    // 열린 업무 화면 관리 목록에서 해당 메뉴 삭제
    delete this.fv_openPages[sMenuCd];

    // 현재 활성화된 업무 화면을 닫으면 홈 화면 표시
    // 다른 탭 선택 처리는 Form_Mdi에서 수행
    if (this.fv_activeMenuCd == sMenuCd)
    {
        this.fn_selectPage("");
    }
};


/***************************************************************************************
 * 7. 이벤트
 ***************************************************************************************/

/*
 * 기능 : 업무 화면 컨테이너 로딩 이벤트
 */
this.Form_TabWork_onload = function(obj, e)
{
    // 화면 로딩 시 업무 화면 관리 변수 초기화
    this.fn_init(obj, e);
};
]]></Script>
  </Form>
</FDL>
