<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Form_Top" width="1080" height="50" titletext="공통 상단 영역" cssclass="besTopForm" scrollbartype="none" onload="Form_Top_onload">
    <Layouts>
      <Layout width="1080" height="50" screenid="Desktop_screen">
        <!-- ===== 왼쪽 영역 ===== -->
        <!-- 로고 및 시스템명 : 글자 폭에 맞춤 + 간격 12 -->
        <ImageViewer id="img_Brand" taborder="0" left="20" top="13" width="24" height="24" image="url('theme://bes_icon/bes_logo.png')" stretch="fit" cssclass="besTopLogo"/>
        <Static id="sta_Brand" taborder="1" text="BES" left="img_Brand:12" top="0" width="52" height="49" padding="0px" fittocontents="width" wordWrap="none" cssclass="besTopBrand" cursor="pointer" onclick="sta_Brand_onclick"/>
        <Static id="sta_SystemName" taborder="2" text="Built1 Enterprise System" left="sta_Brand:12" top="0" width="138" height="49" padding="0px" fittocontents="width" wordWrap="none" cssclass="besTopSystemName"/>
        <!-- 언어 선택 -->
        <Button id="btn_language" taborder="7" text="한국어/KR" left="sta_SystemName:12" top="10" width="140" height="30" cssclass="btn_TF_lang" icon="theme://images_ifc/img_TF_kr.png" cursor="pointer" onclick="btn_language_onclick"/>
        <!-- 언어 선택 팝업 -->
        <PopupDiv id="pdv_language" taborder="16" visible="false" left="sta_SystemName:12" top="40" width="140" height="87">
          <Layouts>
            <Layout width="140" height="87">
              <Grid id="grd_language" taborder="0" left="0" top="0" right="0" bottom="0" binddataset="ds_language" autoenter="select" autofittype="col" scrolltype="none" oncellclick="pdv_language_grd_language_oncellclick">
                <Formats>
                  <Format id="default">
                    <Columns>
                      <Column size="36"/>
                      <Column size="104"/>
                    </Columns>
                    <Rows>
                      <Row size="29"/>
                    </Rows>
                    <Band id="body">
                      <Cell text="bind:flag" displaytype="imagecontrol"/>
                      <Cell col="1" text="bind:name"/>
                    </Band>
                  </Format>
                </Formats>
              </Grid>
            </Layout>
          </Layouts>
        </PopupDiv>
        <!-- ===== 오른쪽 영역 (기준 컴포넌트부터 먼저 선언) ===== -->
        <Button id="btn_logout" taborder="6" text="로그아웃" right="20" top="0" width="60" height="49" padding="0px" fittocontents="width" wordWrap="none" cssclass="besTopActionButton" cursor="pointer" onclick="btn_logout_onclick"/>
        <Static id="sta_Separator" taborder="5" text="|" right="btn_logout:12" top="0" width="8" height="49" padding="0px" fittocontents="width" textAlign="center" cssclass="besTopSeparator"/>
        <Button id="btn_changePw" taborder="4" text="패스워드 변경" right="sta_Separator:12" top="0" width="92" height="49" padding="0px" fittocontents="width" wordWrap="none" cssclass="besTopActionButton" cursor="pointer" onclick="btn_changePw_onclick"/>
        <Static id="sta_UserName" taborder="3" text="" right="btn_changePw:12" top="0" width="175" height="49" textAlign="right" wordWrap="none" cssclass="besTopUserName"/>
        <!-- ===== 가이드 (컴포넌트를 따라다니도록 상대 좌표) ===== -->
        <Static id="sta_guideLeft" taborder="8" text="20" left="0" top="0" width="20" height="50" visible="false" background="aqua" opacity="0.5" textAlign="center"/>
        <Static id="sta_guideRight" taborder="9" text="20" right="0" top="0" width="20" height="50" visible="false" background="aqua" opacity="0.5" textAlign="center"/>
        <Static id="sta_guideLogoGap" taborder="10" text="12" left="img_Brand:0" top="0" width="12" height="50" visible="false" background="aqua" opacity="0.5" textAlign="center"/>
        <Static id="sta_guideBrandGap" taborder="11" text="12" left="sta_Brand:0" top="0" width="12" height="50" visible="false" background="aqua" opacity="0.5" textAlign="center"/>
        <Static id="sta_guideLanguageGap" taborder="12" text="12" left="sta_SystemName:0" top="0" width="12" height="50" visible="false" background="aqua" opacity="0.5" textAlign="center"/>
        <Static id="sta_guideUserGap" taborder="13" text="12" right="btn_changePw:0" top="0" width="12" height="50" visible="false" background="aqua" opacity="0.5" textAlign="center"/>
        <Static id="sta_guideSeparatorLeftGap" taborder="14" text="12" right="sta_Separator:0" top="0" width="12" height="50" visible="false" background="aqua" opacity="0.5" textAlign="center"/>
        <Static id="sta_guideSeparatorRightGap" taborder="15" text="12" right="btn_logout:0" top="0" width="12" height="50" visible="false" background="aqua" opacity="0.5" textAlign="center"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[/***************************************************************************************
 * 프로젝트        : Built1 Enterprise System 구축 프로젝트
 * 업무구분        : 공통 프레임
 * 파일명          : Form_Top.xfdl
 * 작성자          : Built1
 * 작성일          : 2026-11-03
 *
 * 화면            : 공통 상단 영역
 * 설명            : BES 로고, 로그인 사용자 정보 및 로그아웃 관리
 *---------------------------------------------------------------------------------------
 * 변경일            변경자            변경내역
 *---------------------------------------------------------------------------------------
 * 2026-11-03        Built1            공통 상단 화면 구성
 * 2026-11-09        Built1            IFC 프레임 구조에 맞춰 홈 이동 경로 변경
 * 2026-11-09        Built1            로그아웃 시 전체 업무 탭 초기화 연동
 ***************************************************************************************/


/***************************************************************************************
 * 1. FORM 변수 선언
 ***************************************************************************************/


/***************************************************************************************
 * 2. FORM LOAD
 ***************************************************************************************/

/*
 * 기능 : 상단 영역 초기화
 * 설명 : 로그인 사용자 정보 및 선택 언어 표시
 */
this.fn_init = function(obj, e)
{
    var objApp = nexacro.getApplication();

    if (objApp.gv_userid)
    {
        this.fn_setUserInfo(objApp.gv_userid);
    }

    // 로그인에서 선택한 언어를 우선 적용
    var sLanguage = objApp.gv_lang || this.gfn_getLanguage();
    this.fn_setLanguageInfo(sLanguage);
};

/***************************************************************************************
 * 3. 공통 버튼
 ***************************************************************************************/

/*
 * 기능 : 로그아웃
 * 설명 : 업무 탭과 ChildFrame을 제거한 후 로그인 화면으로 이동
 */
this.fn_logout = function()
{
    var objApp = nexacro.getApplication();

    // objFrameSet : 로그인 및 업무 영역을 구분하는 최상위 프레임
    var objFrameSet = objApp.mainframe.VFrameSetMain;

    if (!objFrameSet)
    {
        this.alert("메인 프레임을 찾을 수 없습니다.");
        return;
    }

    // objMdiFrame : IFC형 업무 탭 관리 프레임
    var objMdiFrame = objFrameSet.VFrameSetWork.HFrameSetWork.VFrameSetContent.MdiFrame;

    // 업무 탭 관리 함수 존재 여부 확인
    if (!objMdiFrame || !objMdiFrame.form || !objMdiFrame.form.fn_closeAllTabs)
    {
        this.alert("업무 탭 초기화 함수를 찾을 수 없습니다.");
        return;
    }

    // 로그아웃 전 열린 업무 ChildFrame 및 탭 전체 제거
    if (!objMdiFrame.form.fn_closeAllTabs())
    {
        this.alert("업무 화면 초기화에 실패했습니다.");
        return;
    }

    // 로그인 화면 입력값 및 메시지 초기화
    var objLoginFrame = objFrameSet.LoginFrame;

    if (objLoginFrame && objLoginFrame.form && objLoginFrame.form.fn_resetLogin)
    {
        objLoginFrame.form.fn_resetLogin();
    }

    // 로그인 사용자 ID 초기화
    objApp.gv_userid = "";

    // 상단 사용자 표시 정보 초기화
    this.fn_setUserInfo("");

    // 로그인 프레임 표시 및 업무 영역 숨김
    objFrameSet.set_separatesize("*,0");

    // 로그아웃 완료 안내
    this.alert("로그아웃되었습니다.");
};


/***************************************************************************************
 * 4. TRANSACTION, CALLBACK
 ***************************************************************************************/


/***************************************************************************************
 * 5. 팝업 호출 및 콜백
 ***************************************************************************************/


/***************************************************************************************
 * 6. 기타 함수
 ***************************************************************************************/

/*
 * 기능 : 로그인 사용자 정보 표시
 * 설명 : 로그인 사용자 ID를 상단 환영 문구에 반영
 */
this.fn_setUserInfo = function(sUserName)
{
    // 기존 상단 사용자 표시 컴포넌트
    if (!this.sta_UserName) return;

    // 사용자 정보가 없으면 안내 문구 초기화
    if (!sUserName)
    {
        this.sta_UserName.set_text("");
        return;
    }

    // 로그인 사용자 환영 문구 표시
    this.sta_UserName.set_text(sUserName + "님 환영합니다.");
};

/*
 * 기능 : 선택 언어 표시
 * 설명 : 언어 코드에 따라 국기 이미지와 언어명을 설정
 */
this.fn_setLanguageInfo = function(sLanguage)
{
    // 언어 Dataset에서 해당 언어 조회
    var nRow = this.ds_language.findRow("code", sLanguage);

    // 지원하지 않는 언어이면 한국어 적용
    if (nRow < 0)
    {
        nRow = this.ds_language.findRow("code", "KO");
    }

    if (nRow < 0) return;

    // 선택 언어명 및 국기 이미지 조회
    var sLanguageName = this.ds_language.getColumn(nRow, "name");
    var sFlagImage = this.ds_language.getColumn(nRow, "flag");

    // 상단 언어 버튼에 적용
    this.btn_language.set_text(sLanguageName);
    this.btn_language.set_icon(sFlagImage);
};

/***************************************************************************************
 * 7. 이벤트
 ***************************************************************************************/

/*
 * 기능 : 상단 영역 로딩 이벤트
 */
this.Form_Top_onload = function(obj, e)
{
    this.fn_init(obj, e);
};


/*
 * 기능 : BES 로고 클릭
 * 설명 : 업무 탭은 유지하고 기존 Form_Work 홈 화면 표시
 */
this.sta_Brand_onclick = function(obj, e)
{
    var objApp = nexacro.getApplication();

    // IFC형 MDI 프레임 접근
    var objMdiFrame = objApp.mainframe.VFrameSetMain.VFrameSetWork.HFrameSetWork.VFrameSetContent.MdiFrame;

    if (!objMdiFrame || !objMdiFrame.form || !objMdiFrame.form.fn_selectTab)
    {
        this.alert("MdiFrame을 찾을 수 없습니다.");
        return;
    }

    // 기본 홈 화면 선택
    objMdiFrame.form.fn_selectTab("");
};


/*
 * 기능 : 로그아웃 버튼 클릭
 * 설명 : 공통 로그아웃 함수 호출
 */
this.btn_logout_onclick = function(obj, e)
{
    this.fn_logout();
};

/*
 * 기능 : 언어 선택 팝업 표시
 * 설명 : 언어 버튼 바로 아래에 언어 목록 표시
 */
this.btn_language_onclick = function(obj, e)
{
    var sLanguage = this.gfn_getLanguage();

    var nRow = this.ds_language.findRow("code", sLanguage);

    if (nRow >= 0)
    {
        this.ds_language.set_rowposition(nRow);
    }

    // 버튼의 실제 좌표
    var nLeft = obj.getOffsetLeft();
    var nTop = obj.getOffsetTop() + obj.getOffsetHeight();

    // 버튼 아래에 팝업 표시
    this.pdv_language.trackPopup(nLeft, nTop);
};

/*
 * 기능 : 언어 변경
 * 설명 : 선택 언어 저장 및 상단 표시 변경
 */
this.pdv_language_grd_language_oncellclick = function(obj, e)
{
    if (e.row < 0) return;

    var sLanguage = this.ds_language.getColumn(e.row, "code");

    if (!sLanguage) return;

    // 전역 언어 및 PrivateProfile 저장
    sLanguage = this.gfn_setLanguage(sLanguage);

    // 국기와 언어명 변경
    this.fn_setLanguageInfo(sLanguage);

    // 팝업 닫기
    this.pdv_language.closePopup();
};]]></Script>
    <Objects>
      <Dataset id="ds_language">
        <ColumnInfo>
          <Column id="code" type="STRING" size="256"/>
          <Column id="flag" type="STRING" size="256"/>
          <Column id="name" type="STRING" size="256"/>
        </ColumnInfo>
        <Rows>
          <Row>
            <Col id="code">KO</Col>
            <Col id="flag">theme://images_ifc/img_TF_kr.png</Col>
            <Col id="name">한국어/KR</Col>
          </Row>
          <Row>
            <Col id="code">EN</Col>
            <Col id="flag">theme://images_ifc/img_TF_en.png</Col>
            <Col id="name">영어/EN</Col>
          </Row>
          <Row>
            <Col id="code">ZH</Col>
            <Col id="flag">theme://images_ifc/img_TF_cn.png</Col>
            <Col id="name">중국어/CN</Col>
          </Row>
        </Rows>
      </Dataset>
    </Objects>
  </Form>
</FDL>
