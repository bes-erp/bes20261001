<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Form_Mdi" width="1080" height="30" titletext="업무 탭 영역" cssclass="besMdiForm" scrollbartype="none" onload="Form_Mdi_onload">
    <Layouts>
      <Layout width="1080" height="30" screenid="Desktop_screen">
        <Button id="btn_home" taborder="0" text="⌂" left="0" top="0" width="42" height="30" cssclass="besMdiHome" cursor="pointer" onclick="btn_home_onclick"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[/***************************************************************************************
 * 프로젝트        : Built1 Enterprise System 구축 프로젝트
 * 업무구분        : 공통 프레임
 * 파일명          : Form_Mdi.xfdl
 * 작성자          : Built1
 * 작성일          : 2026-11-05
 *
 * 화면            : 업무 탭 영역
 * 설명            : FrameSet 기반 업무 탭 생성, 선택, 닫기 및 전체 초기화
 *---------------------------------------------------------------------------------------
 * 변경일            변경자            변경내역
 *---------------------------------------------------------------------------------------
 * 2026-11-05        Built1            최초작성 및 동적 탭 기능 추가
 * 2026-11-05        Built1            홈 화면 이동 및 상단·왼쪽 메뉴 연동
 * 2026-11-06        Built1            전역 Dataset 및 프레임 ID 변경
 * 2026-11-09        Built1            FrameSet 기반 업무 ChildFrame 관리
 * 2026-11-09        Built1            로그아웃 시 전체 업무 탭 초기화 기능 추가
 ***************************************************************************************/


/***************************************************************************************
 * 1. FORM 변수 선언
 ***************************************************************************************/

// fv_tabList : 현재 열려 있는 업무 탭 관리 배열
// menuCd, menuNm, formUrl, frameId 저장
this.fv_tabList = [];

// fv_activeMenuCd : 현재 선택한 업무 메뉴 코드
// 빈 문자열이면 기본 홈 화면
this.fv_activeMenuCd = "";


/***************************************************************************************
 * 2. FORM LOAD
 ***************************************************************************************/

/*
 * 기능 : 업무 탭 초기화
 * 설명 : 최초 로딩 시 탭 목록 및 선택 메뉴 초기화
 */
this.fn_init = function(obj, e)
{
    this.fv_tabList = [];
    this.fv_activeMenuCd = "";
};


/***************************************************************************************
 * 3. 공통 버튼
 ***************************************************************************************/


/***************************************************************************************
 * 4. TRANSACTION, CALLBACK
 ***************************************************************************************/


/***************************************************************************************
 * 5. 팝업 호출 및 콜백
 ***************************************************************************************/


/***************************************************************************************
 * 6. 기타 함수
 ***************************************************************************************/

/*
 * 기능 : 업무 컨텐츠 영역 조회
 * 설명 : MDI, 홈 화면, 업무 FrameSet을 포함하는 VFrameSet 반환
 */
this.fn_getContentFrameSet = function()
{
    var objApp = nexacro.getApplication();

    return objApp.mainframe.VFrameSetMain.VFrameSetWork.HFrameSetWork.VFrameSetContent;
};


/*
 * 기능 : 업무 FrameSet 조회
 * 설명 : 동적으로 생성한 업무 ChildFrame의 부모 객체 반환
 */
this.fn_getWorkFrameSet = function()
{
    var objContent = this.fn_getContentFrameSet();

    if (!objContent) return null;

    return objContent.FrameSetWork;
};


/*
 * 기능 : 업무 탭 정보 조회
 * 설명 : 메뉴 코드에 해당하는 탭 정보 반환
 */
this.fn_getTabInfo = function(sMenuCd)
{
    for (var i = 0; i < this.fv_tabList.length; i++)
    {
        if (this.fv_tabList[i].menuCd == sMenuCd)
        {
            return this.fv_tabList[i];
        }
    }

    return null;
};


/*
 * 기능 : 업무 탭 생성 및 화면 열기
 * 설명 : 동일한 메뉴가 열려 있으면 기존 화면 선택
 *        신규 메뉴이면 ChildFrame을 생성하여 FrameSet에 등록
 */
this.fn_openTab = function(sMenuCd, sMenuNm, sFormUrl)
{
    // 필수 메뉴정보 확인
    if (!sMenuCd || !sFormUrl) return;

    // 이미 열린 업무 탭이면 기존 화면 활성화
    var objInfo = this.fn_getTabInfo(sMenuCd);

    if (objInfo)
    {
        this.fn_selectTab(sMenuCd);
        return;
    }

    // 업무 FrameSet 조회
    var objFrameSet = this.fn_getWorkFrameSet();

    if (!objFrameSet)
    {
        this.alert("업무 FrameSet을 찾을 수 없습니다.");
        return;
    }

    // 메뉴 코드로 ChildFrame ID 생성
    var sFrameId = "Work_" + String(sMenuCd).replace(/[^a-zA-Z0-9_]/g, "_");

    // 프레임 ID 중복 확인
    if (objFrameSet[sFrameId])
    {
        this.alert("업무 프레임 ID가 중복됩니다.");
        return;
    }

    // 신규 업무 ChildFrame 생성
    var objChildFrame = new nexacro.ChildFrame();

    objChildFrame.init(sFrameId, 0, 0, null, null, 0, 0);

    // FrameSet에 신규 프레임 등록
    objFrameSet.addChild(sFrameId, objChildFrame);

    // 프레임 기본 속성 설정
    objChildFrame.set_titletext(sMenuNm);
    objChildFrame.set_showtitlebar(false);
    objChildFrame.set_showstatusbar(false);
    objChildFrame.set_formurl(sFormUrl);

    // 신규 업무 화면 표시
    objChildFrame.show();

    // 열린 업무 탭 목록에 추가
    this.fv_tabList.push({
        menuCd  : sMenuCd,
        menuNm  : sMenuNm,
        formUrl : sFormUrl,
        frameId : sFrameId
    });

    // 신규 업무 탭 선택
    this.fn_selectTab(sMenuCd);
};


/*
 * 기능 : 업무 탭 선택
 * 설명 : 홈 화면과 업무 FrameSet 표시 상태 전환
 *        선택한 업무 프레임에 포커스 설정
 */
this.fn_selectTab = function(sMenuCd)
{
    var objContent  = this.fn_getContentFrameSet();
    var objFrameSet = this.fn_getWorkFrameSet();

    if (!objContent || !objFrameSet) return;

    // 홈 화면 선택
    if (!sMenuCd)
    {
        // MDI 30px, 홈 화면 표시, 업무 FrameSet 숨김
        objContent.set_separatesize("30,*,0");

        this.fv_activeMenuCd = "";

        this.fn_createTabs();
        return;
    }

    // 선택한 업무 탭 확인
    var objInfo = this.fn_getTabInfo(sMenuCd);

    if (!objInfo) return;

    var objChildFrame = objFrameSet[objInfo.frameId];

    if (!objChildFrame) return;

    // MDI 30px, 홈 화면 숨김, 업무 FrameSet 표시
    objContent.set_separatesize("30,0,*");

    // 선택한 업무 프레임 활성화
    objChildFrame.setFocus();

    // 현재 활성 메뉴 코드 저장
    this.fv_activeMenuCd = sMenuCd;

    // 선택한 업무의 상단 및 왼쪽 메뉴 복원
    this.fn_syncTopMenu(sMenuCd);

    // 업무 탭 버튼 갱신
    this.fn_createTabs();
};


/*
 * 기능 : 상단 및 왼쪽 메뉴 복원
 * 설명 : 3레벨 업무 메뉴의 상위 1레벨 메뉴를 찾아 선택
 */
this.fn_syncTopMenu = function(sMenuCd)
{
    var objApp = nexacro.getApplication();
    var dsMenu = objApp.gds_menu;

    if (!dsMenu) return;

    var sParentCd  = "";
    var sTopMenuCd = "";

    // 업무 메뉴의 부모 코드 검색
    for (var i = 0; i < dsMenu.rowcount; i++)
    {
        if (dsMenu.getColumn(i, "CHILD_MENU_CD") == sMenuCd)
        {
            sParentCd = dsMenu.getColumn(i, "PARENT_MENU_CD");
            break;
        }
    }

    // 부모 메뉴가 속한 최상위 메뉴 코드 검색
    for (var j = 0; j < dsMenu.rowcount; j++)
    {
        if (dsMenu.getColumn(j, "CHILD_MENU_CD") == sParentCd)
        {
            sTopMenuCd = dsMenu.getColumn(j, "PARENT_MENU_CD");
            break;
        }
    }

    if (!sTopMenuCd) return;

    // 상단 메뉴 프레임 조회
    var objMenuFrame = objApp.mainframe.VFrameSetMain.VFrameSetWork.MenuFrame;

    if (!objMenuFrame || !objMenuFrame.form || !objMenuFrame.form.fn_selectTopMenu) return;

    // 상단 메뉴 선택 시 왼쪽 메뉴도 함께 갱신
    objMenuFrame.form.fn_selectTopMenu(sTopMenuCd);
};


/*
 * 기능 : 업무 탭 버튼 생성
 * 설명 : 열린 업무 탭 목록을 기준으로 선택 및 닫기 버튼 구성
 */
this.fn_createTabs = function()
{
    // 기존 동적 업무 탭 버튼 제거
    for (var i = this.components.length - 1; i >= 0; i--)
    {
        var objComp = this.components[i];

        if (objComp.name.indexOf("btn_tab_") == 0 ||
            objComp.name.indexOf("btn_close_") == 0)
        {
            this.removeChild(objComp.name);
            objComp.destroy();
        }
    }

    var nLeft     = 42;
    var nTabWidth = 155;

    // 열린 업무 탭 수만큼 버튼 생성
    for (var j = 0; j < this.fv_tabList.length; j++)
    {
        var objInfo = this.fv_tabList[j];

        // 업무 탭 선택 버튼
        var sTabId = "btn_tab_" + j;

        var objTab = new nexacro.Button(
            sTabId, nLeft, 0, nTabWidth, 30,
            null, null, null, null, null, null, this
        );

        this.addChild(sTabId, objTab);

        objTab.set_text(objInfo.menuNm);
        objTab.set_cssclass(
            objInfo.menuCd == this.fv_activeMenuCd
                ? "besMdiTabSelected"
                : "besMdiTab"
        );
        objTab.set_cursor("pointer");
        objTab.menuCd = objInfo.menuCd;

        objTab.addEventHandler("onclick", this.fn_tab_onclick, this);
        objTab.show();

        // 업무 탭 닫기 버튼
        var sCloseId = "btn_close_" + j;

        var objClose = new nexacro.Button(
            sCloseId, nLeft + nTabWidth - 28, 4, 22, 22,
            null, null, null, null, null, null, this
        );

        this.addChild(sCloseId, objClose);

        objClose.set_text("×");
        objClose.set_cssclass("besMdiTabClose");
        objClose.set_cursor("pointer");
        objClose.menuCd = objInfo.menuCd;

        objClose.addEventHandler("onclick", this.fn_close_onclick, this);
        objClose.show();

        // 다음 탭 위치
        nLeft += nTabWidth;
    }
};


/*
 * 기능 : 업무 탭 닫기
 * 설명 : 해당 ChildFrame 제거 후 다음 업무 탭 또는 홈 선택
 */
this.fn_closeTab = function(sMenuCd)
{
    var nCloseIndex = -1;

    // 닫을 탭 검색
    for (var i = 0; i < this.fv_tabList.length; i++)
    {
        if (this.fv_tabList[i].menuCd == sMenuCd)
        {
            nCloseIndex = i;
            break;
        }
    }

    if (nCloseIndex < 0) return;

    var bActive = (this.fv_activeMenuCd == sMenuCd);
    var objInfo = this.fv_tabList[nCloseIndex];

    var objFrameSet = this.fn_getWorkFrameSet();

    if (!objFrameSet) return;

    // 해당 업무 ChildFrame 제거
    var objChildFrame = objFrameSet[objInfo.frameId];

    if (objChildFrame)
    {
        objFrameSet.removeChild(objInfo.frameId);
        objChildFrame.destroy();
    }

    // 탭 목록에서 제거
    this.fv_tabList.splice(nCloseIndex, 1);

    if (bActive)
    {
        var sNextMenuCd = "";

        // 남은 업무 탭이 있으면 다음 탭 선택
        if (this.fv_tabList.length > 0)
        {
            var nNextIndex = Math.min(nCloseIndex, this.fv_tabList.length - 1);

            sNextMenuCd = this.fv_tabList[nNextIndex].menuCd;
        }

        this.fn_selectTab(sNextMenuCd);
    }
    else
    {
        this.fn_createTabs();
    }
};


/*
 * 기능 : 전체 업무 탭 초기화
 * 설명 : 로그아웃 시 생성된 업무 ChildFrame을 모두 제거
 *        탭 관리 배열과 선택 메뉴를 초기화하고 홈 화면 복원
 */
this.fn_closeAllTabs = function()
{
    // 업무 FrameSet 및 컨텐츠 영역 조회
    var objFrameSet = this.fn_getWorkFrameSet();
    var objContent  = this.fn_getContentFrameSet();

    // 업무 FrameSet을 찾지 못하면 초기화 실패
    if (!objFrameSet || !objContent) return false;

    // 모든 업무 ChildFrame을 역순으로 제거
    for (var i = this.fv_tabList.length - 1; i >= 0; i--)
    {
        // 현재 제거할 업무 탭 정보
        var objInfo = this.fv_tabList[i];

        // 해당 메뉴의 업무 ChildFrame 조회
        var objChildFrame = objFrameSet[objInfo.frameId];

        // 실제 업무 프레임 제거
        if (objChildFrame)
        {
            objFrameSet.removeChild(objInfo.frameId);
            objChildFrame.destroy();
        }
    }

    // 전체 업무 탭 목록 초기화
    this.fv_tabList = [];

    // 현재 선택된 업무 메뉴 초기화
    this.fv_activeMenuCd = "";

    // MDI 버튼 목록 초기화
    this.fn_createTabs();

    // 기존 Form_Work 홈 화면 표시
    objContent.set_separatesize("30,*,0");

    return true;
};


/***************************************************************************************
 * 7. 이벤트
 ***************************************************************************************/

/*
 * 기능 : 업무 탭 영역 로딩 이벤트
 */
this.Form_Mdi_onload = function(obj, e)
{
    this.fn_init(obj, e);
};


/*
 * 기능 : 홈 버튼 클릭
 */
this.btn_home_onclick = function(obj, e)
{
    this.fn_selectTab("");
};


/*
 * 기능 : 업무 탭 선택 버튼 클릭
 */
this.fn_tab_onclick = function(obj, e)
{
    this.fn_selectTab(obj.menuCd);
};


/*
 * 기능 : 업무 탭 닫기 버튼 클릭
 */
this.fn_close_onclick = function(obj, e)
{
    this.fn_closeTab(obj.menuCd);
};
]]></Script>
  </Form>
</FDL>
