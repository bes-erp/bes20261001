<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Form_Mdi" width="1080" height="30" titletext="업무 탭 영역" cssclass="besMdiForm" scrollbartype="none" onload="Form_Mdi_onload" onsize="Form_Mdi_onsize">
    <Layouts>
      <Layout width="1080" height="30" screenid="Desktop_screen">
        <Button id="btn_home" taborder="0" text="⌂" left="0" top="0" width="42" height="30" cssclass="besMdiHome" cursor="pointer" onclick="btn_home_onclick"/>
        <Button id="btn_tabNext" taborder="2" text="›" right="0" top="0" width="28" height="30" enable="false" cssclass="besMdiTabNav" onclick="btn_tabNext_onclick"/>
        <Button id="btn_tabPrev" taborder="1" text="‹" right="btn_tabNext:0" top="0" width="28" height="30" enable="false" cssclass="besMdiTabNav" onclick="btn_tabPrev_onclick"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[/***************************************************************************************
 * 프로젝트        : Built1 Enterprise System 구축 프로젝트
 * 업무구분        : 공통 프레임
 * 파일명          : Form_Mdi.xfdl
 * 작성자          : Built1
 * 작성일          : 2026-11-05
 *
 * 화면            : 업무 탭 영역
 * 설명            : FrameSet 기반 업무 탭 생성, 선택, 닫기 및 전체 초기화
 *---------------------------------------------------------------------------------------
 * 변경일            변경자            변경내역
 *---------------------------------------------------------------------------------------
 * 2026-11-05        Built1            최초작성 및 동적 탭 기능 추가
 * 2026-11-05        Built1            홈 화면 이동 및 상단·왼쪽 메뉴 연동
 * 2026-11-06        Built1            전역 Dataset 및 프레임 ID 변경
 * 2026-11-09        Built1            FrameSet 기반 업무 ChildFrame 관리
 * 2026-11-09        Built1            로그아웃 시 전체 업무 탭 초기화 기능 추가
 * 2026-11-13        Built1            업무 탭 최대 개수 제한 (프로파일 : MDI_TAB_MAX_CNT)
 * 2026-11-13        Built1            업무 탭이 MDI 넓이 초과 시 이동 버튼(‹ ›) 추가
 ***************************************************************************************/


/***************************************************************************************
 * 1. FORM 변수 선언
 ***************************************************************************************/

// fv_tabList : 현재 열려 있는 업무 탭 관리 배열
// menuCd, menuNm, formUrl, frameId 저장
this.fv_tabList = [];

// fv_activeMenuCd : 현재 선택한 업무 메뉴 코드
// 빈 문자열이면 기본 홈 화면
this.fv_activeMenuCd = "";

// fv_tabStartIndex : 업무 탭 표시 시작 위치 (이동 버튼으로 변경)
this.fv_tabStartIndex = 0;

// fv_tabLeft : 첫 번째 업무 탭 시작 위치 (홈 버튼 너비)
this.fv_tabLeft = 42;

// fv_tabWidth : 업무 탭 1개 너비
this.fv_tabWidth = 155;

// fv_tabTop : 업무 탭 상단 여백 (크롬 카드형 : 탭 위로 MDI 배경이 보이도록)
this.fv_tabTop = 4;

// fv_tabHeight : 업무 탭 높이 (MDI 높이 30 - 상단 여백 4)
this.fv_tabHeight = 26;

// fv_tabNavWidth : 이동 버튼 영역 너비 (btn_tabPrev 28 + btn_tabNext 28)
this.fv_tabNavWidth = 56;

// fv_tabMaxProfileCd : 업무 탭 최대 개수 프로파일 코드 (sys_profile)
this.fv_tabMaxProfileCd = "MDI_TAB_MAX_CNT";

// fv_tabMaxDefault : 업무 탭 최대 개수 예비값 (기본은 DB sys_profile 의 MDI_TAB_MAX_CNT 사용)
//                    gds_profile 미조회, 프로파일 미등록, 값 오류일 때만 사용
this.fv_tabMaxDefault = 7;


/***************************************************************************************
 * 2. FORM LOAD
 ***************************************************************************************/

/**
 * @description     업무 탭 초기화 함수
 *                  - 최초 로딩 시 탭 목록, 선택 메뉴, 표시 시작 위치 초기화
 * @param           {obj    : nexacro.Form      }   이벤트 발생 Form
 * @param           {e      : nexacro.EventInfo }   이벤트 정보
 */
this.fn_init = function(obj, e)
{
    this.fv_tabList = [];
    this.fv_activeMenuCd = "";
    this.fv_tabStartIndex = 0;
};


/***************************************************************************************
 * 3. 공통 버튼
 ***************************************************************************************/


/***************************************************************************************
 * 4. TRANSACTION, CALLBACK
 ***************************************************************************************/


/***************************************************************************************
 * 5. 팝업 호출 및 콜백
 ***************************************************************************************/


/***************************************************************************************
 * 6. 기타 함수
 ***************************************************************************************/

/*
 * 기능 : 업무 컨텐츠 영역 조회
 * 설명 : MDI, 홈 화면, 업무 FrameSet을 포함하는 VFrameSet 반환
 */
this.fn_getContentFrameSet = function()
{
    var objApp = nexacro.getApplication();

    return objApp.mainframe.VFrameSetMain.VFrameSetWork.HFrameSetWork.VFrameSetContent;
};


/*
 * 기능 : 업무 FrameSet 조회
 * 설명 : 동적으로 생성한 업무 ChildFrame의 부모 객체 반환
 */
this.fn_getWorkFrameSet = function()
{
    var objContent = this.fn_getContentFrameSet();

    if (!objContent) return null;

    return objContent.FrameSetWork;
};


/*
 * 기능 : 업무 탭 정보 조회
 * 설명 : 메뉴 코드에 해당하는 탭 정보 반환
 */
this.fn_getTabInfo = function(sMenuCd)
{
    for (var i = 0; i < this.fv_tabList.length; i++)
    {
        if (this.fv_tabList[i].menuCd == sMenuCd)
        {
            return this.fv_tabList[i];
        }
    }

    return null;
};


/**
 * @description     업무 탭 최대 개수 조회 함수
 *                  - 공통 LIB(gfn_getProfile)로 sys_profile 의 MDI_TAB_MAX_CNT 조회
 *                  - 값이 없거나 숫자가 아니거나 0 이하이면 기본값(fv_tabMaxDefault) 사용
 * @return          {Number} 업무 탭 최대 개수
 * @example         var nMaxCnt = this.fn_getTabMaxCnt();
 */
this.fn_getTabMaxCnt = function()
{
    // 프로파일 값 조회 (문자열)
    var sMaxCnt = this.gfn_getProfile(this.fv_tabMaxProfileCd, String(this.fv_tabMaxDefault));

    // 숫자로 변환
    var nMaxCnt = parseInt(sMaxCnt, 10);

    // 잘못된 값이면 기본값
    if (isNaN(nMaxCnt) || nMaxCnt <= 0)
    {
        nMaxCnt = this.fv_tabMaxDefault;
    }

    return nMaxCnt;
};


/*
 * 기능 : 업무 탭 생성 및 화면 열기
 * 설명 : 동일한 메뉴가 열려 있으면 기존 화면 선택
 *        신규 메뉴이면 최대 개수 확인 후 업무 영역을 먼저 확보하고
 *        ChildFrame을 생성하여 FrameSet에 등록
 */
this.fn_openTab = function(sMenuCd, sMenuNm, sFormUrl)
{
    // 필수 메뉴정보 확인
    if (!sMenuCd || !sFormUrl) return;

    // 이미 열린 업무 탭이면 기존 화면 활성화 (최대 개수 확인 대상 아님)
    var objInfo = this.fn_getTabInfo(sMenuCd);

    if (objInfo)
    {
        this.fn_selectTab(sMenuCd);
        return;
    }

    // 업무 탭 최대 개수 확인 (프로파일 : MDI_TAB_MAX_CNT)
    var nMaxCnt = this.fn_getTabMaxCnt();

    if (this.fv_tabList.length >= nMaxCnt)
    {
        this.alert("화면은 최대 " + nMaxCnt + "개 까지 오픈 가능합니다.");
        return;
    }

    // 업무 FrameSet 조회
    var objFrameSet = this.fn_getWorkFrameSet();

    if (!objFrameSet)
    {
        this.alert("업무 FrameSet을 찾을 수 없습니다.");
        return;
    }

    // 메뉴 코드로 ChildFrame ID 생성
    var sFrameId = "Work_" + String(sMenuCd).replace(/[^a-zA-Z0-9_]/g, "_");

    // 프레임 ID 중복 확인
    if (objFrameSet[sFrameId])
    {
        this.alert("업무 프레임 ID가 중복됩니다.");
        return;
    }

    // 업무 화면을 먼저 표시하여 FrameSetWork 높이 확보
    var objApp = nexacro.getApplication();
    var objContent = objApp.mainframe.VFrameSetMain.VFrameSetWork.HFrameSetWork.VFrameSetContent;

    objContent.set_separatesize("30,0,*");

    // 신규 업무 ChildFrame 생성
    var objChildFrame = new nexacro.ChildFrame();

    objChildFrame.init(sFrameId, 0, 0, null, null, 0, 0);

    // FrameSet에 신규 프레임 등록
    objFrameSet.addChild(sFrameId, objChildFrame);

    // 프레임 기본 속성 설정
    objChildFrame.set_titletext(sMenuNm);
    objChildFrame.set_showtitlebar(false);
    objChildFrame.set_showstatusbar(false);
    objChildFrame.set_formurl(sFormUrl);

    // 신규 업무 화면 표시
    objChildFrame.show();
	
	// 업무 ChildFrame을 부모 FrameSet 영역에 최대화
	objChildFrame.set_openstatus("maximize");

    // 열린 업무 탭 목록에 추가
    this.fv_tabList.push({ menuCd: sMenuCd, menuNm: sMenuNm, formUrl: sFormUrl, frameId: sFrameId });

    // 신규 업무 탭 선택
    this.fn_selectTab(sMenuCd);
};


/*
 * 기능 : 업무 탭 선택
 * 설명 : 홈 화면과 업무 FrameSet 표시 상태 전환
 *        선택한 업무 ChildFrame만 표시하고 나머지는 숨김
 *        선택한 업무의 상단 및 왼쪽 메뉴 복원
 *        선택한 업무 탭이 보이도록 탭 표시 위치 조정
 */
this.fn_selectTab = function(sMenuCd)
{
    var objContent  = this.fn_getContentFrameSet();
    var objFrameSet = this.fn_getWorkFrameSet();

    if (!objContent || !objFrameSet) return;

    // 홈 화면 선택
    if (!sMenuCd)
    {
        // MDI 30px, 홈 화면 표시, 업무 FrameSet 숨김
        objContent.set_separatesize("30,*,0");

        // 현재 활성 메뉴 코드 초기화
        this.fv_activeMenuCd = "";

        // 업무 탭 버튼 갱신 (현재 표시 위치 유지)
        this.fn_createTabs(false);
        return;
    }

    // 선택한 업무 탭 확인
    var objInfo = this.fn_getTabInfo(sMenuCd);

    if (!objInfo) return;

    // 선택한 업무 ChildFrame 조회
    var objChildFrame = objFrameSet[objInfo.frameId];

    if (!objChildFrame) return;

    // MDI 30px, 홈 화면 숨김, 업무 FrameSet 표시
    objContent.set_separatesize("30,0,*");

    // 모든 업무 ChildFrame의 표시 상태 변경
	for (var i = 0; i < objFrameSet.frames.length; i++)
	{
		var objFrame = objFrameSet.frames[i];

		// 선택한 업무 프레임만 표시
		objFrame.set_visible(objFrame.name == objInfo.frameId);
	}

	// 선택한 업무 프레임을 전체 업무 영역에 최대화
	objChildFrame.set_openstatus("maximize");

	// 선택한 업무 프레임 활성화
	objChildFrame.setFocus();

    // 현재 활성 메뉴 코드 저장
    this.fv_activeMenuCd = sMenuCd;

    // 선택한 업무의 상단 및 왼쪽 메뉴 복원
    this.fn_syncTopMenu(sMenuCd);

    // 업무 탭 버튼 갱신 (선택한 탭이 보이도록 위치 조정)
    this.fn_createTabs(true);
};



/*
 * 기능 : 상단 및 왼쪽 메뉴 복원
 * 설명 : 3레벨 업무 메뉴의 상위 1레벨 메뉴를 찾아 선택
 */
this.fn_syncTopMenu = function(sMenuCd)
{
    var objApp = nexacro.getApplication();
    var dsMenu = objApp.gds_menu;

    if (!dsMenu) return;

    var sParentCd  = "";
    var sTopMenuCd = "";

    // 업무 메뉴의 부모 코드 검색
    for (var i = 0; i < dsMenu.rowcount; i++)
    {
        if (dsMenu.getColumn(i, "CHILD_MENU_CD") == sMenuCd)
        {
            sParentCd = dsMenu.getColumn(i, "PARENT_MENU_CD");
            break;
        }
    }

    // 부모 메뉴가 속한 최상위 메뉴 코드 검색
    for (var j = 0; j < dsMenu.rowcount; j++)
    {
        if (dsMenu.getColumn(j, "CHILD_MENU_CD") == sParentCd)
        {
            sTopMenuCd = dsMenu.getColumn(j, "PARENT_MENU_CD");
            break;
        }
    }

    if (!sTopMenuCd) return;

    // 상단 메뉴 프레임 조회
    var objMenuFrame = objApp.mainframe.VFrameSetMain.VFrameSetWork.MenuFrame;

    if (!objMenuFrame || !objMenuFrame.form || !objMenuFrame.form.fn_selectTopMenu) return;

    // 상단 메뉴 선택 시 왼쪽 메뉴도 함께 갱신
    objMenuFrame.form.fn_selectTopMenu(sTopMenuCd);
};


/**
 * @description     업무 탭 버튼 생성 함수
 *                  - 열린 업무 탭 목록을 기준으로 선택 및 닫기 버튼 구성
 *                  - 업무 탭 전체 너비가 MDI 넓이를 초과하면 이동 버튼(‹ ›) 표시
 *                  - 표시 가능한 개수만큼 fv_tabStartIndex 부터 탭 표시
 * @param           {bShowActive : Boolean} true  : 선택한 업무 탭이 보이도록 표시 위치 조정
 *                                          false : 현재 표시 위치 유지 (이동 버튼, 탭 닫기 등)
 * @example         this.fn_createTabs(true);
 */
this.fn_createTabs = function(bShowActive)
{
    // 기존 동적 업무 탭 버튼 제거
    for (var i = this.components.length - 1; i >= 0; i--)
    {
        var objComp = this.components[i];

        if (objComp.name.indexOf("btn_tab_") == 0 || objComp.name.indexOf("btn_close_") == 0)
        {
            this.removeChild(objComp.name);
            objComp.destroy();
        }
    }

    var nTabCnt   = this.fv_tabList.length;
    var nTabWidth = this.fv_tabWidth;

    // 업무 탭을 표시할 수 있는 영역 너비 (홈 버튼 제외)
    //var nAreaWidth = this.getOffsetWidth() - this.fv_tabLeft;

    // 업무 탭 전체 너비가 영역을 초과하는지 확인
    //var bOverflow = (nTabCnt * nTabWidth > nAreaWidth);

    // 초과 시 이동 버튼 영역만큼 표시 영역 축소
    //if (bOverflow)
    //{
    //    nAreaWidth -= this.fv_tabNavWidth;
    //}
	// 업무 탭을 표시할 수 있는 영역 너비 (홈 버튼, 이동 버튼 영역 제외)
    var nAreaWidth = this.getOffsetWidth() - this.fv_tabLeft - this.fv_tabNavWidth;

    // 한 번에 표시 가능한 업무 탭 개수 (최소 1개)
    var nVisibleCnt = Math.max(1, Math.floor(nAreaWidth / nTabWidth));

    // 선택한 업무 탭이 보이도록 표시 시작 위치 조정
    if (bShowActive)
    {
        var nActiveIndex = -1;

        for (var k = 0; k < nTabCnt; k++)
        {
            if (this.fv_tabList[k].menuCd == this.fv_activeMenuCd)
            {
                nActiveIndex = k;
                break;
            }
        }

        if (nActiveIndex >= 0)
        {
            // 선택한 탭이 표시 범위 왼쪽에 있으면 시작 위치를 당김
            if (nActiveIndex < this.fv_tabStartIndex)
            {
                this.fv_tabStartIndex = nActiveIndex;
            }

            // 선택한 탭이 표시 범위 오른쪽에 있으면 시작 위치를 밂
            if (nActiveIndex >= this.fv_tabStartIndex + nVisibleCnt)
            {
                this.fv_tabStartIndex = nActiveIndex - nVisibleCnt + 1;
            }
        }
    }

    // 표시 시작 위치 범위 보정 (0 ~ 마지막 탭이 보이는 위치)
    var nMaxStart = Math.max(0, nTabCnt - nVisibleCnt);

    this.fv_tabStartIndex = Math.min(Math.max(0, this.fv_tabStartIndex), nMaxStart);

    // 표시 범위의 업무 탭만 생성
    var nLeft = this.fv_tabLeft;
    var nEnd  = Math.min(nTabCnt, this.fv_tabStartIndex + nVisibleCnt);

    for (var j = this.fv_tabStartIndex; j < nEnd; j++)
    {
        var objInfo = this.fv_tabList[j];

        // 업무 탭 선택 버튼
        var sTabId = "btn_tab_" + j;

        //var objTab = new nexacro.Button(sTabId, nLeft, 0, nTabWidth, 30, null, null, null, null, null, null, this);
		var objTab = new nexacro.Button(sTabId, nLeft, this.fv_tabTop, nTabWidth, this.fv_tabHeight, null, null, null, null, null, null, this);

        this.addChild(sTabId, objTab);

        objTab.set_text(objInfo.menuNm);
        objTab.set_cssclass(objInfo.menuCd == this.fv_activeMenuCd ? "besMdiTabSelected" : "besMdiTab");
        objTab.set_cursor("pointer");
        objTab.menuCd = objInfo.menuCd;

        objTab.addEventHandler("onclick", this.fn_tab_onclick, this);
        objTab.show();

        // 업무 탭 닫기 버튼
        var sCloseId = "btn_close_" + j;

        //var objClose = new nexacro.Button(sCloseId, nLeft + nTabWidth - 28, 4, 22, 22, null, null, null, null, null, null, this);
		var objClose = new nexacro.Button(sCloseId, nLeft + nTabWidth - 26, this.fv_tabTop + 4, 18, 18, null, null, null, null, null, null, this);

        this.addChild(sCloseId, objClose);

        objClose.set_text("×");
        objClose.set_cssclass("besMdiTabClose");
        objClose.set_cursor("pointer");
        objClose.menuCd = objInfo.menuCd;

        objClose.addEventHandler("onclick", this.fn_close_onclick, this);
        objClose.show();

        // 다음 탭 위치
        nLeft += nTabWidth;
    }

    // 이동 버튼 표시 및 활성 상태 (맨 앞이면 ‹ 비활성, 맨 끝이면 › 비활성)
    //this.btn_tabPrev.set_visible(bOverflow);
    //this.btn_tabNext.set_visible(bOverflow);

    this.btn_tabPrev.set_enable(this.fv_tabStartIndex > 0);
    this.btn_tabNext.set_enable(this.fv_tabStartIndex + nVisibleCnt < nTabCnt);
};
 

/*
 * 기능 : 업무 탭 닫기
 * 설명 : 해당 ChildFrame 제거 후 다음 업무 탭 또는 홈 선택
 */
this.fn_closeTab = function(sMenuCd)
{
    var nCloseIndex = -1;

    // 닫을 탭 검색
    for (var i = 0; i < this.fv_tabList.length; i++)
    {
        if (this.fv_tabList[i].menuCd == sMenuCd)
        {
            nCloseIndex = i;
            break;
        }
    }

    if (nCloseIndex < 0) return;

    var bActive = (this.fv_activeMenuCd == sMenuCd);
    var objInfo = this.fv_tabList[nCloseIndex];

    var objFrameSet = this.fn_getWorkFrameSet();

    if (!objFrameSet) return;

    // 해당 업무 ChildFrame 제거
    var objChildFrame = objFrameSet[objInfo.frameId];

    if (objChildFrame)
    {
        objFrameSet.removeChild(objInfo.frameId);
        objChildFrame.destroy();
    }

    // 탭 목록에서 제거
    this.fv_tabList.splice(nCloseIndex, 1);

    if (bActive)
    {
        var sNextMenuCd = "";

        // 남은 업무 탭이 있으면 다음 탭 선택
        if (this.fv_tabList.length > 0)
        {
            var nNextIndex = Math.min(nCloseIndex, this.fv_tabList.length - 1);

            sNextMenuCd = this.fv_tabList[nNextIndex].menuCd;
        }

        this.fn_selectTab(sNextMenuCd);
    }
    else
    {
        // 현재 표시 위치 유지 (범위는 fn_createTabs 에서 자동 보정)
        this.fn_createTabs(false);
    }
};


/*
 * 기능 : 전체 업무 탭 초기화
 * 설명 : 로그아웃 시 생성된 업무 ChildFrame을 모두 제거
 *        탭 관리 배열, 선택 메뉴, 표시 시작 위치를 초기화하고 홈 화면 복원
 */
this.fn_closeAllTabs = function()
{
    // 업무 FrameSet 및 컨텐츠 영역 조회
    var objFrameSet = this.fn_getWorkFrameSet();
    var objContent  = this.fn_getContentFrameSet();

    // 업무 FrameSet을 찾지 못하면 초기화 실패
    if (!objFrameSet || !objContent) return false;

    // 모든 업무 ChildFrame을 역순으로 제거
    for (var i = this.fv_tabList.length - 1; i >= 0; i--)
    {
        // 현재 제거할 업무 탭 정보
        var objInfo = this.fv_tabList[i];

        // 해당 메뉴의 업무 ChildFrame 조회
        var objChildFrame = objFrameSet[objInfo.frameId];

        // 실제 업무 프레임 제거
        if (objChildFrame)
        {
            objFrameSet.removeChild(objInfo.frameId);
            objChildFrame.destroy();
        }
    }

    // 전체 업무 탭 목록 초기화
    this.fv_tabList = [];

    // 현재 선택된 업무 메뉴 초기화
    this.fv_activeMenuCd = "";

    // 업무 탭 표시 시작 위치 초기화
    this.fv_tabStartIndex = 0;

    // MDI 버튼 목록 초기화
    this.fn_createTabs(false);

    // 기존 Form_Work 홈 화면 표시
    objContent.set_separatesize("30,*,0");

    return true;
};


/***************************************************************************************
 * 7. 이벤트
 ***************************************************************************************/

/*
 * 기능 : 업무 탭 영역 로딩 이벤트
 */
this.Form_Mdi_onload = function(obj, e)
{
    this.fn_init(obj, e);
};


/**
 * @description     업무 탭 영역 크기 변경 이벤트
 *                  - 브라우저 크기나 왼쪽 메뉴 접기/펼치기로 MDI 넓이가 바뀌면
 *                    표시 가능한 탭 개수와 이동 버튼 표시 여부를 다시 계산
 * @param           {obj    : nexacro.Form          }   이벤트 발생 Form
 * @param           {e      : nexacro.SizeEventInfo }   크기 변경 이벤트 정보
 */
this.Form_Mdi_onsize = function(obj, e)
{
    // 업무 탭이 없으면 다시 그릴 필요 없음
    if (this.fv_tabList.length == 0) return;

    this.fn_createTabs(true);
};


/*
 * 기능 : 홈 버튼 클릭
 */
this.btn_home_onclick = function(obj, e)
{
    this.fn_selectTab("");
};


/*
 * 기능 : 업무 탭 선택 버튼 클릭
 */
this.fn_tab_onclick = function(obj, e)
{
    this.fn_selectTab(obj.menuCd);
};


/*
 * 기능 : 업무 탭 닫기 버튼 클릭
 */
this.fn_close_onclick = function(obj, e)
{
    this.fn_closeTab(obj.menuCd);
};


/**
 * @description     이전 업무 탭 이동 버튼(‹) 클릭 이벤트
 *                  - 표시 시작 위치를 한 칸 왼쪽으로 이동 (선택 탭은 변경하지 않음)
 * @param           {obj    : nexacro.Button            }   이벤트 발생 컴포넌트 : btn_tabPrev
 * @param           {e      : nexacro.ClickEventInfo    }   클릭 이벤트 정보
 */
this.btn_tabPrev_onclick = function(obj, e)
{
    this.fv_tabStartIndex--;

    // 범위 보정은 fn_createTabs 에서 처리
    this.fn_createTabs(false);
};


/**
 * @description     다음 업무 탭 이동 버튼(›) 클릭 이벤트
 *                  - 표시 시작 위치를 한 칸 오른쪽으로 이동 (선택 탭은 변경하지 않음)
 * @param           {obj    : nexacro.Button            }   이벤트 발생 컴포넌트 : btn_tabNext
 * @param           {e      : nexacro.ClickEventInfo    }   클릭 이벤트 정보
 */
this.btn_tabNext_onclick = function(obj, e)
{
    this.fv_tabStartIndex++;

    // 범위 보정은 fn_createTabs 에서 처리
    this.fn_createTabs(false);
};
]]></Script>
  </Form>
</FDL>
