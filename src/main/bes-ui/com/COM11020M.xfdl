<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="COM11020M" width="1007" height="720" titletext="메뉴등록" font="bold 12px/normal &quot;Dotum&quot;,&quot;돋움&quot;,&quot;Noto Sans KR Medium&quot;,&quot;Noto Sans KR Light&quot;,&quot;Noto Sans KR ExtraLight&quot;,&quot;Noto Sans KR ExtraBold&quot;,&quot;Noto Sans KR DemiLight&quot;,&quot;Noto Sans KR Black&quot;,&quot;Noto Sans KR SemiBold&quot;,&quot;Noto Sans KR Thin&quot;" onload="fn_init">
    <Layouts>
      <Layout width="1007" height="720" mobileorientation="landscape">
        <!-- 화면 기본 여백 -->
        <Static id="sta_margin_left" taborder="0" text="10" left="0" top="0" width="10" height="720" background="aqua" textAlign="center" visible="false"/>
        <Static id="sta_margin_top" taborder="1" text="10" left="0" top="0" width="1007" height="10" background="aqua" textAlign="center" visible="false"/>
        <Static id="sta_margin_right" taborder="2" text="10" right="0" top="0" width="10" height="720" background="aqua" textAlign="center" visible="false"/>
        <Static id="sta_margin_bottom" taborder="3" text="10" left="0" bottom="0" width="1007" height="10" background="aqua" textAlign="center" visible="false"/>
        <!-- 1. 공통 상단 영역 -->
        <Div id="div_com" taborder="4" text="28" left="10" top="sta_margin_top:0" height="28" right="10">
          <Layouts>
            <Layout>
              <Button id="btn_searchOpen" taborder="0" left="0" top="2" width="30" height="24" cssclass="btn_WF_searchOpen"/>
              <Static id="sta_title" taborder="1" text="메뉴등록" left="btn_searchOpen:5" top="2" width="100" height="24" cssclass="sta_WF_title" fittocontents="width" font="bold 14px/normal &quot;Malgun Gothic&quot;,&quot;Noto Sans KR Black&quot;"/>
              <Button id="btn_save" taborder="2" top="0" height="28" right="4" width="34" icon="url('theme://bes_icon/16/bes_icon_save_red.png')" tooltiptext="저장" cssclass="btn_WF_save" onclick="fn_save"/>
            </Layout>
          </Layouts>
        </Div>
        <!-- 2. 조회조건 영역 : TPL10000M 규격 -->
        <Div id="div_search" taborder="5" left="10" top="div_com:5" height="46" background="#f6f6f6" right="10" font="12px/normal &quot;Dotum&quot;,&quot;돋움&quot;,&quot;Noto Sans KR Medium&quot;,&quot;Noto Sans KR Light&quot;,&quot;Noto Sans KR ExtraLight&quot;,&quot;Noto Sans KR ExtraBold&quot;,&quot;Noto Sans KR DemiLight&quot;,&quot;Noto Sans KR Black&quot;,&quot;Noto Sans KR SemiBold&quot;,&quot;Noto Sans KR Thin&quot;" formscrolltype="none" formscrollbartype="none">
          <Layouts>
            <Layout>
              <!-- 조회조건 좌측 여백 -->
              <Static id="sta_margin_left" taborder="0" text="10" left="0" top="0" width="10" bottom="0" background="aqua" textAlign="center" visible="false"/>
              <!-- 메뉴검색 -->
              <Static id="sta_menu" taborder="1" text="메뉴코드/메뉴명" left="sta_margin_left:0" top="10" width="100" height="24" verticalAlign="middle" textAlign="right" font="12px/normal &quot;Malgun Gothic&quot;,&quot;Noto Sans KR Black&quot;"/>
              <Edit id="edt_menu" taborder="2" left="sta_menu:5" top="10" width="200" height="24" font="12px/normal &quot;Malgun Gothic&quot;,&quot;Noto Sans KR Black&quot;" onkeydown="div_search_edt_menu_onkeydown"/>
              <!-- 조회조건 간격 -->
              <Static id="sta_margin_left00" taborder="3" text="10" left="edt_menu:10" top="0" width="10" bottom="0" background="aqua" textAlign="center" visible="false"/>
              <!-- 사용여부 -->
              <Static id="sta_use_yn" taborder="4" text="사용여부" left="sta_margin_left00:0" top="10" width="100" height="24" verticalAlign="middle" textAlign="right" font="12px/normal &quot;Malgun Gothic&quot;,&quot;Noto Sans KR Black&quot;"/>
              <Combo id="cbo_use_yn" taborder="5" left="sta_use_yn:5" top="10" width="150" height="24" innerdataset="ds_search_yn" codecolumn="CODE" datacolumn="NAME" index="0" font="12px/normal &quot;Malgun Gothic&quot;,&quot;Noto Sans KR Black&quot;"/>
              <!-- 조회 및 초기화 -->
              <Button id="btn_searchClear" taborder="7" top="9" height="28" tooltiptext="초기화" width="34" right="4" onclick="fn_searchClear" icon="url('theme://bes_icon/16/bes_icon_reset_navy.png')" cssclass="btn_WF_searchClear"/>
              <Button id="btn_search" taborder="6" top="9" width="34" height="28" tooltiptext="조회" icon="url('theme://bes_icon/14/bes_icon_search_navy_14.png')" onclick="fn_search" right="btn_searchClear:2" cssclass="btn_WF_search"/>
              <!-- 조회조건 우측 여백 -->
              <Static id="sta_margin_right" taborder="8" text="4" top="0" right="0" width="4" bottom="0" background="aqua" textAlign="center" visible="false"/>
            </Layout>
          </Layouts>
        </Div>
        <!-- 3. 목록 제목 및 추가 공통 버튼 -->
        <Div id="div_title" taborder="6" text="32" left="10" top="div_search:5" height="32" right="10">
          <Layouts>
            <Layout>
              <Button id="btn_favorite" taborder="0" left="0" top="2" width="24" height="24" cssclass="btn_WF_favorite"/>
              <Static id="sta_title" taborder="1" text="메뉴 목록" left="btn_favorite:5" top="1" width="68" height="24" cssclass="sta_WF_title" font="bold 12px/normal &quot;Malgun Gothic&quot;,&quot;Noto Sans KR Black&quot;" fittocontents="width"/>
              <Static id="sta_titleCnt" taborder="2" text="| 0건" left="sta_title:1" top="1" width="70" height="24" cssclass="sta_WF_titleCnt" font="10px/normal &quot;Malgun Gothic&quot;,&quot;Noto Sans KR Black&quot;" fittocontents="width"/>
              <Button id="btn_delRow" taborder="4" top="2" width="34" height="28" tooltiptext="행삭제" right="4" icon="url('theme://bes_icon/16/bes_icon_delrow_navy.png')" onclick="fn_del_row" cssclass="btn_WF_delRow"/>
              <Button id="btn_addRow" taborder="3" top="2" width="34" height="28" tooltiptext="행추가" right="btn_delRow:2" onclick="fn_add_row" icon="url('theme://bes_icon/16/bes_icon_addrow_navy.png')" cssclass="btn_WF_addRow"/>
              <Button id="btn_excel_down" taborder="5" top="2" width="34" height="28" tooltiptext="엑셀다운로드" right="btn_addRow:2" icon="url('theme://bes_icon/16/bes_icon_exceldown_navy.png')" cssclass="btn_WF_excelDown" onclick="fn_excel_down"/>
            </Layout>
          </Layouts>
        </Div>
        <!-- 4. 메뉴 목록 Grid -->
        <Grid id="grd_menu" taborder="7" left="10" top="div_title:0" right="10" bottom="10" binddataset="dsMenu" selecttype="row" autoenter="select" autofittype="col" font="12px/normal &quot;Malgun Gothic&quot;,&quot;Noto Sans KR Black&quot;">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="44"/>
                <Column size="85"/>
                <Column size="130"/>
                <Column size="130"/>
                <Column size="170"/>
                <Column size="225"/>
                <Column size="80"/>
                <Column size="85"/>
                <Column size="95"/>
                <Column size="180"/>
              </Columns>
              <Rows>
                <Row size="28" band="head"/>
                <Row size="28"/>
              </Rows>
              <Band id="head">
                <Cell col="0" text="No" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
                <Cell col="1" text="메뉴 ID" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
                <Cell col="2" text="*상위 메뉴 코드" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
                <Cell col="3" text="*메뉴 코드" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
                <Cell col="4" text="*메뉴명" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
                <Cell col="5" text="화면 경로" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
                <Cell col="6" text="*레벨" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
                <Cell col="7" text="*표시 순서" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
                <Cell col="8" text="*사용 여부" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
                <Cell col="9" text="비고" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
              </Band>
              <Band id="body">
                <Cell col="0" text="expr:currow+1" edittype="none" displaytype="normal" textAlign="center"/>
                <Cell col="1" text="bind:MENU_ID" edittype="none" displaytype="normal" textAlign="center"/>
                <Cell col="2" text="bind:PARENT_MENU_CD" edittype="text" displaytype="editcontrol"/>
                <Cell col="3" text="bind:CHILD_MENU_CD" edittype="text" displaytype="editcontrol"/>
                <Cell col="4" text="bind:CHILD_MENU_NM" edittype="text" displaytype="editcontrol"/>
                <Cell col="5" text="bind:CHILD_PAGE_ULR" edittype="text" displaytype="editcontrol"/>
                <Cell col="6" text="bind:CHILD_MENU_LEVEL" edittype="text" displaytype="editcontrol" textAlign="center"/>
                <Cell col="7" text="bind:CHILD_MENU_SEQ" edittype="text" displaytype="editcontrol" textAlign="center"/>
                <Cell col="8" text="bind:USER_YN" edittype="combo" displaytype="combocontrol" combodataset="ds_yn" combocodecol="CODE" combodatacol="NAME"/>
                <Cell col="9" text="bind:REMARK" edittype="text" displaytype="editcontrol"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
      </Layout>
    </Layouts>
    <Objects>
      <!-- 메뉴 목록 Dataset -->
      <Dataset id="dsMenu" useclientlayout="true">
        <ColumnInfo>
          <Column id="MENU_ID" type="BIGDECIMAL" size="20"/>
          <Column id="PARENT_MENU_CD" type="STRING" size="30"/>
          <Column id="CHILD_MENU_CD" type="STRING" size="30"/>
          <Column id="CHILD_MENU_NM" type="STRING" size="200"/>
          <Column id="CHILD_PAGE_ULR" type="STRING" size="100"/>
          <Column id="CHILD_MENU_LEVEL" type="INT" size="4"/>
          <Column id="CHILD_MENU_SEQ" type="INT" size="4"/>
          <Column id="USER_YN" type="STRING" size="1"/>
          <Column id="BTN_SEARCH_YN" type="STRING" size="1"/>
          <Column id="BTN_SEARCH_INIT_YN" type="STRING" size="1"/>
          <Column id="BTN_SAVE_YN" type="STRING" size="1"/>
          <Column id="BTN_ADD_ROW_YN" type="STRING" size="1"/>
          <Column id="BTN_DEL_ROW_YN" type="STRING" size="1"/>
          <Column id="BTN_EXCEL_DOWN_YN" type="STRING" size="1"/>
          <Column id="BTN_EXCEL_UP_YN" type="STRING" size="1"/>
          <Column id="BTN_PRINT_YN" type="STRING" size="1"/>
          <Column id="BTN_BATCH_YN" type="STRING" size="1"/>
          <Column id="REMARK" type="STRING" size="4000"/>
        </ColumnInfo>
      </Dataset>
      <!-- Grid 사용 여부 Combo Dataset -->
      <Dataset id="ds_yn">
        <ColumnInfo>
          <Column id="CODE" type="STRING" size="1"/>
          <Column id="NAME" type="STRING" size="20"/>
        </ColumnInfo>
        <Rows>
          <Row>
            <Col id="CODE">Y</Col>
            <Col id="NAME">사용</Col>
          </Row>
          <Row>
            <Col id="CODE">N</Col>
            <Col id="NAME">미사용</Col>
          </Row>
        </Rows>
      </Dataset>
      <!-- 조회조건 사용 여부 Combo Dataset -->
      <Dataset id="ds_search_yn">
        <ColumnInfo>
          <Column id="CODE" type="STRING" size="1"/>
          <Column id="NAME" type="STRING" size="20"/>
        </ColumnInfo>
        <Rows>
          <Row>
            <Col id="CODE"/>
            <Col id="NAME">전체</Col>
          </Row>
          <Row>
            <Col id="CODE">Y</Col>
            <Col id="NAME">사용</Col>
          </Row>
          <Row>
            <Col id="CODE">N</Col>
            <Col id="NAME">미사용</Col>
          </Row>
        </Rows>
      </Dataset>
    </Objects>
    <Script type="xscript5.1"><![CDATA[/***************************************************************************************
 * 프로젝트        : Built1 Enterprise System 구축 프로젝트
 * 업무구분        : 공통관리
 * 파일명          : COM11020M.xfdl
 * 작성자          : Built1
 * 작성일          : 2026-11-04
 *
 * 화면            : 메뉴등록
 * 설명            : 메뉴정보 조회, 등록, 수정 및 삭제
 *---------------------------------------------------------------------------------------
 * 변경일            변경자            변경내역
 *---------------------------------------------------------------------------------------
 * 2026-11-04        Built1            최초작성
 * 2026-11-10        Built1            TPL10000M 표준 디자인 및 스크립트 구조 적용
 ***************************************************************************************/


/***************************************************************************************
 * 1. 폼 변수
 * : 폼에서 사용할 공통 변수를 선언
 ***************************************************************************************/


/***************************************************************************************
 * 2. 폼 오픈
 * : 화면을 로딩시 기본적으로 처리할 기능 또는 초기값 할당
 **************************************************************************************/

/*
 * 기능 : 화면 최초 로드 및 메뉴 조회
 */
this.fn_init = function(obj:Form, e:nexacro.LoadEventInfo)
{
    // 조회조건 초기값 설정
    this.div_search.form.edt_menu.set_value("");
    this.div_search.form.cbo_use_yn.set_index(0);

    // 메뉴 목록 초기화
    this.dsMenu.clearData();
    this.fn_setCount();

    // 최초 메뉴 조회
    this.fn_search();
};


/***************************************************************************************
 * 3. 공통 버튼
 * : 조회, 조회초기화, 저장, 신규, 삭제, 도움말, 출력
 **************************************************************************************/

/*
 * 기능 : 조회
 * : 조회조건 항목별 값을 기준으로 데이터를 조회하는 기능
 */
this.fn_search = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
    // 그리드 편집 내용 Dataset 반영
    this.grd_menu.updateToDataset();

    // 저장하지 않은 변경사항 확인
    if (this.gfn_dataSetChange(this.dsMenu))
    {
        if (!this.confirm("저장하지 않은 변경사항이 있습니다. 다시 조회하시겠습니까?"))
        {
            return;
        }
    }

    // 조회조건
    var sMenuText     = this.div_search.form.edt_menu.value;
    var sUseYn        = this.div_search.form.cbo_use_yn.value;

    // Transaction 설정
    var sSvcID        = "selectMenuList";
    var sSvcURL       = "svcUrl::com/menu/selectMenuList.do";
    var sInDataSets   = "";
    var sOutDataSets  = "dsMenu=outMenu";
    var sArgument     = "menuText=" + nexacro.wrapQuote(this.gfn_isNull(sMenuText) ? "" : sMenuText);
        sArgument    += " userYn=" + nexacro.wrapQuote(this.gfn_isNull(sUseYn) ? "" : sUseYn);
    var sCallbackFunc = "fn_callBack";
	trace("[메뉴조회] menuText = " + sMenuText);
	trace("[메뉴조회] userYn = " + sUseYn);
	trace("[메뉴조회] sArgument = " + sArgument);

    // 메뉴 목록 조회
    this.gfn_transaction(sSvcID, sSvcURL, sInDataSets, sOutDataSets, sArgument, sCallbackFunc);
};


/*
 * 기능 : 조회초기화
 * : 조회 조건의 항목별 값을 초기화하는 기능
 */
this.fn_searchClear = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
    // 조회조건 초기화
    this.div_search.form.edt_menu.set_value("");
    this.div_search.form.cbo_use_yn.set_index(0);

    // 메뉴 목록 재조회
    this.fn_search();
};


/*
 * 기능 : 저장
 * : 신규, 수정, 삭제된 데이터를 저장하는 기능
 */
this.fn_save = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
    // 그리드 편집 내용 Dataset 반영
    this.grd_menu.updateToDataset();

    // 변경사항 확인
    if (!this.gfn_dataSetChange(this.dsMenu))
    {
        this.alert("저장할 변경사항이 없습니다.");
        return;
    }

    // 필수 입력값 검사
    if (!this.fn_validate())
    {
        return;
    }

    // 저장 확인
    if (!this.confirm("변경된 메뉴정보를 저장하시겠습니까?"))
    {
        return;
    }

    // Transaction 설정
    var sSvcID        = "saveMenuList";
    var sSvcURL       = "svcUrl::com/menu/saveMenuList.do";
    var sInDataSets   = "inMenu=dsMenu:U";
    var sOutDataSets  = "";
    var sArgument     = "";
    var sCallbackFunc = "fn_callBack";

    // 메뉴정보 저장
    this.gfn_transaction(sSvcID, sSvcURL, sInDataSets, sOutDataSets, sArgument, sCallbackFunc);
};


/***************************************************************************************
 * 4. 추가 공통 버튼
 * : 행추가, 행삭제, 엑셀다운로드, 엑셀업로드
 **************************************************************************************/

/*
 * 기능 : 행추가
 * : 그리드에 첫 행을 추가하는 기능
 */
this.fn_add_row = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
    // 그리드 편집 내용 Dataset 반영
    this.grd_menu.updateToDataset();

    // 메뉴 Dataset
    var objDs = this.dsMenu;

    // 첫 번째 행 추가
    var nRow = objDs.insertRow(0);

    // 신규 메뉴 기본값 설정
    objDs.setColumn(nRow, "PARENT_MENU_CD", "");
    objDs.setColumn(nRow, "CHILD_MENU_LEVEL", 1);
    objDs.setColumn(nRow, "CHILD_MENU_SEQ", objDs.rowcount);
    objDs.setColumn(nRow, "USER_YN", "Y");

    // 메뉴별 공통 버튼 사용 여부
    objDs.setColumn(nRow, "BTN_SEARCH_YN", "Y");
    objDs.setColumn(nRow, "BTN_SEARCH_INIT_YN", "Y");
    objDs.setColumn(nRow, "BTN_SAVE_YN", "Y");
    objDs.setColumn(nRow, "BTN_ADD_ROW_YN", "Y");
    objDs.setColumn(nRow, "BTN_DEL_ROW_YN", "Y");
    objDs.setColumn(nRow, "BTN_EXCEL_DOWN_YN", "Y");
    objDs.setColumn(nRow, "BTN_EXCEL_UP_YN", "N");
    objDs.setColumn(nRow, "BTN_PRINT_YN", "N");
    objDs.setColumn(nRow, "BTN_BATCH_YN", "N");

    // 신규 행 선택
    objDs.set_rowposition(nRow);

    // 메뉴 건수 표시
    this.fn_setCount();
};


/*
 * 기능 : 행삭제
 * : 그리드에서 선택된 행을 삭제하는 기능
 */
this.fn_del_row = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
    // 그리드 편집 내용 Dataset 반영
    this.grd_menu.updateToDataset();

    // 메뉴 Dataset 및 선택 행
    var objDs = this.dsMenu;
    var nRow  = objDs.rowposition;

    // 선택 행 확인
    if (nRow < 0)
    {
        this.alert("삭제할 메뉴를 선택하세요.");
        return;
    }

    // 삭제 확인
    if (!this.confirm("선택한 메뉴를 삭제하시겠습니까?"))
    {
        return;
    }

    // 선택 행 삭제
    objDs.deleteRow(nRow);

    // 메뉴 건수 표시
    this.fn_setCount();
};


/*
 * 기능 : 엑셀다운로드
 * : 그리드에 조회된 데이터를 엑셀로 다운로드하는 기능
 */
this.fn_excel_down = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
    // 엑셀다운로드 기능 추후 연결
    this.alert("엑셀다운로드 기능 연결 후 테스트할 예정입니다.");
};


/***************************************************************************************
 * 5. 콜백
 * : 데이터 조회, 저장, 삭제 등 트랜잭션 처리에 따른 결과를 관리하는 기능
 **************************************************************************************/

/*
 * 기능 : 메뉴 조회 및 저장 결과 처리
 */
this.fn_callBack = function(sSvcID, nErrCd, sErrMsg)
{
    // Transaction 오류 확인
    if (nErrCd < 0)
    {
        this.alert("처리 중 오류가 발생했습니다.\n" + sErrMsg);
        return;
    }

    switch (sSvcID)
    {
        // 메뉴 목록 조회
        case "selectMenuList":

            // 메뉴 건수 표시
            this.fn_setCount();
            break;

        // 메뉴정보 저장
        case "saveMenuList":

            // 변경상태 초기화
            this.dsMenu.applyChange();

            // 저장 완료 안내
            this.alert("저장되었습니다.");

            // 저장 후 재조회
            this.fn_search();
            break;
    }
};


/***************************************************************************************
 * 6. 팝업 호출 및 콜백
 * : 팝업화면 오픈 및 리턴된 결과를 콜백 처리하는 기능
 ***************************************************************************************/


/***************************************************************************************
 * 7. 기타 함수
 * : 화면에 특화된 함수를 사용하기 위한 기능
 **************************************************************************************/

/*
 * 기능 : 메뉴 목록 건수 표시
 */
this.fn_setCount = function()
{
    // 메뉴 목록 건수
    var nCnt = this.dsMenu.rowcount;

    // 목록 제목 건수 표시
    this.div_title.form.sta_titleCnt.set_text("| " + nCnt + "건");
};


/*
 * 기능 : 메뉴 입력값 검사
 */
this.fn_validate = function()
{
    // 메뉴 Dataset
    var objDs = this.dsMenu;

    // 신규 및 수정된 행 검사
    for (var i = 0; i < objDs.rowcount; i++)
    {
        var nRowType = objDs.getRowType(i);

        // 신규 및 수정된 행만 검사
        if (nRowType != Dataset.ROWTYPE_INSERT && nRowType != Dataset.ROWTYPE_UPDATE)
        {
            continue;
        }

        // 메뉴 입력값
        var sParentCd = objDs.getColumn(i, "PARENT_MENU_CD");
        var sMenuCd   = objDs.getColumn(i, "CHILD_MENU_CD");
        var sMenuNm   = objDs.getColumn(i, "CHILD_MENU_NM");
        var nLevel    = objDs.getColumn(i, "CHILD_MENU_LEVEL");
        var nSeq      = objDs.getColumn(i, "CHILD_MENU_SEQ");
        var sUseYn    = objDs.getColumn(i, "USER_YN");
        var sPageUrl  = objDs.getColumn(i, "CHILD_PAGE_ULR");

        // 필수 입력값 검사
        if (this.gfn_isNull(sParentCd) || this.gfn_isNull(sMenuCd) || this.gfn_isNull(sMenuNm))
        {
            this.alert((i + 1) + "행의 상위 메뉴 코드, 메뉴 코드, 메뉴명을 입력하세요.");
            objDs.set_rowposition(i);
            return false;
        }

        // 입력 길이 검사
        if (String(sParentCd).length > 30 ||
            String(sMenuCd).length > 30 ||
            String(sMenuNm).length > 200 ||
            (!this.gfn_isNull(sPageUrl) && String(sPageUrl).length > 100))
        {
            this.alert((i + 1) + "행의 입력 길이가 DB 컬럼 크기를 초과했습니다.");
            objDs.set_rowposition(i);
            return false;
        }

        // 메뉴 레벨 및 표시 순서 검사
        if (!/^\d+$/.test(String(nLevel)) || !/^\d+$/.test(String(nSeq)))
        {
            this.alert((i + 1) + "행의 메뉴 레벨과 표시 순서는 0 이상의 정수여야 합니다.");
            objDs.set_rowposition(i);
            return false;
        }

        // 사용 여부 검사
        if (sUseYn != "Y" && sUseYn != "N")
        {
            this.alert((i + 1) + "행의 사용 여부를 확인하세요.");
            objDs.set_rowposition(i);
            return false;
        }

        // 상위 메뉴 코드와 메뉴 코드 중복 검사
        if (sParentCd == sMenuCd)
        {
            this.alert((i + 1) + "행의 메뉴 코드는 자기 자신을 상위 메뉴로 지정할 수 없습니다.");
            objDs.set_rowposition(i);
            return false;
        }

        // 메뉴 코드 중복 검사
        for (var j = 0; j < objDs.rowcount; j++)
        {
            if (i != j && sMenuCd == objDs.getColumn(j, "CHILD_MENU_CD"))
            {
                this.alert("중복된 메뉴 코드입니다.\n" + sMenuCd);
                objDs.set_rowposition(i);
                return false;
            }
        }
    }

    return true;
};


/***************************************************************************************
 * 8. 이벤트
 * : 화면에서 각 컴포넌트별 이벤트를 작성하는 기능
 **************************************************************************************/

/*
 * 기능 : 메뉴검색 Enter 입력 이벤트
 */
this.div_search_edt_menu_onkeydown = function(obj:nexacro.Edit, e:nexacro.KeyEventInfo)
{
    // Enter 입력 시 메뉴 조회
    if (e.keycode == 13)
    {
        this.fn_search();
    }
};
]]></Script>
  </Form>
</FDL>
