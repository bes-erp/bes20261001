              <Static id="sta_margin_left00_00" taborder="8" text="10" left="cbo_message_type_cd:0" top="0" width="10" background="aqua" textAlign="center" visible="false" font="10px/normal &quot;Dotum&quot;,&quot;돋움&quot;,&quot;Noto Sans KR Medium&quot;,&quot;Noto Sans KR Light&quot;,&quot;Noto Sans KR ExtraLight&quot;,&quot;Noto Sans KR ExtraBold&quot;,&quot;Noto Sans KR DemiLight&quot;,&quot;Noto Sans KR Black&quot;,&quot;Noto Sans KR SemiBold&quot;,&quot;Noto Sans KR Thin&quot;" bottom="0"/>
              <Static id="sta_margin_left00_00_00" taborder="9" text="10" top="0" background="aqua" textAlign="center" visible="false" font="10px/normal &quot;Dotum&quot;,&quot;돋움&quot;,&quot;Noto Sans KR Medium&quot;,&quot;Noto Sans KR Light&quot;,&quot;Noto Sans KR ExtraLight&quot;,&quot;Noto Sans KR ExtraBold&quot;,&quot;Noto Sans KR DemiLight&quot;,&quot;Noto Sans KR Black&quot;,&quot;Noto Sans KR SemiBold&quot;,&quot;Noto Sans KR Thin&quot;" bottom="0" width="4" right="0"/>
              <Button id="btn_searchClear" taborder="11" top="10" height="24" tooltiptext="초기화" width="24" onclick="fn_searchClear" cssclass="btn_WF_searchClear" right="4"/>
              <Button id="btn_search" taborder="10" top="10" width="24" height="24" tooltiptext="조회" onclick="fn_search" right="btn_searchClear:2" cssclass="btn_WF_search"/>
            </Layout>
          </Layouts>
        </Div>
        <Div id="div_title" taborder="6" text="30" left="10" top="div_search:5" height="32" right="10" font="10px/normal &quot;Dotum&quot;,&quot;돋움&quot;,&quot;Noto Sans KR Medium&quot;,&quot;Noto Sans KR Light&quot;,&quot;Noto Sans KR ExtraLight&quot;,&quot;Noto Sans KR ExtraBold&quot;,&quot;Noto Sans KR DemiLight&quot;,&quot;Noto Sans KR Black&quot;,&quot;Noto Sans KR SemiBold&quot;,&quot;Noto Sans KR Thin&quot;">
          <Layouts>
            <Layout>
              <Button id="btn_favorite" taborder="1" left="0" top="2" width="24" height="24" cssclass="btn_WF_gridTitle"/>
              <Static id="sta_gridTitle" taborder="0" text="메시지 목록" left="btn_favorite:5" top="1" width="68" height="24" cssclass="font_WF_listTitle" font="bold 12px/normal &quot;Malgun Gothic&quot;,&quot;Noto Sans KR Black&quot;" fittocontents="width"/>
              <Button id="btn_delRow" taborder="3" top="4" width="24" height="24" tooltiptext="행삭제" right="4" onclick="fn_del_row" cssclass="btn_WF_delRow"/>
              <Button id="btn_addRow" taborder="2" top="4" width="24" height="24" tooltiptext="행추가" right="btn_delRow:2" onclick="fn_add_row" cssclass="btn_WF_addRow" text=""/>
              <Button id="btn_excel_down" taborder="4" top="4" width="24" height="24" tooltiptext="엑셀다운로드" right="btn_addRow:2" background="" onclick="fn_excel_down" cssclass="btn_WF_excelDown"/>
              <Static id="sta_titleCnt" taborder="5" text="| 1,000건" left="sta_gridTitle:1" top="1" width="70" height="24" cssclass="sta_WF_titleCnt" font="10px/normal &quot;Malgun Gothic&quot;,&quot;Noto Sans KR Black&quot;" fittocontents="width"/>
            </Layout>
          </Layouts>
        </Div>
        <Grid id="grd_message" left="10" top="div_title:0" right="10" bottom="10" taborder="7" binddataset="ds_message" selecttype="row" autoenter="select" autofittype="none" font="12px/normal &quot;Malgun Gothic&quot;,&quot;Noto Sans KR Black&quot;" onheadclick="grd_message_onheadclick" cssclass="font_WF_grid" oncelldblclick="grd_message_oncelldblclick">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="44"/>
                <Column size="42"/>
                <Column size="85"/>
                <Column size="85"/>
                <Column size="95"/>
                <Column size="300"/>
                <Column size="280"/>
                <Column size="250"/>
                <Column size="250"/>
                <Column size="250"/>
              </Columns>
              <Rows>
                <Row size="28" band="head"/>
                <Row size="28"/>
              </Rows>
              <Band id="head">
                <Cell text="No"/>
                <Cell col="1" text="0" edittype="checkbox" displaytype="checkboxcontrol" checkboxtruevalue="Y" checkboxfalsevalue="N"/>
                <Cell col="2" text="*메시지분류"/>
                <Cell col="3" text="*메시지유형"/>
                <Cell col="4" text="메시지번호"/>
                <Cell col="5" text="*메시지(한글)"/>
                <Cell col="6" text="메시지(영문)"/>
                <Cell col="7" text="메시지(중국)"/>
                <Cell col="8" text="메시지(일본)"/>
                <Cell col="9" text="메시지(기타)"/>
              </Band>
              <Band id="body">
                <Cell text="expr:currow+1" edittype="none" textAlign="center"/>
                <Cell col="1" text="bind:CHK" displaytype="checkboxcontrol" edittype="checkbox" textAlign="center" checkboxtruevalue="Y" checkboxfalsevalue="N"/>
                <Cell col="2" text="bind:MESSAGE_CLASS_CD" displaytype="expr:dataset.getRowType(currow)==2?'combocontrol':'combotext'" edittype="expr:dataset.getRowType(currow)==2?'combo':'none'" combodataset="ds_grd_message_class_cd" combocodecol="CODE" combodatacol="CODE_NM"/>
                <Cell col="3" text="bind:MESSAGE_TYPE_CD" displaytype="expr:dataset.getRowType(currow)==2?'combocontrol':'combotext'" edittype="expr:dataset.getRowType(currow)==2?'combo':'none'" combodataset="ds_grd_message_type_cd" combocodecol="CODE" combodatacol="CODE_NM"/>
                <Cell col="4" text="bind:MESSAGE_NUM" edittype="none" textAlign="center"/>
                <Cell col="5" text="bind:MESSAGE_TEXT_KO" edittype="text" textAlign="left"/>
                <Cell col="6" text="bind:MESSAGE_TEXT_EN" edittype="text" textAlign="left"/>
                <Cell col="7" text="bind:MESSAGE_TEXT_ZH" edittype="text" textAlign="left"/>
                <Cell col="8" text="bind:MESSAGE_TEXT_JA" edittype="text" textAlign="left"/>
                <Cell col="9" text="bind:MESSAGE_TEXT_OT" edittype="text" textAlign="left"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
        <Static id="sta_toast" taborder="8" width="140" height="24" visible="false" background="#FFFFFF" color="#334155" textAlign="center" verticalAlign="middle" font="10pt/normal &quot;Pretendard&quot;" border="1px solid #CBD5E1" left="260" top="95"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[/***************************************************************************************
 * 프로젝트        : Built1 Enterprise System 구축 프로젝트
 * 업무구분        : 공통관리
 * 파일명          : COM12000M.xfdl
 * 작성자          : Built1
 * 작성일          : 2026-11-05
 *
 * 화면            : 메시지등록
 * 설명            : 메시지 목록 조회 및 관리
 *---------------------------------------------------------------------------------------
 * 변경일            변경자            변경내역
 *---------------------------------------------------------------------------------------
 * 2026-11-05        Built1            화면 및 스크립트 작성
 * 2026-11-09        Built1            디자인 템플릿 적용
 * 2026-11-10        Built1            gfn_getCode 함수 매개변수 변경 및 스크립트 템플릿 적용
 * 2026-11-13        Built1            Dataset 컬럼명 대문자 통일 및 공통함수 적용   
 * 2026-11-16        Built1            gv_userid 삭제, 사용자 ID 서버 세션 조회로 변경
 * 2026-11-17        Built1            메시지번호 복사 기능 
 ***************************************************************************************/


/***************************************************************************************
 * 1. 폼 변수
 * : 폼에서 사용할 공통 변수를 선언
 **************************************************************************************/


/***************************************************************************************
 * 2. 폼 오픈
 * : 화면을 로딩시 기본적으로 처리할 기능 또는 초기값 할당
 **************************************************************************************/
/*
 * 기능 : 화면 초기화
 * : 조회조건 및 공통코드, 메시지 목록 초기화
 */
this.fn_init = function(obj:Form, e:nexacro.LoadEventInfo)
{
    // 조회조건 공통코드
    this.gfn_getCode(this, "ds_cbo_message_class_cd", "MESSAGE_CLASS_CD", "", "Y");  // 메시지 분류 (전체 포함)
    this.gfn_getCode(this, "ds_cbo_message_type_cd" , "MESSAGE_TYPE_CD" , "", "Y");  // 메시지 유형 (전체 포함)

    // 그리드 공통코드
    this.gfn_getCode(this, "ds_grd_message_class_cd", "MESSAGE_CLASS_CD", "", "S");   // 메시지 분류 (선택 포함)
    this.gfn_getCode(this, "ds_grd_message_type_cd" , "MESSAGE_TYPE_CD" , "", "S");  // 메시지 유형 (선택 포함)

    // 초기화
    this.div_search.form.edt_message_text_ko.set_value("");
    this.gfn_setRowCount(this.ds_message, this.div_title.form.sta_titleCnt);
	
	// 필수항목 * 붉은색 표기
	this.gfn_essential(this);
};


/***************************************************************************************
 * 3. 공통 버튼
 * : 조회, 조회초기화, 저장, 신규, 삭제, 도움말, 출력
 **************************************************************************************/
/*
 * 기능 : 조회
 * : 조회조건 항목별 값을 기준으로 데이터를 조회하는 기능
 */
this.fn_search = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
    // 조회조건 Dataset 초기화
    this.ds_search.clearData();

    var nRow = this.ds_search.addRow();

    // 조회조건 설정
    this.ds_search.setColumn(nRow, "MESSAGE_CLASS_CD", this.div_search.form.cbo_message_class_cd.value);
    this.ds_search.setColumn(nRow, "MESSAGE_TYPE_CD" , this.div_search.form.cbo_message_type_cd.value);
    this.ds_search.setColumn(nRow, "MESSAGE_TEXT_KO" , this.div_search.form.edt_message_text_ko.value);

    // Transaction 설정
    var sSvcID        = "selectMessageList";
    var sSvcURL       = "svcUrl::com/COM12000M/selectMessageList.do";
    var sInDatasets   = "inSearch=ds_search";
    var sOutDatasets  = "ds_message=outSelectMessageList";
    var sArgument     = ""; // 사용자 ID 는 서버 세션에서 조회
    var sCallbackFunc = "fn_callBack";

    // 메시지 목록 조회
    this.gfn_transaction(sSvcID, sSvcURL, sInDatasets, sOutDatasets, sArgument, sCallbackFunc);
};


/*
 * 기능 : 조회초기화
 * : 조회 조건의 항목별 값을 초기화하는 기능
 */
this.fn_searchClear = function(obj, e)
{
    this.gfn_searchClear(this.div_search);
};


/*
 * 기능 : 저장
 * : 신규, 수정, 삭제된 데이터를 저장하는 기능
 */
this.fn_save = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
    // 체크박스만 변경된 행의 상태 정리
    this.gfn_resetSelectionOnlyRows(this.ds_message);

    if (!this.gfn_dataSetChange(this.ds_message))
    {
        this.alert("변경된 데이터가 없습니다.");
        return;
    }

    // 필수 항목 검증
    if (!this.fn_validate()) return;
	
	var sSvcID        = "saveMessage";
    var sSvcURL       = "svcUrl::com/COM12000M/saveMessage.do";
    var sInDatasets   = "inMessage=ds_message:U";
    var sOutDatasets  = "";
    var sArgument     = ""; // 사용자 ID 는 서버 세션에서 조회
	var sCallbackFunc = "fn_callBack";

    this.gfn_transaction(sSvcID, sSvcURL, sInDatasets, sOutDatasets, sArgument, sCallbackFunc);
};

/***************************************************************************************
 * 4. 추가 공통 버튼
 * : 행추가, 행삭제, 엑셀다운로드, 엑셀업로드
 **************************************************************************************/
/*
 * 기능 : 행추가
 * : 그리드에 첫 행을 추가하는 기능
 */
this.fn_add_row = function(obj, e)
{
    this.gfn_addRow(this.grd_message, "MESSAGE_CLASS_CD");
	
    // 메시지 목록 건수 갱신
    this.gfn_setRowCount(this.ds_message, this.div_title.form.sta_titleCnt);
};


/*
 * 기능 : 행삭제
 * : 그리드에서 선택된 행을 삭제하는 기능
 */
this.fn_del_row = function(obj, e)
{
    this.gfn_delRow(this.grd_message);

    this.gfn_setRowCount(this.ds_message, this.div_title.form.sta_titleCnt);
};


/*
 * 기능 : 엑셀다운로드
 * : 그리드에 조회된 데이터를 엑셀로 다운로드하는 기능
 */
this.fn_excel_down = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
    // 엑셀다운로드 기능 추후 구현
    this.alert("엑셀다운로드 기능 연결 후 테스트할 예정입니다.");
};


/***************************************************************************************
 * 5. 콜백
 * : 데이터 조회, 저장, 삭제 등 트랜잭션 처리에 따른 결과를 관리하는 기능
 **************************************************************************************/
this.fn_callBack = function(sSvcID, nErrCd, sErrMsg)
{
    if (nErrCd < 0)
    {
        this.alert(sErrMsg);
        return;
    }

    switch (sSvcID)
    {
        // 메시지 목록 조회
        case "selectMessageList":

            this.gfn_setRowCount(this.ds_message, this.div_title.form.sta_titleCnt);

            // 조회 결과가 없는 경우
            if (this.ds_message.rowcount == 0)
            {
                this.alert("조회조건에 일치하는 데이터가 존재하지 않습니다.");
            }
            break;

        // 메시지 저장 (추후 서버 기능 연결)
        case "saveMessage":
            this.alert("정상적으로 저장되었습니다.");
            this.fn_search();
            break;
    }
};


/***************************************************************************************
 * 6. 팝업 호출 및 콜백
 * : 팝업화면 오픈 및 리턴된 결과를 콜백 처리하는 기능
 **************************************************************************************/


/***************************************************************************************
 * 7. 기타 함수
 * : 화면에 특화된 함수를 사용하기 위한 기능
 **************************************************************************************/
/*
 * 기능 : 필수 항목 검증
 * : 신규 및 수정된 행의 필수 입력값 확인
 */
this.fn_validate = function()
{
    var arrRequired = ["MESSAGE_CLASS_CD", "MESSAGE_TYPE_CD", "MESSAGE_TEXT_KO"];

    return this.gfn_gridCheckRequired(this.grd_message, arrRequired);
};


/***************************************************************************************
 * 8. 이벤트
 * : 화면에서 각 컴포넌트별 이벤트를 작성하는 기능
 **************************************************************************************/
/*
 * 기능 : 메시지 목록 전체 선택 / 해제
 * : 그리드 헤더 체크박스 클릭 시 전체 행 선택 상태 변경
 */
this.grd_message_onheadclick = function(obj, e)
{
    this.gfn_gridCheckAll(obj, e);
};

/*
 * 기능 : 메시지번호 복사
 * : 그리드 메시지번호 셀 더블클릭 시 클립보드에 복사
 */
this.grd_message_oncelldblclick = function(obj, e)
{
    // 메시지번호 컬럼 확인
    var nCell = obj.getBindCellIndex("body", "MESSAGE_NUM");

    if (e.row < 0 || e.cell != nCell) return;

    // 메시지번호 조회
    var sMessageNum = this.ds_message.getColumn(e.row, "MESSAGE_NUM");

    if (this.gfn_isNull(sMessageNum)) return;

    // 클립보드 복사
    system.setClipboard("CF_TEXT", sMessageNum);

     // 토스트 메시지 출력
    this.sta_toast.set_text("✓ 메시지번호 복사 완료");
	this.sta_toast.set_visible(true);
	this.sta_toast.bringToFront();

    // 자동 숨김
    this.killTimer(12000);
    this.setTimer(12000, 500);
};

/*
 * 기능 : 토스트 메시지 숨김
 * : 일정 시간 경과 후 토스트 메시지 자동 숨김
 */
this.COM12000M_ontimer = function(obj, e)
{
    if (e.timerid == 12000)
    {
        this.killTimer(12000);
        this.sta_toast.set_visible(false);
    }
};]]></Script>
    <Objects>
      <Dataset id="ds_search">
        <ColumnInfo>
          <Column id="MESSAGE_CLASS_CD" type="STRING" size="30"/>
          <Column id="MESSAGE_TYPE_CD" type="STRING" size="30"/>
          <Column id="MESSAGE_TEXT_KO" type="STRING" size="300"/>
        </ColumnInfo>
        <Rows>
          <Row/>
        </Rows>
      </Dataset>
      <Dataset id="ds_message">
        <ColumnInfo>
          <Column id="CHK" type="STRING" size="1"/>
          <Column id="MESSAGE_CLASS_CD" type="STRING" size="30"/>
          <Column id="MESSAGE_TYPE_CD" type="STRING" size="30"/>
          <Column id="MESSAGE_NUM" type="STRING" size="30"/>
          <Column id="MESSAGE_TEXT_KO" type="STRING" size="300"/>
          <Column id="MESSAGE_TEXT_EN" type="STRING" size="300"/>
          <Column id="MESSAGE_TEXT_ZH" type="STRING" size="300"/>
          <Column id="MESSAGE_TEXT_JA" type="STRING" size="300"/>
          <Column id="MESSAGE_TEXT_OT" type="STRING" size="300"/>
          <Column id="REMARK" type="STRING" size="4000"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_cbo_message_class_cd">
        <ColumnInfo>
          <Column id="CODE" type="STRING" size="30"/>
          <Column id="CODE_NM" type="STRING" size="100"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_cbo_message_type_cd">
        <ColumnInfo>
          <Column id="CODE" type="STRING" size="30"/>
          <Column id="CODE_NM" type="STRING" size="100"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_grd_message_class_cd">
        <ColumnInfo>
          <Column id="CODE" type="STRING" size="30"/>
          <Column id="CODE_NM" type="STRING" size="100"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_grd_message_type_cd">
        <ColumnInfo>
          <Column id="CODE" type="STRING" size="30"/>
          <Column id="CODE_NM" type="STRING" size="100"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
  </Form>
</FDL>
