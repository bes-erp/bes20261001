<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="COM12000M" width="1280" height="720" titletext="메시지등록" onload="COM12000M_onload">
    <Objects>
      <!-- 조회 조건: 설계서의 컬럼명 사용 -->
      <Dataset id="ds_search">
        <ColumnInfo>
          <Column id="message_class_cd" type="STRING" size="30"/>
          <Column id="message_type_cd" type="STRING" size="30"/>
          <Column id="message_text_ko" type="STRING" size="300"/>
        </ColumnInfo>
        <Rows>
          <Row/>
        </Rows>
      </Dataset>
      <!-- 목록: 실제 SYS_MESSAGE 컬럼 + UI 전용 컬럼 -->
      <Dataset id="ds_message">
        <ColumnInfo>
          <Column id="select_yn" type="STRING" size="1"/>
          <Column id="message_class_cd" type="STRING" size="30"/>
          <Column id="message_type_cd" type="STRING" size="30"/>
          <Column id="message_num" type="STRING" size="30"/>
          <Column id="message_text_ko" type="STRING" size="300"/>
          <Column id="message_text_en" type="STRING" size="300"/>
          <Column id="message_text_zh" type="STRING" size="300"/>
          <Column id="message_text_ja" type="STRING" size="300"/>
          <Column id="message_text_ot" type="STRING" size="300"/>
          <Column id="remark" type="STRING" size="4000"/>
        </ColumnInfo>
      </Dataset>
      <!-- 임시 공통코드: 추후 회사 공통코드 조회로 교체 가능 -->
      <Dataset id="ds_cbo_message_class_cd">
        <ColumnInfo>
          <Column id="code" type="STRING" size="30"/>
          <Column id="code_nm" type="STRING" size="100"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_cbo_message_type_cd">
        <ColumnInfo>
          <Column id="code" type="STRING" size="30"/>
          <Column id="code_nm" type="STRING" size="100"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_cbo_grid_message_class_cd" onrowsetchanged="ds_cbo_message_class_cd_onrowsetchanged">
        <ColumnInfo>
          <Column id="code" type="STRING" size="30"/>
          <Column id="code_nm" type="STRING" size="100"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_cbo_grid_message_type_cd">
        <ColumnInfo>
          <Column id="code" type="STRING" size="30"/>
          <Column id="code_nm" type="STRING" size="100"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
    <Script type="xscript5.1"><![CDATA[/***************************************************************************************
 * 프로젝트        : Built1 Enterprise System 구축 프로젝트
 * 업무구분        : 공통관리
 * 파일명          : COM12000M.xfdl
 * 화면            : 메시지등록
 * 설명            : 메시지 목록 조회 및 관리
 *---------------------------------------------------------------------------------------
 * 변경일            변경자            변경내역
 *---------------------------------------------------------------------------------------
 * 2026-11-05        Built1            화면 및 스크립트 재작성
 ***************************************************************************************/


/***************************************************************************************
 * 1. FORM 변수 선언
 ***************************************************************************************/


/***************************************************************************************
 * 2. FORM LOAD
 ***************************************************************************************/

/*
 * 기능 : 화면 초기화
 */
this.COM12000M_onload = function(obj:nexacro.Form, e:nexacro.LoadEventInfo)
{
    this.fn_init();

    // 메시지분류 공통코드 조회
    this.gfn_code(this, "cbo_message_class_cd", "ds_cbo_message_class_cd", "MESSAGE_CLASS_CD", "");
	
	this.ds_cbo_message_class_cd_onrowsetchanged = function(obj, e)
	{
		trace("### 메시지 분류 데이터 건수: " + obj.getRowCount());

		for (var i = 0; i < obj.getRowCount(); i++)
		{
			trace("code=" + obj.getColumn(i, "code")
				+ ", code_nm=" + obj.getColumn(i, "code_nm"));
		}
	};
};

/*
 * 기능 : 조회조건 및 메시지 목록 초기화
 */
this.fn_init = function()
{
    // 검색조건 Dataset 초기화
    this.ds_search.clearData();
    this.ds_search.addRow();

    // 조회조건 기본값 설정
    //this.cbo_message_class_cd.set_value("ALL");
    this.cbo_message_type_cd.set_value("ALL");
    this.edt_message_text_ko.set_value("");

    // 목록 초기화
    this.ds_message.clearData();
    this.fn_setMessageCount();

    // 서버 조회 기능 연결 후 최초 조회 사용
    // this.fn_search();
};


/***************************************************************************************
 * 3. 공통 버튼
 ***************************************************************************************/

/*
 * 기능 : 메시지 목록 조회
 */
this.fn_search = function()
{
    // 조회조건 Dataset 초기화
    this.ds_search.clearData();

    var nRow = this.ds_search.addRow();

    // 조회조건 설정
    this.ds_search.setColumn(nRow, "message_class_cd", this.cbo_message_class_cd.value);
    this.ds_search.setColumn(nRow, "message_type_cd" , this.cbo_message_type_cd.value);
    this.ds_search.setColumn(nRow, "message_text_ko", this.edt_message_text_ko.value);

    // 사용자 정보
    var sUserId = nexacro.getApplication().gvUserId;

    // Transaction 설정
    var sSvcID        = "selectMessageList";
    var sSvcURL       = "svcUrl::com/COM12000M/selectMessageList.do";
    var sInDatasets   = "inSearch=ds_search";
    var sOutDatasets  = "ds_message=outSelectMessageList";
    var sArgument     = "userId=" + nexacro.wrapQuote(sUserId || "");
    var sCallbackFunc = "fn_callback";

    // 메시지 목록 조회
    this.gfn_transaction(sSvcID, sSvcURL, sInDatasets, sOutDatasets, sArgument, sCallbackFunc);
};

/*
 * 기능 : 조회조건 초기화
 */
this.fn_reset = function()
{
    //this.cbo_message_class_cd.set_value("ALL");
    this.cbo_message_type_cd.set_value("ALL");
    this.edt_message_text_ko.set_value("");

    this.ds_search.clearData();
    this.ds_search.addRow();
};

/*
 * 기능 : 메시지 목록 건수 표시
 */
this.fn_setMessageCount = function()
{
    var nCnt = this.ds_message.rowcount;

    this.sta_message_count.set_text("(" + nCnt + "건)");
};

/*
 * 기능 : 메시지 목록 첫 번째 행 추가
 */
this.fn_addRow = function()
{
    var nRow = this.ds_message.insertRow(0);

    this.ds_message.setColumn(nRow, "select_yn"       , "0");
    this.ds_message.setColumn(nRow, "message_class_cd", "FM");
    this.ds_message.setColumn(nRow, "message_type_cd" , "A");

    this.ds_message.set_rowposition(nRow);

    this.fn_setMessageCount();
};

/*
 * 기능 : 선택된 메시지 행 삭제
 */
this.fn_deleteRow = function()
{
    var nDeleteCnt = 0;

    // 뒤쪽 행부터 삭제하여 행 번호 변경 방지
    for (var i = this.ds_message.rowcount - 1; i >= 0; i--)
    {
        var sSelectYn = this.ds_message.getColumn(i, "select_yn");

        if (sSelectYn == "1")
        {
            this.ds_message.deleteRow(i);
            nDeleteCnt++;
        }
    }

    if (nDeleteCnt == 0)
    {
        this.alert("삭제할 행을 선택해주세요.");
        return;
    }

    this.fn_setMessageCount();
};


/*
 * 기능 : 저장 전 필수 입력값 검사
 */
this.fn_validate = function()
{
    for (var i = 0; i < this.ds_message.rowcount; i++)
    {
        var nRowType = this.ds_message.getRowType(i);

        // 신규 및 수정된 행만 검사
        if (nRowType == 2 || nRowType == 4)
        {
            var sClassCd = this.ds_message.getColumn(i, "message_class_cd");
            var sTypeCd  = this.ds_message.getColumn(i, "message_type_cd");
            var sTextKo  = this.ds_message.getColumn(i, "message_text_ko");

            if (this.gfn_isNull(sClassCd))
            {
                this.alert("메시지분류는 필수 항목입니다.");
                this.ds_message.set_rowposition(i);
                return false;
            }

            if (this.gfn_isNull(sTypeCd))
            {
                this.alert("메시지유형은 필수 항목입니다.");
                this.ds_message.set_rowposition(i);
                return false;
            }

            if (this.gfn_isNull(sTextKo) || String(sTextKo).trim() == "")
            {
                this.alert("메시지(한글)는 필수 항목입니다.");
                this.ds_message.set_rowposition(i);
                return false;
            }
        }
    }

    return true;
};

/*
 * 기능 : 변경 데이터 존재 여부 확인
 */
this.fn_isChanged = function()
{
    if (this.ds_message.getDeletedRowCount() > 0)
    {
        return true;
    }

    for (var i = 0; i < this.ds_message.rowcount; i++)
    {
        var nRowType = this.ds_message.getRowType(i);

        if (nRowType == 2 || nRowType == 4)
        {
            return true;
        }
    }

    return false;
};

/*
 * 기능 : 메시지 저장
 */
this.fn_save = function()
{
    if (!this.fn_isChanged())
    {
        this.alert("변경된 데이터가 없습니다.");
        return;
    }

    if (!this.fn_validate())
    {
        return;
    }

    // DB 저장 Controller 및 트랜잭션 구현 전에는 호출하지 않음
    this.alert("저장 서버 기능 연결 후 테스트할 예정입니다.");
};


/***************************************************************************************
 * 4. TRANSACTION, CALLBACK
 ***************************************************************************************/

/*
 * 기능 : Transaction 결과 처리
 */
//콜백
this.fn_callback = function(sSvcID, nErrCd, sErrMsg)
{
    if(nErrCd < 0) {
        alert(sErrMsg);
        return;
    }

    switch(sSvcID) {

        //메시지 목록 조회
        case "selectMessageList":

            var nCnt = this.ds_message.rowcount;

            //조회 건수 표시
            this.fn_setMessageCount();

            if (nCnt == 0) {
                alert("조회조건에 일치하는 데이터가 존재하지 않습니다.");
                //this.gfn_msgBox('MSG-A-10030');
            }
            break;

        //메시지 저장 (추후 서버 기능 연결)
        case "saveMessage":

            alert("정상적으로 저장되었습니다.");

            //저장 후 재조회
            this.fn_search();
            break;
    }
};


/***************************************************************************************
 * 5. 팝업 호출 및 콜백
 ***************************************************************************************/


/***************************************************************************************
 * 6. 기타 함수
 ***************************************************************************************/


/***************************************************************************************
 * 7. 이벤트
 ***************************************************************************************/

]]></Script>
    <Layouts>
      <Layout width="1280" height="720" mobileorientation="landscape">
        <!-- 상단 저장 -->
        <Button id="btn_save" text="저장" right="20" top="12" width="76" height="28" taborder="0"/>
        <!-- 조회 조건 박스 -->
        <Static id="sta_search_bg" left="16" top="49" right="16" height="60" background="#E4E9F8" border="1px solid #CDD5E8" text=""/>
        <Static id="sta_message_class_cd" text="메시지분류" left="31" top="66" width="82" height="26" verticalAlign="middle"/>
        <Combo id="cbo_message_class_cd" left="114" top="65" width="150" height="28" taborder="1" innerdataset="ds_cbo_message_class_cd" codecolumn="code" datacolumn="code_nm" value="ALL" index="0"/>
        <Static id="sta_message_type_cd" text="메시지유형" left="294" top="66" width="81" height="26" verticalAlign="middle"/>
        <Combo id="cbo_message_type_cd" left="377" top="65" width="150" height="28" taborder="2" innerdataset="ds_cbo_message_type_cd" codecolumn="code" datacolumn="name" value="ALL" index="0"/>
        <Static id="sta_message_text_ko" text="메시지(한글)" left="557" top="66" width="98" height="26" verticalAlign="middle"/>
        <Edit id="edt_message_text_ko" left="655" top="65" width="244" height="28" taborder="3" maxlength="300"/>
        <Button id="btn_search" text="조회" right="105" top="65" width="70" height="28" taborder="4" onclick="fn_search"/>
        <Button id="btn_reset" text="초기화" right="27" top="65" width="70" height="28" taborder="5"/>
        <!-- 그리드 툴바 -->
        <Static id="sta_message_list" text="메시지 목록" left="10" top="122" width="78" height="27" font="bold 11pt Arial" textAlign="left"/>
        <Static id="sta_message_count" text="(0건)" left="88" top="122" width="65" height="27" verticalAlign="middle"/>
        <Button id="btn_excel" text="엑셀다운로드" right="201" top="119" width="115" height="28" taborder="6"/>
        <Button id="btn_add" text="행추가" right="111" top="119" width="83" height="28" taborder="7"/>
        <Button id="btn_delete" text="행삭제" right="20" top="119" width="83" height="28" taborder="8"/>
        <!-- 메시지 목록: 9개 컬럼(No, 선택, 분류, 유형, 번호, 5개 언어) -->
        <Grid id="grd_message" left="16" top="157" right="16" bottom="20" taborder="9" binddataset="ds_message" selecttype="row" autoenter="select" autofittype="none">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="44"/>
                <Column size="42"/>
                <Column size="85"/>
                <Column size="85"/>
                <Column size="95"/>
                <Column size="300"/>
                <Column size="280"/>
                <Column size="250"/>
                <Column size="250"/>
                <Column size="250"/>
              </Columns>
              <Rows>
                <Row size="32" band="head"/>
                <Row size="32"/>
              </Rows>
              <Band id="head">
                <Cell text="No"/>
                <Cell col="1" text="V"/>
                <Cell col="2" text="*메시지분류"/>
                <Cell col="3" text="*메시지유형"/>
                <Cell col="4" text="*메시지번호"/>
                <Cell col="5" text="*메시지(한글)"/>
                <Cell col="6" text="메시지(영문)"/>
                <Cell col="7" text="메시지(중국)"/>
                <Cell col="8" text="메시지(일본)"/>
                <Cell col="9" text="메시지(기타)"/>
              </Band>
              <Band id="body">
                <Cell text="expr:currow+1" edittype="none" textAlign="center"/>
                <Cell col="1" text="bind:select_yn" displaytype="checkboxcontrol" edittype="checkbox" textAlign="center"/>
                <Cell col="2" text="bind:message_class_cd" displaytype="combocontrol" edittype="combo" combodataset="ds_cbo_grid_message_class_cd" combocodecol="code" combodatacol="name"/>
                <Cell col="3" text="bind:message_type_cd" displaytype="combocontrol" edittype="combo" combodataset="ds_cbo_grid_message_type_cd" combocodecol="code" combodatacol="name"/>
                <Cell col="4" text="bind:message_num" edittype="none"/>
                <Cell col="5" text="bind:message_text_ko" edittype="text"/>
                <Cell col="6" text="bind:message_text_en" edittype="text"/>
                <Cell col="7" text="bind:message_text_zh" edittype="text"/>
                <Cell col="8" text="bind:message_text_ja" edittype="text"/>
                <Cell col="9" text="bind:message_text_ot" edittype="text"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
      </Layout>
    </Layouts>
  </Form>
</FDL>
