              <Button id="btn_pageTitle" taborder="1" left="0" top="2" width="24" height="24" onclick="nfn_searchOpen_onclick" cssclass="btn_WF_pageTitle"/>
              <Button id="btn_save" taborder="2" top="2" height="24" right="4" width="24" onclick="fn_save" tooltiptext="저장" background="" cssclass="btn_WF_save" text=""/>
            </Layout>
