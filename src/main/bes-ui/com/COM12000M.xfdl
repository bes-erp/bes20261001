              <Combo id="cbo_message_type_cd" left="sta_message_type_cd:5" top="sta_marginTop:0" width="150" height="24" taborder="3" innerdataset="ds_cbo_message_type_cd" codecolumn="CODE" datacolumn="CODE_NM" font="12px/normal &quot;Malgun Gothic&quot;,&quot;Noto Sans KR Black&quot;" cssclass="font_WF"/>
              <Static id="sta_message_text_ko" text="메시지(한글)" left="557" top="11" width="100" height="24" verticalAlign="middle" taborder="4" textAlign="right" cssclass="font_WF"/>
