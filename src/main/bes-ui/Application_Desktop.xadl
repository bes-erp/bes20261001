<?xml version="1.0" encoding="utf-8"?>
<ADL version="2.0">
  <Application id="Application_Desktop" screenid="Desktop_screen">
    <Layout>
      <MainFrame id="mainframe" showtitlebar="true" showstatusbar="true" left="0" top="0" width="1280" height="720" titletext="Built1 Enterprise System">
        <VFrameSet id="VFrameSetMain" separatesize="*,0">
          <Frames>
            <!-- 로그인 화면 -->
            <ChildFrame id="LoginFrame" showtitlebar="false" showstatusbar="false" formurl="Sys::SYS10000M.xfdl" dragmovetype="none"/>
            <!-- 로그인 성공 후 표시할 메인 화면 -->
            <HFrameSet id="HFrameSet00" separatesize="200,*">
              <Frames>
                <ChildFrame id="LeftFrame" showtitlebar="false" showstatusbar="false" formurl="FrameBase::Form_Left.xfdl" dragmovetype="none"/>
                <VFrameSet id="VFrameSet00" separatesize="50,*">
                  <Frames>
                    <ChildFrame id="TopFrame" showtitlebar="false" showstatusbar="false" formurl="FrameBase::Form_Top.xfdl" dragmovetype="none"/>
                    <ChildFrame id="WorkFrame" showtitlebar="false" showstatusbar="false" formurl="FrameBase::Form_Work.xfdl" dragmovetype="none"/>
                  </Frames>
                </VFrameSet>
              </Frames>
            </HFrameSet>
          </Frames>
        </VFrameSet>
      </MainFrame>
    </Layout>
  </Application>
</ADL>
