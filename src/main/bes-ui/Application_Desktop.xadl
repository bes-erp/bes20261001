<?xml version="1.0" encoding="utf-8"?>
<ADL version="2.0">
  <Application id="Application_Desktop" screenid="Desktop_screen">
    <Layout>
      <!-- BES 최상위 메인 프레임 -->
      <MainFrame id="mainframe" showtitlebar="true" showstatusbar="true" left="0" top="0" width="1280" height="720" titletext="Built1 Enterprise System">
        <!-- 로그인 영역과 업무 영역 구분 -->
        <VFrameSet id="VFrameSetMain" separatesize="*,0" border="0px none">
          <Frames>
            <!-- 로그인 화면 -->
            <ChildFrame id="LoginFrame" showtitlebar="false" showstatusbar="false" formurl="sys::SYS10000M.xfdl" dragmovetype="none"/>
            <!-- 로그인 후 메인 업무 영역 -->
            <VFrameSet id="VFrameSetWork" separatesize="50,42,*" border="0px none">
              <Frames>
                <!-- 시스템 로고 및 사용자 정보 -->
                <ChildFrame id="TopFrame" showtitlebar="false" showstatusbar="false" border="0px none" formurl="besframebase::Form_Top.xfdl" dragmovetype="none"/>
                <!-- 상단 대분류 메뉴 -->
                <ChildFrame id="MenuFrame" showtitlebar="false" showstatusbar="false" border="0px none" formurl="besframebase::Form_Menu.xfdl" dragmovetype="none"/>
                <!-- 좌측 메뉴 및 업무 영역 -->
                <HFrameSet id="HFrameSetWork" separatesize="200,*" border="0px none">
                  <Frames>
                    <!-- 2·3레벨 좌측 메뉴 -->
                    <ChildFrame id="LeftFrame" showtitlebar="false" showstatusbar="false" border="0px none" formurl="besframebase::Form_Left.xfdl" dragmovetype="none"/>
                    <!-- IFC의 VFrameSet0에 대응 -->
                    <VFrameSet id="VFrameSetContent" separatesize="30,*,0" border="0px none">
                      <Frames>
                        <!-- 업무 탭 영역 -->
                        <ChildFrame id="MdiFrame" showtitlebar="false" showstatusbar="false" border="0px none" formurl="besframebase::Form_Mdi.xfdl" dragmovetype="none"/>
                        <!-- 기존 기본 홈 화면 -->
                        <ChildFrame id="WorkFrame" showtitlebar="false" showstatusbar="false" border="0px none" formurl="besframebase::Form_Work.xfdl" dragmovetype="none"/>
                        <!-- 업무별 ChildFrame을 동적으로 생성할 영역 -->
                        <FrameSet id="FrameSetWork" border="0px none"/>
                      </Frames>
                    </VFrameSet>
                  </Frames>
                </HFrameSet>
              </Frames>
            </VFrameSet>
          </Frames>
        </VFrameSet>
      </MainFrame>
    </Layout>
  </Application>
</ADL>
