<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="SYS10000M" width="1280" height="720" titletext="로그인" onload="SYS10000M_onload" onsize="SYS10000M_onsize">
    <Objects>
      <Dataset id="ds_loginResult">
        <ColumnInfo>
          <Column id="RESULT_CD" type="STRING" size="10"/>
          <Column id="RESULT_DESCR" type="STRING" size="4000"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
    <Script type="xscript5.1"><![CDATA[/***************************************************************************************
 * 프로젝트        : Built1 Enterprise System 구축 프로젝트
 * 업무구분        : 시스템관리
 * 파일명          : SYS10000M.xfdl
 * 작성자          : Built1
 * 작성일          : 2026-11-02
 *
 * 화면            : 로그인
 * 설명            : 사용자 로그인 및 개인의 세션정보 등록
 *---------------------------------------------------------------------------------------
 * 변경일            변경자            변경내역
 *---------------------------------------------------------------------------------------
 * 2026-11-02        Built1            최초작성
 ***************************************************************************************/


/***************************************************************************************
 * 1. FORM 변수 선언
 ***************************************************************************************/


/***************************************************************************************
 * 2. FORM LOAD
 ***************************************************************************************/

/*
 * 기능 : 화면 초기화
 */
this.fn_init = function(obj, e)
{
    this.fn_centerLogin();
    this.div_login.form.edt_userId.setFocus();
};


/***************************************************************************************
 * 3. 공통 버튼
 ***************************************************************************************/

/*
 * 기능 : 로그인 처리
 */
this.fn_login = function()
{
    var sUserId = this.div_login.form.edt_userId.value;
    var sPassword = this.div_login.form.edt_password.value;

    // 아이디 필수값 확인
    if (this.fn_isEmpty(sUserId))
    {
        this.alert("아이디를 입력해 주세요.");
        this.div_login.form.edt_userId.setFocus();
        return;
    }
 
    // 비밀번호 필수값 확인
    if (this.fn_isEmpty(sPassword))
    {
        this.alert("비밀번호를 입력해 주세요.");
        this.div_login.form.edt_password.setFocus();
        return;
    }

    // 로그인 요청 Dataset 생성
    if (!this.objects["ds_login"])
    {
        var dsLogin = new Dataset("ds_login", this);

        dsLogin.addColumn("USER_ID", "STRING", 30);
        dsLogin.addColumn("PASSWORD", "STRING", 512);

        this.addChild("ds_login", dsLogin);
    }

    // 로그인 요청 데이터 설정
    this.ds_login.clearData();

    var nRow = this.ds_login.addRow();

    this.ds_login.setColumn(nRow, "USER_ID", sUserId);
    this.ds_login.setColumn(nRow, "PASSWORD", sPassword);

    // 로그인 Transaction 설정
    var sSvcId = "login";
    var sSvcURL = "svcUrl::sys/SYS10000M/login.do";
    var sInData = "dsLogin=ds_login";
    var sOutData = "ds_loginResult=outLogin";
    var sArgument = "";
    var sCallback = "fn_callBack";

    // 로그인 요청
    this.transaction(
        sSvcId,
        sSvcURL,
        sInData,
        sOutData,
        sArgument,
        sCallback
    );
};


/***************************************************************************************
 * 4. TRANSACTION, CALLBACK
 ***************************************************************************************/

/*
 * 기능 : 로그인 Transaction 결과 처리
 */
this.fn_callBack = function(sSvcId, nErrorCode, sErrorMsg)
{
    if (sSvcId != "login")
    {
        return;
    }

    // 로그인 요청 데이터 삭제
    if (this.ds_login)
    {
        this.ds_login.clearData();
    }

    // 비밀번호 입력값 삭제
    this.div_login.form.edt_password.set_value("");

    // Transaction 오류 확인
    if (nErrorCode != 0)
    {
        this.alert("로그인 요청 오류: " + sErrorMsg);
        return;
    }

    // 로그인 결과 데이터 확인
    if (!this.ds_loginResult ||
        this.ds_loginResult.rowcount == 0)
    {
        this.alert("로그인 결과가 없습니다.");
        return;
    }

    var sResultCd = this.ds_loginResult.getColumn(0, "RESULT_CD");
    var sResultMsg = this.ds_loginResult.getColumn(0, "RESULT_DESCR");

    // 로그인 성공
    if (sResultCd == "S")
    {
        this.alert("로그인에 성공했습니다.");

        // 업무 화면 이동
        this.fn_goMain();
    }
    else
    {
        // 로그인 실패 메시지
        this.alert(sResultMsg || "로그인에 실패했습니다.");
        this.div_login.form.edt_password.setFocus();
    }
};


/***************************************************************************************
 * 5. 팝업 호출 및 콜백
 ***************************************************************************************/


/***************************************************************************************
 * 6. 기타 함수
 ***************************************************************************************/

/*
 * 기능 : 로그인 화면 중앙 정렬
 */
this.fn_centerLogin = function()
{
    // Form 크기
    var nFormWidth = this.getOffsetWidth();
    var nFormHeight = this.getOffsetHeight();

    // 로그인 영역 크기
    var nLoginWidth = this.div_login.getOffsetWidth();
    var nLoginHeight = this.div_login.getOffsetHeight();

    // 저작권 문구 포함 높이
    var nGap = 20;
    var nCopyrightHeight = this.sta_copyright.getOffsetHeight();

    var nTotalHeight = nLoginHeight + nGap + nCopyrightHeight;

    // 중앙 위치 계산
    var nLeft = Math.max(
        0,
        Math.floor((nFormWidth - nLoginWidth) / 2)
    );

    var nTop = Math.max(
        0,
        Math.floor((nFormHeight - nTotalHeight) / 2)
    );

    // 로그인 영역 이동
    this.div_login.move(nLeft, nTop);

    // 저작권 문구 이동
    this.sta_copyright.move(
        nLeft,
        nTop + nLoginHeight + nGap
    );
};

/*
 * 기능 : 공백 및 NULL 확인
 */
this.fn_isEmpty = function(value)
{
    if (value === null || value === undefined)
    {
        return true;
    }

    return String(value).trim().length === 0;
};

/*
 * 기능 : 로그인 성공 후 업무 화면 이동
 */
this.fn_goMain = function()
{
    var objFrame = this.getOwnerFrame();

    // 현재 Frame의 화면 변경
    objFrame.set_formurl("FrameBase/Form_Work.xfdl");
};


/***************************************************************************************
 * 7. 이벤트
 ***************************************************************************************/

/*
 * 기능 : 화면 로딩 이벤트
 */
this.SYS10000M_onload = function(obj, e)
{
    this.fn_init(obj, e);
};

/*
 * 기능 : 화면 크기 변경 이벤트
 */
this.SYS10000M_onsize = function(obj, e)
{
    this.fn_centerLogin();
};

/*
 * 기능 : 로그인 버튼 클릭 이벤트
 */
this.btn_login_onclick = function(obj, e)
{
    this.fn_login();
};

/*
 * 기능 : 비밀번호 입력 후 Enter 키 이벤트
 */
this.edt_password_onkeydown = function(obj, e)
{
    if (e.keycode == 13)
    {
        this.fn_login();
    }
};]]></Script>
    <Layouts>
      <Layout height="720" width="1280">
        <Div id="div_login" taborder="0" left="400" top="125" width="480" height="470" background="#FFFFFF" border="1px solid #DDE3EC" borderRadius="12px">
          <Layouts>
            <Layout width="480" height="470">
              <Static id="sta_title" taborder="0" left="40" top="45" width="400" height="50" text="BES" font="bold 32px Arial" color="#234E91" textAlign="center"/>
              <Static id="sta_subTitle" taborder="1" left="40" top="96" width="400" height="24" text="Built1 Enterprise System" font="13px Arial" color="#7B8794" textAlign="center"/>
              <Static id="sta_id" taborder="2" left="65" top="155" width="350" height="25" text="아이디" font="bold 13px Arial" color="#344054"/>
              <Edit id="edt_userId" taborder="3" left="65" top="185" width="350" height="42" displaynulltext="아이디를 입력하세요" font="14px Arial" border="1px solid #CED4DA" borderRadius="5px"/>
              <Static id="sta_pw" taborder="4" left="65" top="245" width="350" height="25" text="비밀번호" font="bold 13px Arial" color="#344054"/>
              <Edit id="edt_password" taborder="5" left="65" top="275" width="350" height="42" password="true" displaynulltext="비밀번호를 입력하세요" font="14px Arial" border="1px solid #CED4DA" borderRadius="5px" onkeydown="edt_password_onkeydown"/>
              <CheckBox id="chk_saveId" taborder="6" left="65" top="330" width="150" height="25" text="아이디 저장" font="12px Arial" color="#667085"/>
              <Button id="btn_login" taborder="7" left="65" top="380" width="350" height="48" text="로그인" font="bold 16px Arial" color="#FFFFFF" background="#2454A6" border="0px none" borderRadius="5px" onclick="btn_login_onclick"/>
            </Layout>
          </Layouts>
        </Div>
        <Static id="sta_copyright" taborder="1" left="400" top="615" width="480" height="30" text="© BES. All rights reserved." color="#98A2B3" font="12px Arial" textAlign="center"/>
      </Layout>
    </Layouts>
  </Form>
</FDL>
