              <Button id="btn_delRow" taborder="3" top="2" width="34" height="28" tooltiptext="행삭제" right="4" icon="url('theme://bes_icon/16/bes_icon_delrow_navy.png')" onclick="fn_del_row" cssclass="btn_WF_delRow"/>
              <Button id="btn_addRow" taborder="2" top="2" width="34" height="28" tooltiptext="행추가" right="btn_delRow:2" onclick="fn_add_row" icon="url('theme://bes_icon/16/bes_icon_addrow_navy.png')" cssclass="btn_WF_addRow"/>
              <Button id="btn_excel_down" taborder="4" top="2" width="34" height="28" tooltiptext="엑셀다운로드" right="btn_addRow:2" icon="url('theme://bes_icon/16/bes_icon_exceldown_navy.png')" background="" onclick="fn_excel_down" cssclass="btn_WF_excelDown"/>
              <Static id="sta_titleCnt" taborder="5" text="| 1,000건" left="sta_title:1" top="1" width="70" height="24" cssclass="sta_WF_titleCnt" font="10px/normal &quot;Malgun Gothic&quot;,&quot;Noto Sans KR Black&quot;" fittocontents="width"/>
            </Layout>
          </Layouts>
        </Div>
        <Grid id="grd_message" left="10" top="div_title:0" right="10" bottom="10" taborder="7" binddataset="ds_message" selecttype="row" autoenter="select" autofittype="none" font="12px/normal &quot;Malgun Gothic&quot;,&quot;Noto Sans KR Black&quot;" oncellclick="fn_grd_oncellclick">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="44"/>
                <Column size="42"/>
                <Column size="85"/>
                <Column size="85"/>
                <Column size="95"/>
                <Column size="300"/>
                <Column size="280"/>
                <Column size="250"/>
                <Column size="250"/>
                <Column size="250"/>
              </Columns>
              <Rows>
                <Row size="28" band="head"/>
                <Row size="28"/>
              </Rows>
              <Band id="head">
                <Cell text="No" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
                <Cell col="1" text="V" edittype="checkbox" displaytype="checkboxcontrol"/>
                <Cell col="2" text="*메시지분류" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
                <Cell col="3" text="*메시지유형" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
                <Cell col="4" text="*메시지번호" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
                <Cell col="5" text="*메시지(한글)" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
                <Cell col="6" text="메시지(영문)" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
                <Cell col="7" text="메시지(중국)" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
                <Cell col="8" text="메시지(일본)" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
                <Cell col="9" text="메시지(기타)" font="bold 11px/1.1 &quot;Malgun Gothic&quot;,&quot;맑은 고딕&quot;,&quot;Arial&quot;"/>
              </Band>
              <Band id="body">
                <Cell text="expr:currow+1" edittype="none" textAlign="center"/>
                <Cell col="1" text="bind:SELECT_YN" displaytype="checkboxcontrol" edittype="checkbox" textAlign="center"/>
                <Cell col="2" text="bind:MESSAGE_CLASS_CD" displaytype="combocontrol" edittype="combo" combodataset="ds_grd_message_class_cd" combocodecol="CODE" combodatacol="CODE_NM"/>
                <Cell col="3" text="bind:MESSAGE_TYPE_CD" displaytype="combocontrol" edittype="combo" combodataset="ds_grd_message_type_cd" combocodecol="CODE" combodatacol="CODE_NM"/>
                <Cell col="4" text="bind:MESSAGE_NUM" edittype="none"/>
                <Cell col="5" text="bind:MESSAGE_TEXT_KO" edittype="text"/>
                <Cell col="6" text="bind:MESSAGE_TEXT_EN" edittype="text"/>
                <Cell col="7" text="bind:MESSAGE_TEXT_ZH" edittype="text"/>
                <Cell col="8" text="bind:MESSAGE_TEXT_JA" edittype="text"/>
                <Cell col="9" text="bind:MESSAGE_TEXT_OT" edittype="text"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
        <Button id="btn_search" taborder="8" top="16" width="34" height="28" tooltiptext="조회" onclick="fn_search" right="73" cssclass="btn_WF_favorite"/>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="ds_search">
        <ColumnInfo>
          <Column id="MESSAGE_CLASS_CD" type="STRING" size="256"/>
          <Column id="MESSAGE_TYPE_CD" type="STRING" size="256"/>
          <Column id="MESSAGE_TEXT_KO" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_cbo_message_class_cd">
        <ColumnInfo>
          <Column id="CODE" type="STRING" size="256"/>
          <Column id="CODE_NM" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_cbo_message_type_cd">
        <ColumnInfo>
          <Column id="CODE" type="STRING" size="256"/>
          <Column id="CODE_NM" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_grd_message_class_cd">
        <ColumnInfo>
          <Column id="CODE" type="STRING" size="256"/>
          <Column id="CODE_NM" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_grd_message_type_cd">
        <ColumnInfo>
          <Column id="CODE" type="STRING" size="256"/>
          <Column id="CODE_NM" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_message">
        <ColumnInfo>
          <Column id="SELECT_YN" type="STRING" size="256"/>
          <Column id="MESSAGE_CLASS_CD" type="STRING" size="256"/>
          <Column id="MESSAGE_TYPE_CD" type="STRING" size="256"/>
          <Column id="MESSAGE_NUM" type="STRING" size="256"/>
          <Column id="MESSAGE_TEXT_KO" type="STRING" size="256"/>
          <Column id="MESSAGE_TEXT_EN" type="STRING" size="256"/>
          <Column id="MESSAGE_TEXT_ZH" type="STRING" size="256"/>
          <Column id="MESSAGE_TEXT_JA" type="STRING" size="256"/>
          <Column id="MESSAGE_TEXT_OT" type="STRING" size="256"/>
          <Column id="REMARK" type="STRING" size="256"/>
          <Column id="CREATE_DATE" type="STRING" size="256"/>
          <Column id="CREATE_BY" type="STRING" size="256"/>
          <Column id="UPDATE_DATE" type="STRING" size="256"/>
          <Column id="UPDATE_BY" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
    <Script type="xscript5.1"><![CDATA[/***************************************************************************************
 * 프로젝트        : Built1 Enterprise System 구축 프로젝트
 * 업무구분        : 시스템관리
 * 파일명          : TPL10000M.xfdl
 * 작성자          : Built1
 * 작성일          : 2026-11-01
 *
 * 화면            : 메시지등록
 * 설명            : 애플리케이션에서 공통적으로 사용할 메지를 등록하고 관리하는 기능
 *---------------------------------------------------------------------------------------
 * 변경일            변경자            변경내역
 *---------------------------------------------------------------------------------------
 * 2026-11-01        Built1            최초작성
 * 2026-11-10        Built1            gfn_getCode 항수 매개변수 변경
 ***************************************************************************************/


/***************************************************************************************
 * 1. 폼 변수
 * : 폼에서 사용할 공통 변수를 선언
 **************************************************************************************/


/***************************************************************************************
 * 2. 폼 오픈
 * : 화면을 로딩시 기본적으로 처리할 기능 또는 초기값 할당
 **************************************************************************************/
this.fn_init = function (obj:Form, e:nexacro.LoadEventInfo)
{
	// 조회조건
    this.gfn_getCode(this, "ds_cbo_message_class_cd", "MESSAGE_CLASS_CD", "", "Y");		// 메시지분류(전체포함)
	this.gfn_getCode(this, "ds_cbo_message_type_cd" , "MESSAGE_TYPE_CD" , "", "Y");		// 메시지유형(전체포함)
	
	// 그리드
    this.gfn_getCode(this, "ds_grd_message_class_cd", "MESSAGE_CLASS_CD", "", "S"); 		// 메시지분류(선택포함)
	this.gfn_getCode(this, "ds_grd_message_type_cd" , "MESSAGE_TYPE_CD" , "", "S"); 		// 메시지유형(선택포함)
	
	// 조회조건 초기화
	this.fn_searchClear();
	
	// 필수항목 * 붉은색 표기
	this.gfn_essential(this);
};


/***************************************************************************************
 * 3. 공통 버튼
 * : 조회, 조회초기화, 저장, 신규, 삭제, 도움말, 출력 
 **************************************************************************************/
/*
 * 기능 : 조회
 * : 조회조건 항목별 값을 기준으로 데이터를 조회하는 기능
 */
this.fn_search = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{

};


/*
 * 기능 : 조회초기화
 * : 조회 조건의 항목별 값을 초기화하는 기능
 */
this.fn_searchClear = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
    // 조회조건 기본값 설정
    this.gfn_searchClear(this.div_search);
};


/*
 * 기능 : 저장
 * : 신규, 수정, 삭제된 데이터를 저장하는 기능
 */
this.fn_save = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{

};


/*
 * 기능 : 신규
 * : 폼 입력화면에서 데이터를 신규로 등록하는 기능
 */
this.fn_new = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{

};


/*
 * 기능 : 삭제
 * : 폼 입력화면에서 데이터를 삭제하는 기능
 */
this.fn_delelete = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{

};


/*
 * 기능 : 도움말
 * : 화면에 대한 상세기능 및 절차를 설명하는 기능
 */
this.fn_help = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{

};


/*
 * 기능 : 출력
 * : 보고서를 출력하는 기능
 */
this.fn_print = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{

};


/***************************************************************************************
 * 4. 추가 공통 버튼
 * - 행추가, 행삭제, 엑셀다운로드, 엑셀업로드
 **************************************************************************************/
/*
 * 기능 : 행추가
 * : 그리드에 첫 행을 추가하는 기능
 */
this.fn_add_row = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	this.gfn_addRow(this.grd_message, "MESSAGE_CLASS_CD");   // 메시지(한글) 포커스
};


/*
 * 기능 : 행삭제
 * : 그리드에서 선택된 행을 삭제하는 기능
 */
this.fn_del_row = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{

};


/*
 * 기능 : 엑셀다운로드
 * : 그리드에 조회된 데이터를 엑셀로 다운로드하는 기능
 */
this.fn_excel_down = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{

};


/*
 * 기능 : 엑셀업로드
 * : 엑셀로 작성된 데이터를 그리드에 업로드하는 기능
 */
this.fn_excel_up = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{

};


/***************************************************************************************
 * 5. 콜백
 * : 데이터 조회, 저장, 삭제 등 트랜잭션 처리에 따른 결과를 관리하는 기능
 **************************************************************************************/
this.fn_callBack = function (sSvcID, nErrCd, sErrMsg)
{
	if(nErrCd < 0) 
	{
		alert(sErrMsg);
		return;
	}

	switch(sSvcID) 
	{	
		// 코드조회 : 수정바랍니다.
		case "selectCodeList":
			break;
	}
};


/***************************************************************************************
 * 6. 팝업 호출 및 콜백
 * : 팝업화면 오픈 및 리턴된 결과를 콜백 처리하는 기능
 **************************************************************************************/


/***************************************************************************************
 * 7. 기타 함수
