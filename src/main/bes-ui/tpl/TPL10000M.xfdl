/***************************************************************************************
 * 8. 이벤트
 * : 화면에서 각 컴포런트별 이벤트를 작성하는 기능
 **************************************************************************************/
 
/*
 * 기능 : 그리드 에디팅 상태에서 콤보박스 한번에 편집
 * : Grid oncellclick 이벤트에 적용
 */
this.fn_grd_oncellclick = function(obj:nexacro.Grid,e:nexacro.GridClickEventInfo)
{
	this.gfn_gridComboDropdown(obj, e);
};
