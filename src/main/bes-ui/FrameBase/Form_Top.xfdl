<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Form_Top" width="1080" height="50" titletext="공통 상단 영역" background="#FFFFFF" scrollbartype="none" onload="Form_Top_onload">
    <Layouts>
      <Layout width="1080" height="50" screenid="Desktop_screen">
        <Static id="sta_Brand" taborder="0" text="BES" left="20" top="0" width="44" height="49" color="#24436D" font="bold 22px Arial" cursor="pointer" onclick="sta_Brand_onclick"/>
        <Static id="sta_SystemName" taborder="1" text="Built1 Enterprise System" left="84" top="0" width="260" height="49" color="#41556F" font="12px Arial"/>
        <Static id="sta_UserName" taborder="2" text="" right="187" top="0" width="175" height="49" textAlign="right" color="#52647A" font="12px Arial"/>
        <Button id="btn_changePw" taborder="3" text="패스워드 변경" right="92" top="0" width="90" height="49" font="12px Arial" color="#3478C0" background="transparent" border="0px none" cursor="pointer" onclick="btn_changePw_onclick"/>
        <Static id="sta_Separator" taborder="4" text="|" right="84" top="0" width="8" height="49" textAlign="center" color="#B8C2CF" font="12px Arial"/>
        <Button id="btn_logout" taborder="5" text="로그아웃" right="14" top="0" width="70" height="49" font="12px Arial" color="#3478C0" background="transparent" border="0px none" cursor="pointer" onclick="btn_logout_onclick"/>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[/***************************************************************************************
 * 프로젝트        : Built1 Enterprise System 구축 프로젝트
 * 업무구분        : 공통 프레임
 * 파일명          : Form_Top.xfdl
 * 작성자          : Built1
 * 작성일          : 2026-11-03
 *
 * 화면            : BES 공통 상단 영역
 * 설명            : 시스템명, 사용자 환영 문구, 패스워드 변경 및 로그아웃
 *---------------------------------------------------------------------------------------
 * 변경일            변경자            변경내역
 *---------------------------------------------------------------------------------------
 * 2026-11-03        Built1            공통 상단 화면 구성
 * 2026-11-04        Built1            상단 디자인 및 사용자 환영 문구 개선
 * 2026-11-04        Built1            패스워드 변경 버튼 추가
 ***************************************************************************************/


/***************************************************************************************
 * 1. FORM 변수 선언
 ***************************************************************************************/


/***************************************************************************************
 * 2. FORM LOAD
 ***************************************************************************************/

/*
 * 기능 : 상단 로그인 사용자 정보 표시
 */
this.Form_Top_onload = function(obj, e)
{
    var objApp = nexacro.getApplication();

    // 로그인 사용자 환영 문구 표시
    this.sta_UserName.set_text(objApp.gvUserId ? objApp.gvUserId + "님 환영합니다." : "");
};


/***************************************************************************************
 * 3. 공통 버튼
 ***************************************************************************************/


/***************************************************************************************
 * 4. TRANSACTION, CALLBACK
 ***************************************************************************************/


/***************************************************************************************
 * 5. 팝업 호출 및 콜백
 ***************************************************************************************/


/***************************************************************************************
 * 6. 기타 함수
 ***************************************************************************************/

/*
 * 기능 : 로그아웃 처리 및 로그인 화면 이동
 */
this.fn_logout = function()
{
    var objApp      = nexacro.getApplication();
    var objFrameSet = objApp.mainframe.VFrameSetMain;

    if (!objFrameSet)
    {
        this.alert("메인 프레임을 찾을 수 없습니다.");
        return;
    }

    // 로그인 화면 정보 복원
    var objLoginFrame = objFrameSet.LoginFrame;

    if (objLoginFrame && objLoginFrame.form && objLoginFrame.form.fn_resetLogin)
    {
        objLoginFrame.form.fn_resetLogin();
    }

    // 로그인 사용자 정보 초기화
    objApp.gvUserId = "";
    this.sta_UserName.set_text("");

    // 로그인 화면 표시
    objFrameSet.set_separatesize("*,0");

    this.alert("로그아웃 되었습니다.");
};


/***************************************************************************************
 * 7. 이벤트
 ***************************************************************************************/

/*
 * 기능 : 로그아웃 버튼 클릭
 */
this.btn_logout_onclick = function(obj, e)
{
    this.fn_logout();
};


/*
 * 기능 : 패스워드 변경 버튼 클릭
 */
this.btn_changePw_onclick = function(obj, e)
{
    this.alert("패스워드 변경 기능 개발 예정");
};


/*
 * 기능 : BES 로고 클릭 시 초기 업무 화면으로 이동
 */
this.sta_Brand_onclick = function(obj, e)
{
    var objApp = nexacro.getApplication();

    // 메인 화면 WorkFrame 접근
    var objWorkFrame = objApp.mainframe.VFrameSetMain.VFrameSet00.HFrameSet00.WorkFrame;

    if (!objWorkFrame)
    {
        this.alert("WorkFrame을 찾을 수 없습니다.");
        return;
    }

    // 초기 업무 화면으로 변경
    objWorkFrame.set_formurl("FrameBase::Form_Work.xfdl");
};
]]></Script>
  </Form>
</FDL>
