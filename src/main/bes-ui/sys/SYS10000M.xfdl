              <Static id="sta_title" taborder="2" left="50" top="90" width="326" height="55" text="BES" textAlign="center" cssclass="besLoginTitle"/>
              <Static id="sta_loginTitle" taborder="3" left="50" top="160" width="326" height="28" text="로그인" textAlign="center" cssclass="besLoginSubtitle"/>
              <Static id="sta_subTitle" taborder="4" left="35" top="203" width="356" height="22" text="로그인 후 시스템을 이용하실 수 있습니다." textAlign="center" cssclass="besLoginSubtitle"/>
              <Edit id="edt_userId" taborder="5" left="50" top="240" width="241" height="32" displaynulltext="아이디" cssclass="besLoginEdit"/>
              <Edit id="edt_password" taborder="6" left="50" top="282" width="241" height="32" password="true" displaynulltext="비밀번호" cssclass="besLoginEdit" onkeydown="edt_password_onkeydown"/>
              <Button id="btn_login" taborder="7" left="296" top="240" width="80" height="74" text="로그인" cssclass="besLoginButton" onclick="btn_login_onclick"/>
