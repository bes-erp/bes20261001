<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="SYS10000M" width="1280" height="720" titletext="로그인" onload="SYS10000M_onload" onsize="SYS10000M_onsize">
    <Objects>
      <Dataset id="ds_login">
        <ColumnInfo>
          <Column id="USER_ID" type="STRING" size="256"/>
          <Column id="PASSWORD" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_loginResult">
        <ColumnInfo>
          <Column id="RESULT_CD" type="STRING" size="256"/>
          <Column id="RESULT_DESCR" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_frameMenu">
        <ColumnInfo>
          <Column id="MENU_ID" type="STRING" size="256"/>
          <Column id="PARENT_MENU_CD" type="STRING" size="256"/>
          <Column id="CHILD_MENU_CD" type="STRING" size="256"/>
          <Column id="CHILD_MENU_NM" type="STRING" size="256"/>
          <Column id="CHILD_PAGE_ULR" type="STRING" size="256"/>
          <Column id="CHILD_MENU_LEVEL" type="INT" size="256"/>
          <Column id="CHILD_MENU_SEQ" type="INT" size="256"/>
          <Column id="USER_YN" type="STRING" size="256"/>
          <Column id="BTN_SEARCH_YN" type="STRING" size="256"/>
          <Column id="BTN_SEARCH_INIT_YN" type="STRING" size="256"/>
          <Column id="BTN_SAVE_YN" type="STRING" size="256"/>
          <Column id="BTN_ADD_ROW_YN" type="STRING" size="256"/>
          <Column id="BTN_DEL_ROW_YN" type="STRING" size="256"/>
          <Column id="BTN_EXCEL_DOWN_YN" type="STRING" size="256"/>
          <Column id="BTN_EXCEL_UP_YN" type="STRING" size="256"/>
          <Column id="BTN_PRINT_YN" type="STRING" size="256"/>
          <Column id="BTN_BATCH_YN" type="STRING" size="256"/>
          <Column id="REMARK" type="STRING" size="256"/>
          <Column id="CREATE_DATE" type="STRING" size="256"/>
          <Column id="CREATE_BY" type="STRING" size="256"/>
          <Column id="UPDATE_DATE" type="STRING" size="256"/>
          <Column id="UPDATE_BY" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
    <Script type="xscript5.1"><![CDATA[/***************************************************************************************
 * 프로젝트        : Built1 Enterprise System 구축 프로젝트
 * 업무구분        : 시스템관리
 * 파일명          : SYS10000M.xfdl
 * 작성자          : Built1
 * 작성일          : 2026-11-02
 *
 * 화면            : 로그인
 * 설명            : 사용자 로그인 및 개인의 세션정보 등록
 *---------------------------------------------------------------------------------------
 * 변경일            변경자            변경내역
 *---------------------------------------------------------------------------------------
 * 2026-11-02        Built1            최초작성
 * 2026-11-04        Built1            공통 함수 적용 및 로그인 정보 저장 기능 추가
 * 2026-11-05        Built1            DB 메뉴정보 조회 및 공통 프레임 연동
 * 2026-11-06        Built1            전역 Dataset 및 프레임 ID 변경, 사용자 환영 문구 갱신
 ***************************************************************************************/


/***************************************************************************************
 * 1. FORM 변수 선언
 ***************************************************************************************/

// 아이디 저장 여부를 브라우저 PrivateProfile에서 구분하기 위한 키
this.fv_saveIdKey   = "BES_DEV_SAVE_ID";
// 저장된 사용자 ID를 조회하거나 삭제할 때 사용하는 키
this.fv_userIdKey   = "BES_DEV_USER_ID";
// 비밀번호 저장 여부를 구분하기 위한 키
this.fv_savePwKey   = "BES_DEV_SAVE_PW";
// 저장된 비밀번호를 조회하거나 삭제할 때 사용하는 키 (평문 저장 위험 주의)
this.fv_passwordKey = "BES_DEV_PASSWORD";


/***************************************************************************************
 * 2. FORM LOAD
 ***************************************************************************************/

/*
 * 기능 : 화면 초기화
 */
this.fn_init = function(obj, e)
{
    // 로그인 영역을 화면 중앙에 배치하고 이전에 저장한 로그인 정보를 복원
    // fn_centerLogin : 로그인 Div와 저작권 문구를 화면 가운데 배치하는 함수
    this.fn_centerLogin();
    // fn_loadLoginInfo : 로그아웃 후 저장 옵션에 맞춰 입력값을 다시 표시
    this.fn_loadLoginInfo();
};


/***************************************************************************************
 * 3. 공통 버튼
 ***************************************************************************************/

/*
 * 기능 : 로그인 처리
 */
this.fn_login = function()
{
    // 로그인 Div의 아이디 및 비밀번호 입력값 조회
    // sUserId : 로그인 Div 안의 아이디 입력 컴포넌트(edt_userId)에 입력된 값
    var sUserId   = this.div_login.form.edt_userId.value;
    // sPassword : 로그인 Div 안의 비밀번호 입력 컴포넌트(edt_password)에 입력된 값
    var sPassword = this.div_login.form.edt_password.value;

    // 아이디 필수값 확인
    // gfn_isNull : 공통 라이브러리의 값 비어 있음 여부 검사 함수
    if (this.gfn_isNull(sUserId))
    {
        this.alert("아이디를 입력해 주세요.");
        this.div_login.form.edt_userId.setFocus();
        return;
    }

    // 비밀번호 필수값 확인
    // 비밀번호가 입력되지 않았으면 서버 요청 없이 안내하고 종료
    if (this.gfn_isNull(sPassword))
    {
        this.alert("비밀번호를 입력해 주세요.");
        this.div_login.form.edt_password.setFocus();
        return;
    }

    // 이전 로그인 요청 데이터를 제거한 뒤 서버로 전달할 사용자 정보를 1행에 구성
    // 비밀번호는 인증 요청에만 사용하고 응답 처리 후 Dataset에서 제거
    // 로그인 요청 데이터 설정
    // ds_login : 서버로 전송할 로그인 요청 Dataset. 기존 행을 삭제하여 이전 요청값이 섞이지 않게 함
    this.ds_login.clearData();

    // nRow : ds_login에 새로 추가한 행 번호. setColumn으로 해당 행에 요청값 입력
    var nRow = this.ds_login.addRow();

    // 새로 만든 행의 USER_ID 컬럼에 입력한 아이디 저장
    this.ds_login.setColumn(nRow, "USER_ID", sUserId);
    // 새로 만든 행의 PASSWORD 컬럼에 비밀번호 저장 (전송 후 Dataset에서 제거)
    this.ds_login.setColumn(nRow, "PASSWORD", sPassword);

    // 로그인 Transaction 설정
    // sSvcID : 콜백에서 어떤 서버 요청의 응답인지 구별하는 서비스 식별자
    var sSvcID        = "login";
    // sSvcURL : Nexacro 서비스 별칭(svcUrl)과 로그인 Controller 요청 경로
    var sSvcURL       = "svcUrl::sys/SYS10000M/login.do";
    // sInDatasets : 서버에 dsLogin이라는 이름으로 보낼 클라이언트 Dataset 매핑
    var sInDatasets   = "dsLogin=ds_login";
    // sOutDatasets : 서버 outLogin 응답을 클라이언트 ds_loginResult에 받는 매핑
    var sOutDatasets  = "ds_loginResult=outLogin";
    // sArgument : Dataset 외 추가 파라미터. 현재는 별도 전달값이 없어 빈 문자열
    var sArgument     = "";
    // sCallbackFunc : 서버 응답이 도착했을 때 실행할 콜백 함수 이름
    var sCallbackFunc = "fn_callback";

    // 공통 Transaction 호출
    // gfn_transaction : 공통 서버 통신 함수. 지정한 URL로 요청하고 완료 후 fn_callback 실행
    this.gfn_transaction(sSvcID, sSvcURL, sInDatasets, sOutDatasets, sArgument, sCallbackFunc);
};


/***************************************************************************************
 * 4. TRANSACTION, CALLBACK
 ***************************************************************************************/

/*
 * 기능 : 로그인 및 메뉴정보 조회 Transaction 결과 처리
 */
this.fn_callback = function(sSvcID, nErrCd, sErrMsg)
{
    // 공통 Transaction 통신 또는 서버 처리 오류 확인
    if (nErrCd < 0)
    {
        if (sSvcID == "login")
        {
            // ds_login : 서버로 전송할 로그인 요청 Dataset. 기존 행을 삭제하여 이전 요청값이 섞이지 않게 함
            this.ds_login.clearData();
            this.div_login.form.edt_password.set_value(null);
        }

        this.alert(sErrMsg);
        return;
    }

    switch(sSvcID)
    {
        // 로그인
        case "login":

            // 로그인 요청 데이터 삭제
            // ds_login : 서버로 전송할 로그인 요청 Dataset. 기존 행을 삭제하여 이전 요청값이 섞이지 않게 함
            this.ds_login.clearData();

            // 로그인 결과 확인
            if (this.ds_loginResult.rowcount == 0)
            {
                this.div_login.form.edt_password.set_value(null);
                this.alert("로그인 결과가 없습니다.");
                return;
            }

            // sResultCd : 서버가 반환한 인증 결과 코드 (현재 소스는 S를 성공으로 판정)
            var sResultCd  = this.ds_loginResult.getColumn(0, "RESULT_CD");
            // sResultMsg : 서버가 반환한 인증 결과 설명 문구
            var sResultMsg = this.ds_loginResult.getColumn(0, "RESULT_DESCR");

            // 로그인 성공
            if (sResultCd == "S")
            {
                var sUserId = this.div_login.form.edt_userId.value;
                // objApp : 전역 사용자 ID 및 전역 메뉴 Dataset을 관리하는 Nexacro 애플리케이션 객체
                var objApp  = nexacro.getApplication();

                // 체크박스 선택 상태에 따라 아이디 및 비밀번호 저장/삭제
                // 비밀번호는 PrivateProfile에 보관되므로 운영 보안 정책 확인 필요
                // 로그인 정보 저장
                // fn_saveLoginInfo : 체크박스 상태에 따라 로그인 입력값 저장 또는 삭제
                this.fn_saveLoginInfo();

                // 로그인 사용자 정보 설정
                // gvUserId : 여러 Form에서 접근하는 애플리케이션 전역 로그인 사용자 ID
                objApp.gvUserId = sUserId;

                // 인증 성공 후 사용자별 메뉴를 조회하고, 조회 완료 시 메인 화면 표시
                // DB 메뉴정보 조회
                // fn_selectFrameMenuList : 로그인 성공 이후 DB 메뉴정보를 요청하는 함수
                this.fn_selectFrameMenuList();
            }
            else
            {
                // 로그인 실패 처리
                this.div_login.form.edt_password.set_value(null);
                this.alert(sResultMsg || "로그인에 실패했습니다.");
                this.div_login.form.edt_password.setFocus();
            }
            break;

        // 공통 프레임 메뉴정보 조회
        case "selectFrameMenuList":

            // 메뉴 조회 결과 확인
            if (this.ds_frameMenu.rowcount == 0)
            {
                this.alert("사용 가능한 메뉴정보가 없습니다.");
                return;
            }

            // objApp : Nexacro 애플리케이션 객체. 전역 Dataset 및 메인 프레임에 접근할 때 사용
            var objApp = nexacro.getApplication();

            if (!objApp.gds_menu)
            {
                this.alert("전역 메뉴 Dataset을 찾을 수 없습니다.");
                return;
            }

            // 각 프레임에서 동일한 메뉴 데이터를 참조하도록 조회 결과를 전역 Dataset에 복사
            // DB 조회 결과를 전역 Dataset에 저장
            // gds_menu : 공통 프레임이 공유하는 전역 메뉴 Dataset. 조회 결과를 복사해 각 프레임에서 참조
            objApp.gds_menu.copyData(this.ds_frameMenu);

            // 로그인 프레임을 숨기고 메인 프레임을 표시
            // 메뉴 조회 완료 후 메인 화면 이동
            // fn_goMain : 로그인 화면 영역을 숨기고 메인 화면 영역을 표시하는 함수
            this.fn_goMain();

            // 로그인 성공 후 상단 사용자 환영 문구 갱신
            // Form_Top은 로그인 이전에 로드될 수 있으므로 메뉴 조회 완료 후 다시 설정
            var objTopFrame = objApp.mainframe.VFrameSetMain.VFrameSetWork.TopFrame;

            if (objTopFrame && objTopFrame.form && objTopFrame.form.fn_setUserInfo)
            {
                // gvUserId를 읽어 상단 Static에 로그인 사용자 ID 표시
                objTopFrame.form.fn_setUserInfo();
            }

            // 상단 메뉴 프레임 조회
            var objMenuFrame = objApp.mainframe.VFrameSetMain.VFrameSetWork.MenuFrame;

            if (objMenuFrame && objMenuFrame.form)
            {
                // gds_menu의 1레벨 메뉴를 기준으로 상단 메뉴 버튼 동적 생성
                // DB 최상위 메뉴 버튼 생성
                // fn_createTopMenu : Form_Menu에 정의된 상단 1레벨 메뉴 버튼 생성 함수
                objMenuFrame.form.fn_createTopMenu();

            }
            else
            {
                this.alert("상단 메뉴 프레임을 찾을 수 없습니다.");
            }

            // 왼쪽 메뉴 프레임 조회
            var objLeftFrame = objApp.mainframe.VFrameSetMain.VFrameSetWork.HFrameSetWork.LeftFrame;

            if (objLeftFrame && objLeftFrame.form)
            {
                // 최초 최상위 메뉴에 해당하는 왼쪽 메뉴 구성
                // fn_init : Form_Left의 왼쪽 메뉴 초기 구성 함수
                objLeftFrame.form.fn_init();

            }
            else
            {
                this.alert("왼쪽 메뉴 프레임을 찾을 수 없습니다.");
            }
            break;
    }
};


/***************************************************************************************
 * 5. 팝업 호출 및 콜백
 ***************************************************************************************/


/***************************************************************************************
 * 6. 기타 함수
 ***************************************************************************************/

/*
 * 기능 : 공통 프레임 메뉴정보 조회
 */
this.fn_selectFrameMenuList = function()
{
    // 이전 메뉴 조회 결과 초기화
    this.ds_frameMenu.clearData();

    // 메뉴 조회 Transaction 설정
    // sSvcID : 메뉴 조회 요청임을 콜백에서 구분하는 식별자
    var sSvcID        = "selectFrameMenuList";
    // sSvcURL : 서버의 공통 메뉴 조회 Controller 경로
    var sSvcURL       = "svcUrl::com/menu/selectMenuList.do";
    // sInDatasets : 서버에 전달할 Dataset 없음
    var sInDatasets   = "";
    // sOutDatasets : 서버 outMenu 응답을 ds_frameMenu Dataset에 저장
    var sOutDatasets  = "ds_frameMenu=outMenu";
    // sArgument : Dataset 외 추가 파라미터. 현재는 별도 전달값이 없어 빈 문자열
    var sArgument     = "";
    // sCallbackFunc : 서버 응답이 도착했을 때 실행할 콜백 함수 이름
    var sCallbackFunc = "fn_callback";

    // 공통 Transaction 호출
    // gfn_transaction : 공통 서버 통신 함수. 지정한 URL로 요청하고 완료 후 fn_callback 실행
    this.gfn_transaction(sSvcID, sSvcURL, sInDatasets, sOutDatasets, sArgument, sCallbackFunc);
};


/*
 * 기능 : 로그인 정보 저장
 */
this.fn_saveLoginInfo = function()
{
    // objLogin : 로그인 입력 컴포넌트와 체크박스를 포함한 Div 내부 Form
    var objLogin = this.div_login.form;
    // bSaveId : 아이디 저장 체크박스가 선택되었는지 나타내는 boolean 값
    var bSaveId  = (objLogin.chk_saveId.value == 1);
    // bSavePw : 비밀번호 저장 체크박스가 선택되었는지 나타내는 boolean 값
    var bSavePw  = (objLogin.chk_savePw.value == 1);

    // 체크 시 사용자 아이디를 PrivateProfile에 저장하고 해제 시 기존 값을 삭제
    // 아이디 저장
    if (bSaveId)
    {
        nexacro.setPrivateProfile(this.fv_saveIdKey, "1");
        nexacro.setPrivateProfile(this.fv_userIdKey, objLogin.edt_userId.value);
    }
    else
    {
        nexacro.removePrivateProfile(this.fv_saveIdKey);
        nexacro.removePrivateProfile(this.fv_userIdKey);
    }

    // 체크 시 입력된 비밀번호를 PrivateProfile에 저장하고 해제 시 삭제
    // 주의: 이 API 사용만으로 안전한 암호화 저장이 보장되는 것은 아님
    // 비밀번호 저장
    if (bSavePw)
    {
        nexacro.setPrivateProfile(this.fv_savePwKey, "1");
        nexacro.setPrivateProfile(this.fv_passwordKey, objLogin.edt_password.value);
    }
    else
    {
        nexacro.removePrivateProfile(this.fv_savePwKey);
        nexacro.removePrivateProfile(this.fv_passwordKey);
    }
};


/*
 * 기능 : 저장된 로그인 정보 조회
 */
this.fn_loadLoginInfo = function()
{
    // objLogin : 로그인 입력 컴포넌트와 체크박스를 포함한 Div 내부 Form
    var objLogin = this.div_login.form;
    // sSaveId : PrivateProfile에서 읽은 아이디 저장 여부 문자열
    var sSaveId  = nexacro.getPrivateProfile(this.fv_saveIdKey);
    // sSavePw : PrivateProfile에서 읽은 비밀번호 저장 여부 문자열
    var sSavePw  = nexacro.getPrivateProfile(this.fv_savePwKey);
    // bSaveId : 아이디 저장 체크박스가 선택되었는지 나타내는 boolean 값
    var bSaveId  = (sSaveId == "1");
    // bSavePw : 비밀번호 저장 체크박스가 선택되었는지 나타내는 boolean 값
    var bSavePw  = (sSavePw == "1");

    // 이전에 저장한 설정값("1")을 체크박스 값(1 또는 0)으로 복원
    // 저장 여부 체크박스 설정
    objLogin.chk_saveId.set_value(bSaveId ? 1 : 0);
    objLogin.chk_savePw.set_value(bSavePw ? 1 : 0);

    // 아이디 조회
    if (bSaveId)
    {
        objLogin.edt_userId.set_value(nexacro.getPrivateProfile(this.fv_userIdKey));
    }
    else
    {
        objLogin.edt_userId.set_value(null);
    }

    // 비밀번호 조회
    if (bSavePw)
    {
        objLogin.edt_password.set_value(nexacro.getPrivateProfile(this.fv_passwordKey));
    }
    else
    {
        objLogin.edt_password.set_value(null);
    }
};


/*
 * 기능 : 로그아웃 후 로그인 정보 초기화
 */
this.fn_resetLogin = function()
{
    // 로그아웃 이후 이전 사용자의 로그인 요청/결과/메뉴 데이터를 초기화
    // ds_login : 서버로 전송할 로그인 요청 Dataset. 기존 행을 삭제하여 이전 요청값이 섞이지 않게 함
    this.ds_login.clearData();
    this.ds_loginResult.clearData();
    this.ds_frameMenu.clearData();

    // objApp : Nexacro 애플리케이션 객체. 전역 Dataset 및 메인 프레임에 접근할 때 사용
    var objApp = nexacro.getApplication();

    if (objApp.gds_menu)
    {
        objApp.gds_menu.clearData();
    }

    // 저장 옵션에 따라 로그인 입력값을 다시 표시
    // fn_loadLoginInfo : 로그아웃 후 저장 옵션에 맞춰 입력값을 다시 표시
    this.fn_loadLoginInfo();
};


/*
 * 기능 : 로그인 성공 후 메인 프레임 전환
 */
this.fn_goMain = function()
{
    var objApp       = nexacro.getApplication();
    var objMainFrame = objApp.mainframe.VFrameSetMain;

    if (!objMainFrame)
    {
        this.alert("메인 프레임을 찾을 수 없습니다.");
        return;
    }

    // 로그인 화면 숨김 및 메인 화면 표시
    // set_separatesize("0,*") : 첫 번째 로그인 영역은 0, 두 번째 메인 영역은 나머지 공간 사용
    objMainFrame.set_separatesize("0,*");
};


/*
 * 기능 : 로그인 화면 중앙 정렬
 */
this.fn_centerLogin = function()
{
    var objApp        = nexacro.getApplication();
    var objLoginFrame = objApp.mainframe.VFrameSetMain.LoginFrame;

    if (!objLoginFrame) return;

    // 화면 크기 변경 시에도 로그인 Div가 중앙에 오도록 공통 함수 호출
    // 공통 함수를 이용한 로그인 Div 중앙 정렬
    // gfn_center : 공통 가운데 정렬 함수. 로그인 Div를 기준 Form에서 세로로 25만큼 보정
    this.gfn_center(this.div_login, this, 0, -25);

    // 로그인 Div의 현재 위치와 높이를 기준으로 저작권 문구를 아래에 배치
    // 하단 문구 위치 설정
    // nLeft : 로그인 Div의 왼쪽 좌표. 저작권 문구의 가로 시작 위치로 사용
    var nLeft = this.div_login.getOffsetLeft();
    // nTop : 로그인 Div 아래쪽에서 20만큼 떨어진 저작권 문구의 세로 위치
    var nTop  = this.div_login.getOffsetTop()
              + this.div_login.getOffsetHeight() + 20;

    // move : 저작권 문구 Static을 계산한 좌표로 이동
    this.sta_copyright.move(nLeft, nTop);
};


/***************************************************************************************
 * 7. 이벤트
 ***************************************************************************************/

/*
 * 기능 : 화면 로딩 이벤트
 */
this.SYS10000M_onload = function(obj, e)
{
    // fn_init : 화면 로딩 시 로그인 입력값 복원과 중앙 정렬 수행
    this.fn_init(obj, e);
};


/*
 * 기능 : 화면 크기 변경 이벤트
 */
this.SYS10000M_onsize = function(obj, e)
{
    // fn_centerLogin : 로그인 Div와 저작권 문구를 화면 가운데 배치하는 함수
    this.fn_centerLogin();
};


/*
 * 기능 : 로그인 버튼 클릭 이벤트
 */
this.btn_login_onclick = function(obj, e)
{
    // fn_login : 입력값 검사, 로그인 Dataset 생성, 서버 인증 요청을 수행하는 함수
    this.fn_login();
};


/*
 * 기능 : 비밀번호 입력 후 Enter 키 이벤트
 */
this.edt_password_onkeydown = function(obj, e)
{
    // 비밀번호 입력칸에서 Enter를 누르면 로그인 버튼과 동일한 함수 실행
    if (e.keycode == 13)
    {
        // fn_login : 입력값 검사, 로그인 Dataset 생성, 서버 인증 요청을 수행하는 함수
        this.fn_login();
    }
};]]></Script>
    <Layouts>
      <Layout height="720" width="1280" screenid="Desktop_screen">
        <Div id="div_login" taborder="0" left="400" top="125" width="480" height="470" cssclass="besLoginPanel">
          <Layouts>
            <Layout width="480" height="470">
              <Static id="sta_title" taborder="0" left="40" top="45" width="400" height="50" text="BES" textAlign="center" cssclass="besLoginTitle"/>
              <Static id="sta_subTitle" taborder="1" left="40" top="96" width="400" height="24" text="Built1 Enterprise System" textAlign="center" cssclass="besLoginSubtitle"/>
              <Static id="sta_id" taborder="2" left="65" top="155" width="350" height="25" text="아이디" cssclass="besLoginLabel"/>
              <Edit id="edt_userId" taborder="3" left="65" top="185" width="350" height="42" displaynulltext="아이디를 입력하세요" cssclass="besLoginEdit"/>
              <Static id="sta_pw" taborder="4" left="65" top="245" width="350" height="25" text="비밀번호" cssclass="besLoginLabel"/>
              <Edit id="edt_password" taborder="5" left="65" top="275" width="350" height="42" password="true" displaynulltext="비밀번호를 입력하세요" cssclass="besLoginEdit" onkeydown="edt_password_onkeydown"/>
              <CheckBox id="chk_saveId" taborder="6" left="65" top="330" width="100" height="25" text="아이디 저장" cssclass="besLoginCheckbox"/>
              <CheckBox id="chk_savePw" taborder="7" left="180" top="330" width="110" height="25" text="비밀번호 저장" cssclass="besLoginCheckbox"/>
              <Button id="btn_login" taborder="8" left="65" top="380" width="350" height="48" text="로그인" cssclass="besLoginButton" onclick="btn_login_onclick"/>
            </Layout>
          </Layouts>
        </Div>
        <Static id="sta_copyright" taborder="1" left="400" top="615" width="480" height="30" text="© BES. All rights reserved." textAlign="center" cssclass="besLoginCopyright"/>
      </Layout>
    </Layouts>
  </Form>
</FDL>
