<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="SYS10000M" width="1280" height="720" titletext="로그인" background="#f0f0f0" onload="SYS10000M_onload" onsize="SYS10000M_onsize">
    <Objects>
      <Dataset id="ds_login">
        <ColumnInfo>
          <Column id="USER_ID" type="STRING" size="256"/>
          <Column id="PASSWORD" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_loginResult">
        <ColumnInfo>
          <Column id="RESULT_CD" type="STRING" size="256"/>
          <Column id="RESULT_DESCR" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_lang">
        <ColumnInfo>
          <Column id="LANG_CD" type="STRING" size="256"/>
          <Column id="LANG_NM" type="STRING" size="256"/>
        </ColumnInfo>
        <Rows>
          <Row>
            <Col id="LANG_CD">KO</Col>
            <Col id="LANG_NM">한국어(KOR)</Col>
          </Row>
          <Row>
            <Col id="LANG_CD">EN</Col>
            <Col id="LANG_NM">English(ENG)</Col>
          </Row>
          <Row>
            <Col id="LANG_CD">ZH</Col>
            <Col id="LANG_NM">中文(CHN)</Col>
          </Row>
        </Rows>
      </Dataset>
      <Dataset id="ds_frameMenu">
        <ColumnInfo>
          <Column id="MENU_ID" type="STRING" size="256"/>
          <Column id="PARENT_MENU_CD" type="STRING" size="256"/>
          <Column id="CHILD_MENU_CD" type="STRING" size="256"/>
          <Column id="CHILD_MENU_NM" type="STRING" size="256"/>
          <Column id="CHILD_PAGE_ULR" type="STRING" size="256"/>
          <Column id="CHILD_MENU_LEVEL" type="INT" size="256"/>
          <Column id="CHILD_MENU_SEQ" type="INT" size="256"/>
          <Column id="USER_YN" type="STRING" size="256"/>
          <Column id="BTN_SEARCH_YN" type="STRING" size="256"/>
          <Column id="BTN_SEARCH_INIT_YN" type="STRING" size="256"/>
          <Column id="BTN_SAVE_YN" type="STRING" size="256"/>
          <Column id="BTN_ADD_ROW_YN" type="STRING" size="256"/>
          <Column id="BTN_DEL_ROW_YN" type="STRING" size="256"/>
          <Column id="BTN_EXCEL_DOWN_YN" type="STRING" size="256"/>
          <Column id="BTN_EXCEL_UP_YN" type="STRING" size="256"/>
          <Column id="BTN_PRINT_YN" type="STRING" size="256"/>
          <Column id="BTN_BATCH_YN" type="STRING" size="256"/>
          <Column id="REMARK" type="STRING" size="256"/>
          <Column id="CREATE_DATE" type="STRING" size="256"/>
          <Column id="CREATE_BY" type="STRING" size="256"/>
          <Column id="UPDATE_DATE" type="STRING" size="256"/>
          <Column id="UPDATE_BY" type="STRING" size="256"/>
        </ColumnInfo>
      </Dataset>
    </Objects>
    <Script type="xscript5.1"><![CDATA[/***************************************************************************************
 * 프로젝트        : Built1 Enterprise System 구축 프로젝트
 * 업무구분        : 시스템관리
 * 파일명          : SYS10000M.xfdl
 * 작성자          : Built1
 * 작성일          : 2026-11-02
 *
 * 화면            : 로그인
 * 설명            : 사용자 로그인 및 개인의 세션정보 등록
 *---------------------------------------------------------------------------------------
 * 변경일            변경자            변경내역
 *---------------------------------------------------------------------------------------
 * 2026-11-02        Built1            최초작성
 * 2026-11-06        Built1            IFC 로그인 레이아웃 및 다국어 적용
 ***************************************************************************************/

// include "besLib::libLang.xjs";
// include "besLib::libMessage.xjs";

/***************************************************************************************
 * 1. FORM 변수 선언
 ***************************************************************************************/

// 아이디 저장 여부를 관리하는 PrivateProfile 키
this.fv_saveIdKey   = "BES_DEV_SAVE_ID";

// 저장된 사용자 아이디를 관리하는 PrivateProfile 키
this.fv_userIdKey   = "BES_DEV_USER_ID";

// 비밀번호 저장 여부를 관리하는 PrivateProfile 키
this.fv_savePwKey   = "BES_DEV_SAVE_PW";

// 저장된 비밀번호를 관리하는 PrivateProfile 키
this.fv_passwordKey = "BES_DEV_PASSWORD";

// 현재 로그인 화면에 적용된 언어 코드
this.fv_language = "KO";


/***************************************************************************************
 * 2. FORM LOAD
 ***************************************************************************************/

/**
 * @description 로그인 화면 초기화
 */
this.fn_init = function(obj, e)
{
    // 공통 LIB를 이용하여 로그인 영역 중앙 정렬
    this.fn_centerLogin();

    // 저장된 아이디 및 비밀번호 정보 복원
    this.fn_loadLoginInfo();

    // 공통 언어 LIB를 이용하여 저장된 언어 설정 복원
    this.fn_loadLanguage();

    // 로그인 화면에서 사용할 공통 메시지 조회
    // 조회 완료 시 LIB_MESSAGE에서 Application.gds_message에 복사
    this.gfn_loadMessage(this);
};


/***************************************************************************************
 * 3. 공통 버튼
 ***************************************************************************************/

/**
 * @description 사용자 로그인 인증 요청
 */
this.fn_login = function()
{
    // 로그인 입력 컴포넌트가 포함된 Div Form
    var objLogin = this.div_login.form;

    // 사용자가 입력한 로그인 아이디
    var sUserId   = objLogin.edt_userId.value;

    // 사용자가 입력한 로그인 비밀번호
    var sPassword = objLogin.edt_password.value;

    // 아이디 입력 여부 확인
    if (this.gfn_isNull(sUserId))
	{
		// DB 공통 메시지 다국어 테스트
		//trace("[메시지 테스트] 현재 언어: " + nexacro.getApplication().gv_lang);

		this.gfn_message("MSG-A-TEST01");

		// 아이디 입력창으로 포커스 이동
		objLogin.edt_userId.setFocus();
		return;
	}

    // 비밀번호 입력 여부 확인
    if (this.gfn_isNull(sPassword))
    {
        // 비밀번호 미입력 안내 메시지 출력
        this.fn_showLoginMessage("INPUT_PW", "비밀번호를 입력해 주세요.");

        // 비밀번호 입력창으로 포커스 이동
        objLogin.edt_password.setFocus();
        return;
    }

    // 이전 로그인 요청 데이터 초기화
    this.ds_login.clearData();

    // 로그인 요청 Dataset에 신규 행 생성
    var nRow = this.ds_login.addRow();

    // 서버에 전달할 사용자 아이디 설정
    this.ds_login.setColumn(nRow, "USER_ID", sUserId);

    // 서버에 전달할 비밀번호 설정
    this.ds_login.setColumn(nRow, "PASSWORD", sPassword);

    // 로그인 인증 Transaction 설정
    var sSvcID        = "login";                         		// 서비스 ID
    var sSvcURL 	  = "svcUrl::sys/SYS10000M/login.do";		// 로그인 Controller URL  
    var sInDatasets   = "dsLogin=ds_login";              		// 서버 입력 Dataset
    var sOutDatasets  = "ds_loginResult=outLogin";       		// 서버 출력 Dataset
    var sArgument     = "";                             		// 추가 전달 파라미터
    var sCallbackFunc = "fn_callBack";                   		// Transaction 결과 콜백

    // 공통 LIB의 Transaction 함수를 이용하여 로그인 인증 요청
    this.gfn_transaction(sSvcID, sSvcURL, sInDatasets, sOutDatasets, sArgument, sCallbackFunc);
};


/***************************************************************************************
 * 4. TRANSACTION / CALLBACK
 ***************************************************************************************/

/**
 * @description 로그인 인증 및 메뉴 조회 Transaction 결과 처리
 * @param       {sSvcID  : String} 서비스 ID
 * @param       {nErrCd  : Number} 서버 처리 결과 코드
 * @param       {sErrMsg : String} 서버 오류 메시지
 */
this.fn_callBack = function(sSvcID, nErrCd, sErrMsg)
{
    // 서버 통신 또는 처리 중 오류 발생 여부 확인
    if (nErrCd < 0)
    {
        // 로그인 서비스에서 오류가 발생한 경우
        if (sSvcID == "login")
        {
            // 비밀번호가 포함된 요청 Dataset 초기화
            this.ds_login.clearData();

            // 화면에 입력된 비밀번호 제거
            this.div_login.form.edt_password.set_value(null);
        }

        // 서버에서 반환한 오류 메시지 출력
        this.alert(sErrMsg);
        return;
    }

    // 서비스 ID에 따라 처리 결과 구분
    switch (sSvcID)
    {
        // 사용자 로그인 인증 결과
        case "login":

            // 로그인 요청 Dataset의 비밀번호 데이터 제거
            this.ds_login.clearData();

            // 로그인 결과 데이터 존재 여부 확인
            if (this.ds_loginResult.getRowCount() == 0)
            {
                // 비밀번호 입력값 초기화
                this.div_login.form.edt_password.set_value(null);

                // 로그인 결과가 없는 경우 안내 메시지 출력
                this.fn_showLoginMessage("NO_LOGIN_RESULT", "로그인 결과가 없습니다.");
                return;
            }

            // 서버에서 반환한 로그인 처리 결과 코드
            var sResultCd  = this.ds_loginResult.getColumn(0, "RESULT_CD");

            // 서버에서 반환한 로그인 처리 결과 메시지
            var sResultMsg = this.ds_loginResult.getColumn(0, "RESULT_DESCR");

            // 로그인 성공 여부 확인
            if (sResultCd == "S")
            {
                // Application 전역 객체 조회
                var objApp = nexacro.getApplication();

                // 로그인한 사용자 아이디를 전역 변수에 저장
                objApp.gv_userid = this.div_login.form.edt_userId.value;

                // 공통 언어 LIB를 이용하여 선택 언어 저장
                this.fv_language = this.gfn_setLanguage(this.fv_language);

                // 로그인 정보 저장 설정 반영
                this.fn_saveLoginInfo();

                // 로그인 사용자에게 허용된 DB 메뉴정보 조회
                this.fn_selectFrameMenuList();
            }
            else
            {
                // 로그인 인증 실패 시 비밀번호 입력값 제거
                this.div_login.form.edt_password.set_value(null);

                // 서버에서 반환한 인증 실패 메시지 출력
                if (this.gfn_isNull(sResultMsg))
                {
                    this.fn_showLoginMessage("LOGIN_FAILED", "로그인에 실패했습니다.");
                }
                else
                {
                    this.alert(sResultMsg);
                }

                // 비밀번호 입력창으로 포커스 이동
                this.div_login.form.edt_password.setFocus();
            }

            break;

        // 로그인 사용자별 메뉴정보 조회 결과
        case "selectFrameMenuList":

            // 메뉴 조회 결과가 없는 경우 처리
            if (this.ds_frameMenu.getRowCount() == 0)
            {
                this.fn_showLoginMessage("NO_MENU", "사용 가능한 메뉴정보가 없습니다.");
                return;
            }

            // Application 전역 객체 조회
            var objApp = nexacro.getApplication();

            // Application에 전역 메뉴 Dataset이 정의되어 있는지 확인
            if (!objApp.gds_menu)
            {
                this.alert("전역 메뉴 Dataset을 찾을 수 없습니다.");
                return;
            }

            // DB에서 조회한 메뉴정보를 전역 Dataset에 복사
            objApp.gds_menu.copyData(this.ds_frameMenu);

            // 로그인 화면을 숨기고 메인 업무 화면 표시
            this.fn_goMain();

            // 메인 업무 프레임 객체 조회
            var objWorkFrame = objApp.mainframe.VFrameSetMain.VFrameSetWork;

            // 상단 사용자 정보 프레임
            var objTopFrame  = objWorkFrame.TopFrame;

            // 상단 대분류 메뉴 프레임
            var objMenuFrame = objWorkFrame.MenuFrame;

            // 왼쪽 하위 메뉴 프레임
            var objLeftFrame = objWorkFrame.HFrameSetWork.LeftFrame;

            // 로그인 사용자 정보 갱신
			if (objTopFrame && objTopFrame.form && objTopFrame.form.fn_setUserInfo)
			{
				objTopFrame.form.fn_setUserInfo(objApp.gv_userid);
			}

            // DB 메뉴정보를 이용하여 상단 대분류 메뉴 생성
            if (objMenuFrame && objMenuFrame.form && objMenuFrame.form.fn_createTopMenu)
            {
                objMenuFrame.form.fn_createTopMenu();
            }

            // 선택된 대분류에 맞춰 왼쪽 메뉴 초기화
            if (objLeftFrame && objLeftFrame.form && objLeftFrame.form.fn_init)
            {
                objLeftFrame.form.fn_init();
            }

            break;

        default:
            break;
    }
};


/***************************************************************************************
 * 5. 팝업 호출 및 콜백
 ***************************************************************************************/


/***************************************************************************************
 * 6. 기타 함수
 ***************************************************************************************/

/**
 * @description 로그인 사용자별 DB 메뉴정보 조회
 */
this.fn_selectFrameMenuList = function()
{
    // 이전 메뉴 조회 결과 초기화
    this.ds_frameMenu.clearData();

    // 메뉴 조회 Transaction 설정
    var sSvcID        = "selectFrameMenuList";                // 서비스 ID
    var sSvcURL       = "svcUrl::com/menu/selectMenuList.do"; // 메뉴 조회 Controller URL
    var sInDatasets   = "";                                   // 서버 입력 Dataset 없음
    var sOutDatasets  = "ds_frameMenu=outMenu";                // 서버 출력 Dataset
    var sArgument     = "";                                   // 추가 전달 파라미터 없음
    var sCallbackFunc = "fn_callBack";                         // Transaction 결과 콜백

    // 공통 LIB를 이용하여 로그인 사용자 메뉴 조회
    this.gfn_transaction(sSvcID, sSvcURL, sInDatasets, sOutDatasets, sArgument, sCallbackFunc);
};


/**
 * @description 저장된 로그인 정보 및 체크박스 상태 복원
 */
this.fn_loadLoginInfo = function()
{
    // 로그인 입력 컴포넌트가 포함된 Div Form
    var objLogin = this.div_login.form;

    // 이전에 저장한 아이디 저장 여부
    var sSaveId = nexacro.getPrivateProfile(this.fv_saveIdKey);

    // 이전에 저장한 비밀번호 저장 여부
    var sSavePw = nexacro.getPrivateProfile(this.fv_savePwKey);

    // 아이디 저장 체크박스 선택 상태 복원
    objLogin.chk_saveId.set_value(sSaveId == "1" ? 1 : 0);

    // 비밀번호 저장 체크박스 선택 상태 복원
    objLogin.chk_savePw.set_value(sSavePw == "1" ? 1 : 0);

    // 아이디 저장을 선택한 경우 이전 아이디 복원
    if (sSaveId == "1")
    {
        // PrivateProfile에 저장된 아이디를 입력창에 표시
        objLogin.edt_userId.set_value(nexacro.getPrivateProfile(this.fv_userIdKey));
    }
    else
    {
        // 아이디 저장을 선택하지 않은 경우 입력값 초기화
        objLogin.edt_userId.set_value(null);
    }

    // 기존 비밀번호 저장 기능 유지
    if (sSavePw == "1")
    {
        // PrivateProfile에 저장된 비밀번호를 입력창에 표시
        objLogin.edt_password.set_value(nexacro.getPrivateProfile(this.fv_passwordKey));
    }
    else
    {
        // 비밀번호 저장을 선택하지 않은 경우 입력값 초기화
        objLogin.edt_password.set_value(null);
    }
};


/**
 * @description 로그인 성공 시 로그인 정보 저장 설정 반영
 */
this.fn_saveLoginInfo = function()
{
    // 로그인 입력 컴포넌트가 포함된 Div Form
    var objLogin = this.div_login.form;

    // 아이디 저장 체크박스 선택 여부
    var bSaveId = (objLogin.chk_saveId.value == 1);

    // 비밀번호 저장 체크박스 선택 여부
    var bSavePw = (objLogin.chk_savePw.value == 1);

    // 아이디 저장을 선택한 경우
    if (bSaveId)
    {
        // 아이디 저장 여부 기록
        nexacro.setPrivateProfile(this.fv_saveIdKey, "1");

        // 사용자 아이디 저장
        nexacro.setPrivateProfile(this.fv_userIdKey, objLogin.edt_userId.value);
    }
    else
    {
        // 저장된 아이디 관련 정보 삭제
        nexacro.removePrivateProfile(this.fv_saveIdKey);
        nexacro.removePrivateProfile(this.fv_userIdKey);
    }

    // 비밀번호 저장을 선택한 경우
    if (bSavePw)
    {
        // 비밀번호 저장 여부 기록
        nexacro.setPrivateProfile(this.fv_savePwKey, "1");

        // 기존 BES 비밀번호 저장 동작 유지
        nexacro.setPrivateProfile(this.fv_passwordKey, objLogin.edt_password.value);
    }
    else
    {
        // 저장된 비밀번호 관련 정보 삭제
        nexacro.removePrivateProfile(this.fv_savePwKey);
        nexacro.removePrivateProfile(this.fv_passwordKey);
    }
};


/**
 * @description 공통 언어 LIB를 이용하여 이전 언어 설정 복원
 */
this.fn_loadLanguage = function()
{
    // 공통 LIB에서 이전에 저장한 언어 코드 조회
    var sLanguage = this.gfn_getLanguage();

    // 현재 로그인 화면의 언어 변수 설정
    this.fv_language = sLanguage;

    // 공통 LIB를 이용하여 Application 언어 설정
    this.gfn_setLanguage(sLanguage);

    // 언어 선택 Combo에 저장된 언어 적용
    this.div_login.form.cbo_lang.set_value(sLanguage);

    // 선택 언어에 맞춰 로그인 화면 문구 변경
    this.fn_setLanguage(sLanguage);
};


/**
 * @description 선택한 언어에 맞춰 로그인 화면 문구 변경
 * @param       {sLanguage : String} 언어 코드 (KO, EN, ZH)
 */
this.fn_setLanguage = function(sLanguage)
{
    // 로그인 입력 컴포넌트가 포함된 Div Form
    var objLogin = this.div_login.form;

    // 현재 로그인 화면에 적용된 언어 코드
    this.fv_language = sLanguage;

    // 언어별 로그인 화면 문구 설정
    switch (sLanguage)
    {
        // 영어
        case "EN":

            // 로그인 화면 제목
            objLogin.sta_loginTitle.set_text("Login");

            // 로그인 화면 안내 문구
            objLogin.sta_subTitle.set_text("Please log in to use the system.");

            // 아이디 및 비밀번호 입력 안내 문구
            objLogin.edt_userId.set_displaynulltext("User ID");
            objLogin.edt_password.set_displaynulltext("Password");

            // 로그인 버튼 및 저장 체크박스 문구
            objLogin.btn_login.set_text("Login");
            objLogin.chk_saveId.set_text("Save ID");
            objLogin.chk_savePw.set_text("Save Password");
            break;

        // 중국어
        case "ZH":
 
            // 로그인 화면 제목
            objLogin.sta_loginTitle.set_text("登录");

            // 로그인 화면 안내 문구
            objLogin.sta_subTitle.set_text("登录后即可使用系统。");

            // 아이디 및 비밀번호 입력 안내 문구
            objLogin.edt_userId.set_displaynulltext("用户名");
            objLogin.edt_password.set_displaynulltext("密码");

            // 로그인 버튼 및 저장 체크박스 문구
            objLogin.btn_login.set_text("登录");
            objLogin.chk_saveId.set_text("保存账号");
            objLogin.chk_savePw.set_text("保存密码");
            break;

        // 한국어 및 지원하지 않는 언어
        default:

            // 로그인 화면 제목
            objLogin.sta_loginTitle.set_text("로그인");

            // 로그인 화면 안내 문구
            objLogin.sta_subTitle.set_text("로그인 후 시스템을 이용하실 수 있습니다.");

            // 아이디 및 비밀번호 입력 안내 문구
            objLogin.edt_userId.set_displaynulltext("아이디");
            objLogin.edt_password.set_displaynulltext("비밀번호");

            // 로그인 버튼 및 저장 체크박스 문구
            objLogin.btn_login.set_text("로그인");
            objLogin.chk_saveId.set_text("아이디 저장");
            objLogin.chk_savePw.set_text("비밀번호 저장");
            break;
    }
};


/**
 * @description DB 공통 메시지 조회 결과를 이용하여 메시지 출력
 * @param       {sMessageNum     : String} 공통 메시지 번호
 * @param       {sDefaultMessage : String} 메시지 미등록 시 기본 안내문
 */
this.fn_showLoginMessage = function(sMessageNum, sDefaultMessage)
{
    // Application 전역 객체
    var objApp = nexacro.getApplication();

    // 공통 메시지 Dataset
    var objMessageDs = objApp.gds_message;

    // 공통 메시지 Dataset 및 메시지 번호 존재 여부 확인
    if (objMessageDs && objMessageDs.findRow("MESSAGE_NUM", sMessageNum) >= 0)
    {
        // 기존 LIB_UTIL의 공통 메시지 함수 호출
        this.gfn_msgBox(sMessageNum);
        return;
    }

    // 공통 메시지 DB에 등록되지 않은 경우 기본 문구 출력
    this.alert(sDefaultMessage);
};


/**
 * @description 로그인 성공 후 메인 업무 화면 표시
 */
this.fn_goMain = function()
{
    // Application 전역 객체
    var objApp = nexacro.getApplication();

    // 로그인 프레임과 메인 업무 프레임을 관리하는 VFrameSet
    var objMainFrame = objApp.mainframe.VFrameSetMain;

    // 메인 프레임 존재 여부 확인
    if (!objMainFrame)
    {
        this.alert("메인 프레임을 찾을 수 없습니다.");
        return;
    }

    // 로그인 프레임 숨김 및 메인 업무 프레임 표시
    objMainFrame.set_separatesize("0,*");
};


/**
 * @description 공통 LIB를 이용하여 로그인 영역 중앙 정렬
 */
this.fn_centerLogin = function()
{
    // LIB_UTIL.gfn_center를 이용하여 로그인 Div 중앙 정렬
    this.gfn_center(this.div_login, this);

    // 중앙 정렬된 로그인 Div의 가로 위치
    var nLeft   = this.div_login.getOffsetLeft();

    // 중앙 정렬된 로그인 Div의 세로 위치
    var nTop    = this.div_login.getOffsetTop();

    // 로그인 Div의 너비
    var nWidth  = this.div_login.getOffsetWidth();

    // 로그인 Div의 높이
    var nHeight = this.div_login.getOffsetHeight();

    // 저작권 문구를 로그인 Div 아래쪽에 배치
    this.sta_copyright.move(nLeft, nTop + nHeight + 20, nWidth, 30);
};


/**
 * @description 로그아웃 후 로그인 화면 데이터 초기화
 */
this.fn_resetLogin = function()
{
    // 로그인 요청 Dataset 초기화
    this.ds_login.clearData();

    // 로그인 결과 Dataset 초기화
    this.ds_loginResult.clearData();

    // 메뉴 조회 Dataset 초기화
    this.ds_frameMenu.clearData();

    // Application 전역 객체 조회
    var objApp = nexacro.getApplication();

    // 전역 사용자 정보 초기화
    objApp.gv_userid = "";

    // 전역 메뉴 Dataset 초기화
    if (objApp.gds_menu)
    {
        objApp.gds_menu.clearData();
    }

    // 저장된 로그인 정보 복원
    this.fn_loadLoginInfo();

    // 저장된 언어 설정 복원
    this.fn_loadLanguage();
};


/***************************************************************************************
 * 7. 이벤트
 ***************************************************************************************/

/**
 * @description 로그인 화면 최초 로딩 이벤트
 */
this.SYS10000M_onload = function(obj, e)
{
    // 로그인 화면 초기화
    this.fn_init(obj, e);
};


/**
 * @description 로그인 화면 크기 변경 이벤트
 */
this.SYS10000M_onsize = function(obj, e)
{
    // 화면 크기에 맞춰 로그인 영역 중앙 정렬
    this.fn_centerLogin();
};


/**
 * @description 로그인 버튼 클릭 이벤트
 */
this.btn_login_onclick = function(obj, e)
{
    // 사용자 로그인 인증 요청
    this.fn_login();
};


/**
 * @description 비밀번호 입력창 Enter 키 이벤트
 */
this.edt_password_onkeydown = function(obj, e)
{
    // Enter 키 입력 여부 확인
    if (e.keycode == 13)
    {
        // 사용자 로그인 인증 요청
        this.fn_login();
    }
};


/**
 * @description 언어 선택 Combo 변경 이벤트
 */
this.cbo_lang_onitemchanged = function(obj, e)
{
    // Combo에서 새로 선택한 언어 코드
    var sLanguage = e.postvalue;

    //trace("[언어변경] 선택값: " + sLanguage);

    // 공통 LIB를 이용하여 언어 설정 저장 및 전역 변수 반영
    sLanguage = this.gfn_setLanguage(sLanguage);

    // 로그인 화면 문구 변경
    this.fn_setLanguage(sLanguage);
};]]></Script>
    <Layouts>
