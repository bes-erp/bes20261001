<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="COM12000M" width="1280" height="720" titletext="메시지등록" onload="COM12000M_onload">
    <Objects>
      <Dataset id="dsMsgGubun">
        <ColumnInfo>
          <Column id="code" type="STRING" size="256"/>
          <Column id="name" type="STRING" size="256"/>
        </ColumnInfo>
        <Rows>
          <Row>
            <Col id="code">ALL</Col>
            <Col id="name">전체</Col>
          </Row>
          <Row>
            <Col id="code">FM</Col>
            <Col id="name">화면</Col>
          </Row>
          <Row>
            <Col id="code">NM</Col>
            <Col id="name">시스템</Col>
          </Row>
        </Rows>
      </Dataset>
      <Dataset id="dsMsgType">
        <ColumnInfo>
          <Column id="code" type="STRING" size="256"/>
          <Column id="name" type="STRING" size="256"/>
        </ColumnInfo>
        <Rows>
          <Row>
            <Col id="code">ALL</Col>
            <Col id="name">전체</Col>
          </Row>
          <Row>
            <Col id="code">A</Col>
            <Col id="name">경고</Col>
          </Row>
          <Row>
            <Col id="code">C</Col>
            <Col id="name">확인</Col>
          </Row>
          <Row>
            <Col id="code">I</Col>
            <Col id="name">정보</Col>
          </Row>
        </Rows>
      </Dataset>
      <Dataset id="dsMessage">
        <ColumnInfo>
          <Column id="MESSAGE_NUM" type="STRING" size="30"/>
          <Column id="MESSAGE_GUBUN" type="STRING" size="30"/>
          <Column id="MESSAGE_TYPE_CD" type="STRING" size="30"/>
          <Column id="MESSAGE_TEXT_KO" type="STRING" size="300"/>
          <Column id="MESSAGE_TEXT_EN" type="STRING" size="300"/>
          <Column id="MESSAGE_TEXT_ZH" type="STRING" size="300"/>
          <Column id="MESSAGE_TEXT_JA" type="STRING" size="300"/>
          <Column id="MESSAGE_TEXT_OT" type="STRING" size="300"/>
          <Column id="REMARK" type="STRING" size="4000"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="dsMsgTypeGrid">
        <ColumnInfo>
          <Column id="code" type="STRING" size="30"/>
          <Column id="name" type="STRING" size="100"/>
        </ColumnInfo>
        <Rows>
          <Row>
            <Col id="code">A</Col>
            <Col id="name">경고</Col>
          </Row>
          <Row>
            <Col id="code">C</Col>
            <Col id="name">확인</Col>
          </Row>
          <Row>
            <Col id="code">I</Col>
            <Col id="name">정보</Col>
          </Row>
        </Rows>
      </Dataset>
      <Dataset id="dsMsgGubunGrid">
        <ColumnInfo>
          <Column id="code" type="STRING" size="30"/>
          <Column id="name" type="STRING" size="100"/>
        </ColumnInfo>
        <Rows>
          <Row>
            <Col id="code">FM</Col>
            <Col id="name">화면</Col>
          </Row>
          <Row>
            <Col id="code">NM</Col>
            <Col id="name">시스템</Col>
          </Row>
        </Rows>
      </Dataset>
      <Dataset id="dsSearch">
        <ColumnInfo>
          <Column id="messageGubun" type="STRING" size="30"/>
          <Column id="messageType" type="STRING" size="30"/>
          <Column id="messageText" type="STRING" size="300"/>
        </ColumnInfo>
        <Rows>
          <Row/>
        </Rows>
      </Dataset>
    </Objects>
    <Layouts>
      <Layout height="720" mobileorientation="landscape" width="1280">
        <!-- 전체 배경 -->
        <Static id="staBackground" left="0" top="0" width="1280" height="720" background="#F5F7FA"/>
        <!-- 화면 제목 -->
        <Static id="staTitle" text="메시지등록" left="25" top="20" width="250" height="36" font="bold 18pt Arial" color="#243B64"/>
        <Static id="staSubTitle" text="메시지를 등록하고 관리합니다." left="27" top="55" width="400" height="20" font="normal 9pt Arial" color="#7A8494"/>
        <!-- 저장 버튼 -->
        <Button id="btnSave" text="저장" left="1160" top="25" width="95" height="34" font="bold 10pt Arial" background="#315B96" color="#FFFFFF" border="1px solid #315B96" onclick="btnSave_onclick"/>
        <!-- 조회조건 영역 -->
        <Static id="staSearchPanel" left="25" top="90" width="1230" height="125" background="#FFFFFF" border="1px solid #DCE2EB" text=""/>
        <Static id="staSearchTitle" text="조회조건" left="45" top="105" width="150" height="25" font="bold 12pt Arial" color="#243B64"/>
        <Static id="staSearchLine" left="45" top="137" width="1190" height="1" background="#E6EAF0"/>
        <!-- 메시지구분 -->
        <Static id="staMsgGubun" text="메시지구분" left="45" top="160" width="100" height="28" textAlign="right" verticalAlign="middle" font="bold 10pt Arial" color="#46546A"/>
        <Combo id="cboMsgGubun" left="155" top="156" width="160" height="34" innerdataset="dsMsgGubun" codecolumn="code" datacolumn="name" index="0" text="전체"/>
        <!-- 메시지유형 -->
        <Static id="staMsgType" text="메시지유형" left="340" top="160" width="100" height="28" textAlign="right" verticalAlign="middle" font="bold 10pt Arial" color="#46546A"/>
        <Combo id="cboMsgType" left="450" top="156" width="160" height="34" innerdataset="dsMsgType" codecolumn="code" datacolumn="name" index="0"/>
        <!-- 메시지 검색 -->
        <Static id="staMsgSearch" text="메시지" left="635" top="160" width="80" height="28" textAlign="right" verticalAlign="middle" font="bold 10pt Arial" color="#46546A"/>
        <Edit id="edtMsgSearch" left="725" top="156" width="280" height="34" maxlength="100"/>
        <!-- 조회 / 초기화 -->
        <Button id="btnSearch" text="조회" left="1030" top="156" width="85" height="34" font="bold 10pt Arial" background="#315B96" color="#FFFFFF" border="1px solid #315B96" onclick="btnSearch_onclick"/>
        <Button id="btnReset" text="초기화" left="1125" top="156" width="85" height="34" font="normal 10pt Arial" background="#FFFFFF" color="#46546A" border="1px solid #C9D1DD"/>
        <!-- 메시지 목록 영역 -->
        <Static id="staResultPanel" left="25" top="230" width="1230" height="460" background="#FFFFFF" border="1px solid #DCE2EB" onclick="staResultPanel_onclick"/>
        <Static id="staGridTitle" text="메시지 목록" left="45" top="248" width="200" height="28" font="bold 12pt Arial" color="#243B64"/>
        <Static id="staGridSubTitle" text="등록된 메시지를 확인하고 수정 및 추가할 수 있습니다." left="45" top="278" width="400" height="18" font="normal 9pt Arial" color="#8993A2"/>
        <!-- 행추가 / 행삭제 -->
        <Button id="btnAddRow" text="행추가" left="1030" top="250" width="85" height="32" font="normal 9pt Arial" background="#FFFFFF" color="#315B96" border="1px solid #AABBD2" onclick="btnAddRow_onclick"/>
        <Button id="btnDeleteRow" text="행삭제" left="1120" top="250" width="85" height="32" font="normal 9pt Arial" background="#FFFFFF" color="#C35B5B" border="1px solid #DAB8B8" onclick="btnDeleteRow_onclick"/>
        <Static id="staResultLine" left="45" top="300" width="1190" height="1" background="#E6EAF0"/>
        <!-- 메시지 Grid -->
        <Grid id="grdMessage" left="45" top="315" width="1190" height="355" binddataset="dsMessage" autofittype="col">
          <Formats>
            <Format id="default">
              <Columns>
                <Column size="110"/>
                <Column size="100"/>
                <Column size="210"/>
                <Column size="210"/>
                <Column size="180"/>
                <Column size="180"/>
                <Column size="200"/>
              </Columns>
              <Rows>
                <Row size="38" band="head"/>
                <Row size="38"/>
              </Rows>
              <Band id="head">
                <Cell text="메시지구분"/>
                <Cell col="1" text="메시지유형"/>
                <Cell col="2" text="메시지(한국어)"/>
                <Cell col="3" text="메시지(영어)"/>
                <Cell col="4" text="메시지(중국어)"/>
                <Cell col="5" text="메시지(일본어)"/>
                <Cell col="6" text="메시지(기타)"/>
              </Band>
              <Band id="body">
                <Cell displaytype="combocontrol" edittype="combo" combodataset="dsMsgGubunGrid" combocodecol="code" combodatacol="name" text="bind:MESSAGE_GUBUN"/>
                <Cell col="1" displaytype="combocontrol" edittype="combo" combodataset="dsMsgTypeGrid" combocodecol="code" text="bind:MESSAGE_TYPE_CD" combodatacol="name"/>
                <Cell col="2" displaytype="normal" edittype="text" text="bind:MESSAGE_TEXT_KO"/>
                <Cell col="3" displaytype="normal" edittype="text" text="bind:MESSAGE_TEXT_EN"/>
                <Cell col="4" displaytype="normal" edittype="text" text="bind:MESSAGE_TEXT_ZH"/>
                <Cell col="5" displaytype="normal" edittype="text" text="bind:MESSAGE_TEXT_JA"/>
                <Cell col="6" displaytype="normal" edittype="text" text="bind:MESSAGE_TEXT_OT"/>
              </Band>
            </Format>
          </Formats>
        </Grid>
      </Layout>
    </Layouts>
    <Script type="xscript5.1"><![CDATA[
/***************************************************************************************
 * 프로젝트        : Built1 Enterprise System 구축 프로젝트
 * 업무구분        : 공통관리
 * 파일명          : COM12000M.xfdl
 * 화면            : 메시지등록
 * 설명            : 메시지 목록 조회 및 관리
 *---------------------------------------------------------------------------------------
 * 변경일            변경자            변경내역
 *---------------------------------------------------------------------------------------
 * 2026-11-03        Built1            최초작성
 ***************************************************************************************/


/***************************************************************************************
 * 1. FORM 변수 선언
 ***************************************************************************************/


/***************************************************************************************
 * 2. FORM LOAD
 ***************************************************************************************/

/*
 * 기능 : 화면 초기화
 */
this.fn_init = function(obj, e)
{
    this.fn_search();
};


/***************************************************************************************
 * 3. 공통 버튼
 ***************************************************************************************/

/*
 * 기능 : 메시지 목록 조회
 */
this.fn_search = function()
{
    // 조회조건 가져오기
    var sGubun = this.cboMsgGubun.value;
    var sType  = this.cboMsgType.value;
    var sText  = this.edtMsgSearch.value;

    // 검색조건 Dataset 초기화
    this.dsSearch.clearData();

    // 검색조건 행 추가
    var nRow = this.dsSearch.addRow();

    // 검색조건 설정
    this.dsSearch.setColumn(nRow, "messageGubun", sGubun);
    this.dsSearch.setColumn(nRow, "messageType", sType);
    this.dsSearch.setColumn(nRow, "messageText", sText);

    // 조회 Transaction 설정
    var sSvcId = "selectMessageList";
    var sSvcURL = "svcUrl::com12000m/selectMessageList.do";
    var sInData = "dsSearch=dsSearch:A";
    var sOutData = "dsMessage=dsMessage";
    var sArgument = "";
    var sCallback = "fn_callBack";

    // 조회 요청
    this.gfn_transaction(sSvcId, sSvcURL, sInData, sOutData, sArgument, sCallback);
};


/***************************************************************************************
 * 4. TRANSACTION, CALLBACK
 ***************************************************************************************/

/*
 * 기능 : Transaction 결과 처리
 */
this.fn_callBack = function(sSvcId, nErrorCode, sErrorMsg)
{
    if (nErrorCode != 0)
    {
        if (sSvcId == "selectMessageList")
        {
            this.alert("조회 요청 오류: " + sErrorMsg);
        }
        else if (sSvcId == "saveMessage")
        {
            this.alert("저장 요청 오류: " + sErrorMsg);
        }
        return;
    }

    // 저장 성공 처리는 실제 DB 저장 기능 연결 후 추가 예정
};


/***************************************************************************************
 * 5. 팝업 호출 및 콜백
 ***************************************************************************************/


/***************************************************************************************
 * 6. 기타 함수
 ***************************************************************************************/


/***************************************************************************************
 * 7. 이벤트
 ***************************************************************************************/

/*
 * 기능 : 화면 로딩 이벤트
 */
this.COM12000M_onload = function(obj, e)
{
    this.fn_init(obj, e);
};

/*
 * 기능 : 조회 버튼 클릭 이벤트
 */
this.btnSearch_onclick = function(obj, e)
{
    this.fn_search();
};


this.btnAddRow_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	// 메시지 목록에 새로운 행 추가
    var nRow = this.dsMessage.addRow();

    // 새 행의 기본값 설정
    this.dsMessage.setColumn(nRow, "MESSAGE_GUBUN", "FM");
    this.dsMessage.setColumn(nRow, "MESSAGE_TYPE_CD", "A");
};

this.btnDeleteRow_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
	 // 현재 선택된 행 번호 가져오기
    var nRow = this.dsMessage.rowposition;

    // 선택된 행이 없으면 종료
    if (nRow < 0)
    {
        this.alert("삭제할 행을 선택해주세요.");
        return;
    }

    // 선택된 행 삭제
    this.dsMessage.deleteRow(nRow);
};

this.btnSave_onclick = function(obj:nexacro.Button,e:nexacro.ClickEventInfo)
{
		
	// 변경된 데이터가 있는지 확인
    var bChanged = false;

    // 신규 또는 수정된 행 확인
    for (var i = 0; i < this.dsMessage.rowcount; i++)
    {
        var nRowType = this.dsMessage.getRowType(i);

        if (nRowType == 2 || nRowType == 4)
        {
            bChanged = true;
            break;
        }
    }

    // 삭제된 기존 행 확인
    if (this.dsMessage.getDeletedRowCount() > 0)
    {
        bChanged = true;
    }

    // 변경된 데이터가 없으면 안내
    if (!bChanged)
    {
        this.alert("변경된 데이터가 없습니다.");
        return;
    }
    
	// 필수 입력값 검사
	for (var i = 0; i < this.dsMessage.rowcount; i++)
	{
		var nRowType = this.dsMessage.getRowType(i);

		// 신규 또는 수정된 행만 검사
		if (nRowType == 2 || nRowType == 4)
		{
			var arrRequired = [
				"MESSAGE_TEXT_KO",
				"MESSAGE_TEXT_EN",
				"MESSAGE_TEXT_ZH",
				"MESSAGE_TEXT_JA",
				"MESSAGE_TEXT_OT"
			];

			for (var j = 0; j < arrRequired.length; j++)
			{
				var sValue = this.dsMessage.getColumn(i, arrRequired[j]);

				if (sValue == null || String(sValue).trim() == "")
				{
					this.alert("필수 메시지 항목을 입력해주세요.");
					this.dsMessage.set_rowposition(i);
					return;
				}
			}
		}
	}		
    // 저장 Transaction 설정
	var sSvcId = "saveMessage";
	var sSvcURL = "svcUrl::com12000m/saveMessage.do";
	var sInData = "dsMessage=dsMessage:U";
	var sOutData = "";
	var sArgument = "";
	var sCallback = "fn_callBack";

	// 저장 요청
	this.gfn_transaction(sSvcId, sSvcURL, sInData, sOutData, sArgument, sCallback);
};
]]></Script>
  </Form>
</FDL>
