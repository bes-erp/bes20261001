create or replace package bcom.com_user_pkg
is
   /*
    * =========================================================================
    * Package Name     : com_user_pkg
    * Description      : 사용자 비밀번호 저장,변경 및 로그인 체크
    * Author           : Built1
    * Created Date     : 2026-10-01
    * -------------------------------------------------------------------------
    * 권한 부여
    * -------------------------------------------------------------------------
    * sqlplus sys@//210.112.232.44:1531/bes as sysdba
    * grant execute on sys.dbms_crypto to bsys;
    * grant execute on sys.dbms_crypto to bcom;
    * -------------------------------------------------------------------------
    * Update History
    * -------------------------------------------------------------------------
    * 작성일자         작성자      내용
    * -------------------------------------------------------------------------
    * 2026-10-01       Built1      최초작성
    * =========================================================================
    */

    -- Public variable declarations
    g_package_name                     varchar2(50) default 'com_user_pkg';

    -- ------------------------------------------------------------------------
    -- System public function and procedure declarations
    -- ------------------------------------------------------------------------

    -- ------------------------------------------------------------------------
    -- 사용자 비밀번호 등록 및 변경
    -- ------------------------------------------------------------------------
    procedure change_password_p
        (p_user_id                     in  varchar2                            -- 사용자ID
        ,p_password                    in  varchar2                            -- 비밀번호
        ,p_update_by                   in  varchar2                            -- 수정자
        ,p_result_cd                   out varchar2                            -- 결과코드 : S(성공), F(실패)
        ,p_result_descr                out varchar2                            -- 결과메시지
        );

    -- ------------------------------------------------------------------------
    -- 사용자 로그인 비밀번호 검증
    -- ------------------------------------------------------------------------
    procedure login_password_p
        (p_user_id                     in  varchar2                            -- 사용자ID
        ,p_password                    in  varchar2                            -- 비밀번호
        ,p_result_cd                   out varchar2                            -- 결과코드 : S(성공), F(실패)
        ,p_result_descr                out varchar2                            -- 결과메시지
        );

end com_user_pkg;
/
create or replace package body bcom.com_user_pkg
is

    -- ------------------------------------------------------------------------
    -- 정적변수 선언
    -- ------------------------------------------------------------------------
    c_algorithm                        constant varchar2(20) := 'PBKDF2-SHA256';
    c_iterations                       constant pls_integer  := 210000;
    c_salt_length                      constant pls_integer  := 16;
    c_hash_length                      constant pls_integer  := 32;
    c_max_fail_count                   constant pls_integer  := 5;

    
    -- ------------------------------------------------------------------------
    -- PBKDF2-HMAC-SHA-256 해시 생성
    -- ------------------------------------------------------------------------
    function hash_f
        (p_password                    in  varchar2
        ,p_salt                        in  raw
        ) return raw
    is
        l_password_raw                 raw(32767);
        l_u                            raw(32);
        l_t                            raw(32);
    begin
        
        l_password_raw := utl_i18n.string_to_raw(p_password, 'AL32UTF8');

        -- PBKDF2의 첫 번째 블록 U1
        l_u := dbms_crypto.mac
                   (utl_raw.concat(p_salt, hextoraw('00000001'))
                   ,dbms_crypto.hmac_sh256
                   ,l_password_raw
                   );

        l_t := l_u;

        -- U2부터 반복 계산 후 XOR 결합
        for i in 2 .. c_iterations
        loop
            l_u := dbms_crypto.mac
                       (l_u
                       ,dbms_crypto.hmac_sh256
                       ,l_password_raw
                       );

            l_t := utl_raw.bit_xor(l_t, l_u);
        end loop;

        return l_t;
        
    end hash_f;

    -- ------------------------------------------------------------------------
    -- 비밀번호 저장 문자열 생성
    -- ------------------------------------------------------------------------
    function encode_f
        (p_password                    in  varchar2
        ) return varchar2
    is
        l_salt                         raw(16);
        l_hash                         raw(32);
    begin
        l_salt := dbms_crypto.randombytes(c_salt_length);
        l_hash := hash_f(p_password, l_salt);

        return c_algorithm
               || '$' || to_char(c_iterations)
               || '$' || rawtohex(l_salt)
               || '$' || rawtohex(l_hash);
    end encode_f;

    -- ------------------------------------------------------------------------
    -- 저장된 비밀번호 검증
    -- ------------------------------------------------------------------------
    function verify_f
        (p_password                    in  varchar2
        ,p_stored_password             in  varchar2
    ) return boolean
    is
        l_pos1       pls_integer;
        l_pos2       pls_integer;
        l_pos3       pls_integer;
        l_algorithm  varchar2(30);
        l_iterations pls_integer;
        l_salt_hex   varchar2(100);
        l_hash_hex   varchar2(100);
        l_salt       raw(16);
        l_hash       raw(32);
        l_calc_hash  raw(32);
    begin
        
        l_pos1 := instr(p_stored_password, '$', 1, 1);
        l_pos2 := instr(p_stored_password, '$', 1, 2);
        l_pos3 := instr(p_stored_password, '$', 1, 3);

        if l_pos1 = 0 or l_pos2 = 0 or l_pos3 = 0 then
            return false;
        end if;

        l_algorithm  := substr(p_stored_password, 1, l_pos1 - 1);
        l_iterations := to_number(substr(p_stored_password, l_pos1 + 1, l_pos2 - l_pos1 - 1));
        l_salt_hex   := substr(p_stored_password, l_pos2 + 1, l_pos3 - l_pos2 - 1);
        l_hash_hex   := substr(p_stored_password, l_pos3 + 1);

        -- 지원하지 않는 형식이나 비정상적인 반복 횟수 거부
        if l_algorithm != c_algorithm
           or l_iterations != c_iterations
           or length(l_salt_hex) != c_salt_length * 2
           or length(l_hash_hex) != c_hash_length * 2
        then
            return false;
        end if;

        l_salt      := hextoraw(l_salt_hex);
        l_hash      := hextoraw(l_hash_hex);
        l_calc_hash := hash_f(p_password, l_salt);

        return l_calc_hash = l_hash;

    exception
        when others then
            return false;
            
    end verify_f;

    -- ------------------------------------------------------------------------
    -- 사용자 비밀번호 등록 및 변경
    -- ------------------------------------------------------------------------
    procedure change_password_p
        (p_user_id                     in  varchar2                            -- 사용자ID
        ,p_password                    in  varchar2                            -- 비밀번호
        ,p_update_by                   in  varchar2                            -- 수정자
        ,p_result_cd                   out varchar2                            -- 결과코드 : S(성공), F(실패)
        ,p_result_descr                out varchar2                            -- 결과메시지
        )
    is
        l_password                     varchar2(512);
    begin
        
        p_result_cd    := 'F';
        p_result_descr := null;

        if p_user_id is null then
            p_result_descr := '사용자ID는 필수 항목입니다.';
            return;
        end if;

        if p_password is null or length(p_password) < 8 then
            p_result_descr := '비밀번호는 8자 이상 입력합니다.';
            return;
        end if;

        l_password := encode_f(p_password);

        update com_user
           set password             = l_password
             , last_pw_change_date  = sysdate
             , update_date          = sysdate
             , update_by            = nvl(p_update_by, 'admin')
         where 1=1
           and user_id              = p_user_id;

        if sql%rowcount = 0 then
            p_result_descr := '등록된 사용자를 찾을 수 없습니다.';
            return;
        end if;

        p_result_cd    := 'S';
        p_result_descr := '비밀번호가 변경되었습니다.';

    exception
        when others then
            p_result_cd    := 'F';
            p_result_descr := '비밀번호 변경 중 오류가 발생했습니다.';
            
    end change_password_p;

    -- ------------------------------------------------------------------------
    -- 사용자 로그인 비밀번호 검증
    -- ------------------------------------------------------------------------
    procedure login_password_p
        (p_user_id                     in  varchar2                            -- 사용자ID
        ,p_password                    in  varchar2                            -- 비밀번호
        ,p_result_cd                   out varchar2                            -- 결과코드 : S(성공), F(실패)
        ,p_result_descr                out varchar2                            -- 결과메시지
        )
    is
        l_password                     com_user.password%type;
        l_user_yn                      com_user.user_yn%type;
        l_lock_yn                      com_user.lock_yn%type;
        l_login_fail_cnt               com_user.login_fail_count%type;
    begin
        
        p_result_cd    := 'F';
        p_result_descr := '사용자 ID 또는 비밀번호가 올바르지 않습니다.';

        if p_user_id is null or p_password is null then
            return;
        end if;

        begin
            select password
                 , user_yn
                 , lock_yn
                 , nvl(login_fail_count, 0)
              into l_password
                 , l_user_yn
                 , l_lock_yn
                 , l_login_fail_cnt
              from com_user
             where user_id = p_user_id;
        exception
            when no_data_found then
                return;
        end;

        if nvl(l_user_yn, 'N') != 'Y' then
            p_result_descr := '종료된 사용자 계정입니다.';
            return;
        end if;

        if nvl(l_lock_yn, 'N') = 'Y' then
            p_result_descr := '사용자 계정이 잠겼습니다. 관리자에게 문의해 주세요.';
            return;
        end if;

        if verify_f(p_password, l_password) then
            update com_user
               set login_fail_count = 0
                 , last_login_date  = sysdate
                 , update_date      = sysdate
             where 1=1
               and user_id          = p_user_id;

            p_result_cd    := 'S';
            p_result_descr := '로그인에 성공했습니다.';
        else
            update com_user
               set login_fail_count = nvl(login_fail_count, 0) + 1
                 , lock_yn          = case when nvl(login_fail_count, 0) + 1 >= c_max_fail_count
                                           then 'Y'
                                           else nvl(lock_yn, 'N')
                                       end
                 , update_date      = sysdate
             where 1=1
               and user_id          = p_user_id;

            if l_login_fail_cnt + 1 >= c_max_fail_count then
                p_result_descr := '로그인 실패 횟수 초과로 계정이 잠겼습니다.';
            else
                p_result_descr := '사용자ID 또는 비밀번호가 올바르지 않습니다.';
            end if;
        end if;

    exception
        when others then
            p_result_cd    := 'F';
            p_result_descr := '로그인 검증 중 오류가 발생했습니다.';
            
    end login_password_p;

end com_user_pkg;
/
