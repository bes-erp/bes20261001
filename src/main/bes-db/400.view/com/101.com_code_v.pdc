-- ----------------------------------------------------------------------------
conn system/manager@bes;
-- ----------------------------------------------------------------------------

-- 뷰 삭제
drop view bcom.com_code_v;

-- 뷰 생성
create or replace view bcom.com_code_v
as
select
     /* =======================================================================
      * Package Name     : com_code_v
      * Description      : [공통관리] 코드 뷰
      * Author           : Built1
      * Created Date     : 2026-11-01
      * Update History
      * -----------------------------------------------------------------------
      * 작성일자           작성자        내용
      * -----------------------------------------------------------------------
      * 2026-11-01         Built1        최초작성
      * =======================================================================
      */
       cc.code_type                                                            as code_type
      ,cct.code_type_nm                                                        as code_type_nm
      ,cc.code                                                                 as code      
      ,cc.code_nm                                                              as code_nm   
      ,cc.code_nm_s                                                            as code_nm_s 
      ,cc.start_date                                                           as start_date
      ,cc.end_date                                                             as end_date  
      ,cc.sort_order                                                           as sort_order
      ,cc.attr_chr1                                                            as attr_chr1 
      ,cc.attr_chr2                                                            as attr_chr2 
      ,cc.attr_chr3                                                            as attr_chr3 
      ,cc.attr_chr4                                                            as attr_chr4 
      ,cc.attr_chr5                                                            as attr_chr5 
      ,cc.attr_num1                                                            as attr_num1 
      ,cc.attr_num2                                                            as attr_num2 
      ,cc.attr_num3                                                            as attr_num3 
      ,cc.attr_num4                                                            as attr_num4 
      ,cc.attr_num5                                                            as attr_num5 
      ,cc.attr_date1                                                           as attr_date1
      ,cc.attr_date2                                                           as attr_date2
      ,cc.attr_date3                                                           as attr_date3
      ,cc.attr_date4                                                           as attr_date4
      ,cc.attr_date5                                                           as attr_date5
      ,cct.remark                                                              as remark
      ,cct.create_date                                                         as create_date
      ,cct.create_by                                                           as create_by
      ,cct.update_date                                                         as update_date
      ,cct.update_by                                                           as update_by
  from com_code cc
       left join com_code_type cct on cc.code_type = cct.code_type
 where 1=1
;

-- 권한부여
grant all on bcom.com_code_v to bsys;
grant all on bcom.com_code_v to bhrm;

-- 시노님 생성
create or replace synonym bsys.com_code_v for bcom.com_code_v;
create or replace synonym bhrm.com_code_v for bcom.com_code_v;


-- ----------------------------------------------------------------------------
conn bsys/bsys@bes;
-- ----------------------------------------------------------------------------
-- 데이터 조회
select cctv.*
  from com_code_v cctv
 where 1=1
;
