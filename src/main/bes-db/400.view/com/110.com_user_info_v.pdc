-- ----------------------------------------------------------------------------
conn system/manager@bes;
-- ----------------------------------------------------------------------------

-- 뷰 삭제
drop view bcom.com_user_info_v;

-- 뷰 생성
create or replace view bcom.com_user_info_v
as
select
     /* =======================================================================
      * Package Name     : com_user_info_v
      * Description      : [공통관리] 사용자 정보 뷰
      * Author           : Built1
      * Created Date     : 2026-11-01
      * Update History
      * -----------------------------------------------------------------------
      * 작성일자           작성자        내용
      * -----------------------------------------------------------------------
      * 2026-11-01         Built1        최초작성
      * =======================================================================
      */
/*    
       cuiv.user_id                              as user_id          
      ,cuiv.user_nm                              as user_nm          
      ,cuiv.emp_id                               as emp_id           
      ,cuiv.emp_num                              as emp_num          
      ,cuiv.company_cd                           as company_cd       
      ,cuiv.company_nm                           as company_nm       
      ,cuiv.dept_cd                              as dept_cd          
      ,cuiv.dept_nm                              as dept_nm          
      ,cuiv.grade_cd                             as grade_cd         
      ,cuiv.grade_nm                             as grade_nm         
      ,cuiv.job_cd                               as job_cd           
      ,cuiv.job_nm                               as job_nm           
      ,cuiv.position_cd                          as position_cd      
      ,cuiv.position_nm                          as position_nm      
      ,cuiv.hire_date                            as hire_date              
      ,cuiv.retire_date                          as retire_date      
      ,cuiv.supervisor_emp_nm                    as supervisor_emp_nm
      ,cuiv.supervisor_emp_id                    as supervisor_emp_id
      ,cuiv.supervisor_emp_nm                    as supervisor_emp_nm 
 */     
       'TEST01'                                  as user_id          
      ,'테스트사용자'                            as user_nm          
      ,20260001                                  as emp_id           
      ,'20260001'                                as emp_num            
      ,'다은수진'                                as emp_nm
      ,'BT1'                                     as company_cd       
      ,'빌트원'                                  as company_nm       
      ,'20123'                                   as dept_cd          
      ,'ERP2팀'                                  as dept_nm          
      ,'G200'                                    as grade_cd         
      ,'대리'                                    as grade_nm         
      ,'J200'                                    as job_cd           
      ,'시스템개발'                              as job_nm           
      ,null                                      as position_cd      
      ,null                                      as position_nm      
      ,'2020-01-01'                              as hire_date              
      ,null                                      as retire_date
      ,20001000                                  as supervisor_emp_id
      ,'20001000'                                as supervisor_emp_num
      ,'상위관리자'                              as supervisor_emp_nm 
  from dual cuiv
 where 1=1
;

-- 권한부여
grant all on bcom.com_user_info_v to bsys;
--grant all on bcom.com_user_info_v to bhrm;

-- 시노님 생성
create or replace synonym bsys.com_user_info_v for bcom.com_user_info_v;
--create or replace synonym bhrm.com_user_info_v for bcom.com_user_info_v;


-- ----------------------------------------------------------------------------
conn bsys/bsys@bes;
-- ----------------------------------------------------------------------------
-- 데이터 조회
select cuiv.*
  from com_user_info_v cuiv
 where 1=1
;
