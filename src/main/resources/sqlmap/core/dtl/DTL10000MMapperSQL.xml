<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="erp.core.dtl.service.impl.DTL10000MMapper">

	<!-- ******************************************************************************
	     * [날짜] 데이터베이스 날짜와 관련된 정보를 조회
	     * 특수문자 : <![CDATA[  ]]>
	******************************************************************************* -->
	<select id="selectDateList" resultType="map">
	    select /* DTL10000MMapper.selectDateList */
	           to_char(sysdate, 'YYYY-MM-DD HH24:MI:SS')   as current_date
		  from dual
	</select>


</mapper>