<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:context="http://www.springframework.org/schema/context"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
                http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
                  http://www.springframework.org/schema/context
                  http://www.springframework.org/schema/context/spring-context.xsd">

	<!-- 2026.10.01 :: 데이터베이스 프로퍼티로 설정 변경을 위하여 네임스페이스 추가 -->
	
	<!-- 2026.10.01 :: 전자정부 제공 빈생성 제외
	<bean name="propertiesService" class="org.egovframe.rte.fdl.property.impl.EgovPropertyServiceImpl" destroy-method="destroy">
		<property name="properties">
			<map>
			    <entry key="pageUnit" value="10"/>
			    <entry key="pageSize" value="10"/>
			</map>
		</property>
	</bean>
	-->
	
	<!-- 2026.10.01 :: 데이터베이스 프로퍼티로 설정으로 변경 -->
  	<context:property-placeholder location="classpath:/config/database/database.properties"/>	


	<!-- 2026.10.01 :: 하기 정보 모두 비활성화 처리 	
	<bean id="txManager" class="org.springframework.jdbc.datasource.DataSourceTransactionManager">
		<property name="dataSource" ref="dataSource"/>
	</bean>

	<tx:advice id="txAdvice" transaction-manager="txManager">
		<tx:attributes>
			<tx:method name="*" rollback-for="Exception"/>
		</tx:attributes>
	</tx:advice>

	<aop:config>
		<aop:pointcut id="requiredTx" expression="execution(* erp.com..impl.*Impl.*(..))"/>
		<aop:advisor advice-ref="txAdvice" pointcut-ref="requiredTx" />
	</aop:config> 
	-->	
	

</beans>
