
# ========================================
# Java 기본
# ========================================
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*


# ========================================
# Maven
# ========================================
# Maven build output
target/

# Maven temporary files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties


# ========================================
# Eclipse / STS
# ========================================
# Eclipse workspace (개인 설정 제외)
.metadata/

# Eclipse recommender
.recommenders/

# STS
.springBeans

# Eclipse APT
.factorypath

# Eclipse project settings
# .project
# .classpath
# .settings/ 는 Git 관리 대상


# ========================================
# PLSQL backup files
# ========================================
*.~sql
*.~pdc


# ========================================
# Nexacro
# ========================================
# Nexacro generated information
src/main/bes-ui/$Geninfo$.geninfo

# Nexacro temporary and backup files
$*.xfdl$
*.xfdl~
*.xfdl.bak
*.bak


# ========================================
# Nexacro WEB-INF
# ========================================
# WEB-INF 하위 모든 폴더 및 파일 Git 포함
!src/main/webapp/WEB-INF/
!src/main/webapp/WEB-INF/**

# import 폴더는 유지하고 내부 파일 제외
src/main/webapp/WEB-INF/import/*

# export 폴더는 유지하고 내부 파일 제외
src/main/webapp/WEB-INF/export/*

# import/export 폴더 유지용 파일
!src/main/webapp/WEB-INF/import/.gitkeep
!src/main/webapp/WEB-INF/export/.gitkeep


# ========================================
# OS generated files
# ========================================
.DS_Store
Thumbs.db
desktop.ini


# ========================================
# Temporary files
# ========================================
*.tmp
*.temp
*.swp
*.swo
*~
