# ========================================
# Java 기본
# ========================================
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files
# (WEB-INF/lib 의 jar 는 아래 WEB-INF 섹션에서 다시 포함됨)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*


# ========================================
# Maven
# ========================================
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties


# ========================================
# Eclipse / STS
# ========================================
# Eclipse workspace (개인 설정 제외)
.metadata/
.recommenders/

# STS
.springBeans

# Eclipse APT
.factorypath

# Eclipse project settings
# .project / .classpath / .settings/ 는 Git 관리 대상
# 단, WTP 배포 설정은 개발자별 환경(deploy-name, 경로)이 달라 제외
.settings/org.eclipse.wst.common.component


# ========================================
# PLSQL backup files
# ========================================
*.~sql
*.~pdc


# ========================================
# Nexacro 소스 (src/main/bes-ui)
# ========================================
# Generate 정보
src/main/bes-ui/$Geninfo$.geninfo
**/$Geninfo$.geninfo

# 임시 / 백업 파일
$*.xfdl$
*.xfdl~
*.xfdl.bak
*.bak


# ========================================
# Nexacro Generate 결과물 (src/main/webapp/bes-ui)
# ========================================
# Nexacro Studio 의 Generate 로 자동 생성되는 폴더
# (*.xadl.js, *.xfdl.js, index.html, launch.html, quickview.html,
#  popup.html, start.json, theme.map.js, nexacrolib 복사본 등)
# -> 원본은 src/main/bes-ui 에서만 관리
src/main/webapp/bes-ui/


# ========================================
# WEB-INF
# ========================================
# WEB-INF 하위 모든 폴더 및 파일 Git 포함 (lib/*.jar 포함)
!src/main/webapp/WEB-INF/
!src/main/webapp/WEB-INF/**

# import / export 폴더는 유지하고 내부 파일 제외
src/main/webapp/WEB-INF/import/*
src/main/webapp/WEB-INF/export/*

# import / export 폴더 유지용 파일
!src/main/webapp/WEB-INF/import/.gitkeep
!src/main/webapp/WEB-INF/export/.gitkeep


# ========================================
# OS generated files
# ========================================
.DS_Store
Thumbs.db
desktop.ini


# ========================================
# Temporary files
# ========================================
*.tmp
*.temp
*.swp
*.swo
*~